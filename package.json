{
  "name": "savezonix",
  "version": "2.0.0",
  "description": "SaveZonix — Universal High-Performance Media Downloader Suite (MERN Stack)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --workspace=server",
    "server": "npm run start --workspace=server",
    "server:dev": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "client:build": "npm run build --prefix client",
    "build:extension": "node scripts/build-protected-extension.js",
    "build": "npm run build --prefix client",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
