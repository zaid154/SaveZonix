# ─────────────────────────────────────────────────────────────
# SaveZonix Enterprise Cloud Configuration Example
# ─────────────────────────────────────────────────────────────

# Server Port & Core Settings
PORT=5001
NODE_ENV=production
JWT_SECRET=your_secure_random_jwt_secret_here_min_32_characters
STREAM_SECRET=your_stream_signing_hmac_secret_here

# Superadmin Initial Credentials
ADMIN_EMAIL=zaidm1323@gmail.com
ADMIN_PASSWORD=YourStrongAdminPassword2026!
ADMIN_KEY=your_admin_master_key_here

# Database Configuration
# Option A: PostgreSQL via Prisma (Neon / Supabase / Vercel Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/savezonix?sslmode=require"

# Option B: MongoDB Atlas (Render Existing Database)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/SaveZonixDb?retryWrites=true&w=majority

# Payment Gateway: Razorpay (India: UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Payment Gateway: Stripe (International Cards)
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx

# Distributed Rate Limiting: Upstash Redis (Vercel Serverless / Render)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Bot Protection: Cloudflare Turnstile
TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxx

# Email Notifications (SMTP / Nodemailer / Resend)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here

# Web Client URLs
CLIENT_URL=https://savezonix-pro.vercel.app
VITE_API_URL=https://savezonix-pro.vercel.app
