@model StreamHelper.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Account Settings — SaveZonix";
}

<div class="account-page">
    <div class="container">
        <div class="account-header">
            <div>
                <h1 class="page-title">Account Settings</h1>
                <p class="page-subtitle">Update your password, security preferences, and account configuration</p>
            </div>
            <div class="account-actions">
                <a asp-action="Profile" class="btn btn-secondary">
                    <span>👤 Back to Profile</span>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success" style="margin-bottom: 24px;">
                <span class="alert-icon">✅</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert error" style="margin-bottom: 24px;">
                <span class="alert-icon">⚠️</span>
                <span>@ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage</span>
            </div>
        }

        <div class="glass-card" style="max-width: 640px; margin-bottom: 32px;">
            <h2 class="card-title" style="margin-bottom: 20px;">Change Password</h2>
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label asp-for="CurrentPassword">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="At least 6 characters" required />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmNewPassword">Confirm New Password</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Repeat new password" required />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <span>Update Password</span>
                </button>
            </form>
        </div>

        <div class="glass-card" style="max-width: 640px; border-color: rgba(244, 63, 94, 0.3);">
            <h2 class="card-title" style="color: var(--rose); margin-bottom: 12px;">Data &amp; Privacy</h2>
            <p style="color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 16px;">
                You have full control over your personal download history. You can purge individual download records or clear your entire download history at any time from your <a asp-action="Downloads" class="auth-link">Downloads page</a>.
            </p>
        </div>
    </div>
</div>
