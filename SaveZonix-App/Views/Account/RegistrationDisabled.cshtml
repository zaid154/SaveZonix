@{
    ViewData["Title"] = "Registration Disabled — SaveZonix";
}

<div class="auth-wrapper">
    <div class="auth-card" style="text-align: center;">
        <div style="display: flex; justify-content: center; margin-bottom: 20px;">
            <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(248, 113, 113, 0.1); border: 1px solid rgba(248, 113, 113, 0.25); display: flex; align-items: center; justify-content: center; color: #f87171;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
        </div>
        <h1 class="auth-title">Registration Closed</h1>
        <p class="auth-subtitle">@ViewBag.ErrorMessage</p>
        <div style="margin-top: 28px;">
            <a asp-action="Login" class="btn btn-secondary">Sign In with Existing Account</a>
        </div>
    </div>
</div>
