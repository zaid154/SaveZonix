@{
    ViewData["Title"] = "Verification Email Sent — SaveZonix";
}

<div class="auth-wrapper">
    <div class="auth-card" style="text-align: center;">
        <div style="font-size: 48px; margin-bottom: 16px;">📬</div>
        <h1 class="auth-title">Verify Your Email</h1>
        <p class="auth-subtitle">We have dispatched a verification link to <strong>@ViewBag.Email</strong>. Please check your inbox and click the link to activate full account capabilities.</p>
        <div style="margin-top: 28px;">
            <a asp-action="Login" class="btn btn-secondary">Return to Sign In</a>
        </div>
    </div>
</div>
