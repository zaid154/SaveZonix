@model StreamHelper.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set New Password — SaveZonix";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">Set New Password</h1>
            <p class="auth-subtitle">Choose a strong, secure password for your account</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert error" style="margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>@ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage</span>
            </div>
        }

        <form asp-action="ResetPassword" method="post" class="auth-form">
            <input type="hidden" asp-for="Email" />

            <div class="form-group" style="margin-bottom: 18px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #c9d1d9; margin-bottom: 6px;">
                    Account Email
                </label>
                <input type="email" value="@Model.Email" readonly disabled class="form-control" style="width: 100%; padding: 10px 14px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: #38bdf8; font-size: 13.5px;" />
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label asp-for="Code" style="font-size: 13px; font-weight: 600; color: #c9d1d9; margin: 0;">6-Digit Reset Code (OTP)</label>
                    <span style="font-size: 11px; color: #64748b;">Valid for 10 minutes</span>
                </div>
                <input asp-for="Code" type="text" maxlength="6" class="form-control" placeholder="123456" required autofocus style="width: 100%; padding: 11px 14px; background: #0d1117; border: 1px solid #30363d; border-radius: 8px; color: #f0f6fc; font-size: 18px; font-weight: 700; letter-spacing: 6px; text-align: center; outline: none;" />
                <span asp-validation-for="Code" class="text-danger" style="font-size: 12px; color: #f85149; margin-top: 4px; display: block;"></span>
                <span style="font-size: 11px; color: #8b949e; display: block; margin-top: 5px;">Check your email inbox or spam folder for the 6-digit code.</span>
            </div>

            <div class="form-group">
                <label asp-for="Password">New Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <span>Save New Password</span>
            </button>
        </form>
    </div>
</div>
