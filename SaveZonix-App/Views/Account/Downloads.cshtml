    </style>
    <script>
        function togglePlaylistHistoryAccordion(groupKey) {
            const row = document.getElementById('plGroup_' + groupKey);
            const icon = document.getElementById('plToggleIcon_' + groupKey);
            if (!row) return;
            if (row.style.display === 'none' || row.style.display === '') {
                row.style.display = 'table-row';
                if (icon) icon.textContent = '▲';
            } else {
                row.style.display = 'none';
                if (icon) icon.textContent = '▼';
            }
        }

        async function retryPlaylistGroup(btn, groupIdentifier, groupKey) {
            if (!groupIdentifier && !groupKey) return;
            const originalHtml = btn.innerHTML;
            btn.disabled = true;

            const numMatch = btn.textContent.match(/\d+/);
            const countStr = numMatch ? ` ${numMatch[0]}` : '';
            btn.innerHTML = `<span style="display:inline-flex;align-items:center;gap:5px;"><span class="status-spinner-tiny"></span> Retrying${countStr}...</span>`;

            try {
                const targetId = encodeURIComponent(groupIdentifier || groupKey);
                const qKey = groupKey ? `?groupKey=${encodeURIComponent(groupKey)}` : '';
                const resp = await fetch(`/api/playlist/retry-all-failed/${targetId}${qKey}`, {
                    method: 'POST'
                });
                const data = await resp.json();
                if (resp.ok && data.success) {
                    btn.innerHTML = '<span>✓ Queued!</span>';
                    btn.style.color = '#38bdf8';
                    btn.style.borderColor = 'rgba(56, 189, 248, 0.4)';

                    if (groupKey) {
                        const nestedRow = document.getElementById('plGroup_' + groupKey);
                        if (nestedRow) {
                            const failedRows = nestedRow.querySelectorAll('.pl-sub-failed');
                            failedRows.forEach(row => {
                                const statusEl = row.querySelector('.pl-sub-status');
                                if (statusEl) {
                                    statusEl.innerHTML = '<span class="status-badge-modern status-active"><span class="status-spinner-tiny"></span> Retrying...</span>';
                                }
                                const errEl = row.querySelector('.pl-sub-error-reason');
                                if (errEl) errEl.style.opacity = '0.5';
                            });
                        }
                    }

                    if (window.activeMonitor && typeof window.activeMonitor.pollNow === 'function') {
                        window.activeMonitor.pollNow();
                    }

                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Retry Failed</span>';
                    btn.style.color = '#f43f5e';
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.style.color = '';
                    }, 3000);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                console.error('Error retrying playlist:', err);
            }
        }

        async function retrySinglePlaylistItem(btn, taskId, jobId, originalUrl) {
            if (!taskId && !originalUrl) return;
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="status-spinner-tiny"></span>';

            const row = document.getElementById('subItemRow_' + taskId);
            const statusEl = document.getElementById('subItemStatus_' + taskId) || (row ? row.querySelector('.pl-sub-status') : null);
            const errorEl = document.getElementById('subItemError_' + taskId) || (row ? row.querySelector('.pl-sub-error-reason') : null);

            if (statusEl) {
                statusEl.innerHTML = '<span class="status-badge-modern status-active"><span class="status-spinner-tiny"></span> Retrying...</span>';
            }
            if (errorEl) {
                errorEl.style.opacity = '0.5';
            }

            let videoId = '';
            if (originalUrl) {
                try {
                    const match = originalUrl.match(/(?:youtu\.be\/|v=|\/embed\/|\/v\/|\/shorts\/)([a-zA-Z0-9_-]{11})/);
                    if (match) videoId = match[1];
                } catch { }
            }

            try {
                const resp = await fetch('/api/playlist/retry-item', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        jobId: jobId || '',
                        videoId: videoId || taskId,
                        taskId: taskId
                    })
                });

                const data = await resp.json();
                if (resp.ok && data.success) {
                    btn.innerHTML = '<span style="color: #38bdf8;">✓</span>';
                    if (row) {
                        row.classList.remove('pl-sub-failed');
                    }
                    if (window.activeMonitor && typeof window.activeMonitor.pollNow === 'function') {
                        window.activeMonitor.pollNow();
                    }
                    setTimeout(() => {
                        btn.style.display = 'none';
                    }, 1500);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    if (statusEl) {
                        statusEl.innerHTML = '<span class="status-badge-modern status-err"><span class="status-indicator-dot dot-red"></span> Failed</span>';
                    }
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                console.error('Error retrying item:', err);
                if (statusEl) {
                    statusEl.innerHTML = '<span class="status-badge-modern status-err"><span class="status-indicator-dot dot-red"></span> Failed</span>';
                }
            }
        }

        async function openPlaylistFolder(jobId, playlistTitle) {
            try {
                await fetch('/api/playlist/open-folder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ jobId: jobId || null, playlistTitle: playlistTitle || null })
                });
            } catch {
                openDownloadsFolder();
            }
        }

        async function openDownloadsFolder() {
            try {
                await fetch('/api/open-folder', { method: 'POST' });
            } catch { }
        }
    </script>
}
