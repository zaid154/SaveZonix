@model StreamHelper.ViewModels.UserDownloadsViewModel
@{
    ViewData["Title"] = "My Downloads — SaveZonix";

    string CleanQuality(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "1080p Full HD";
        var q = raw;
        if (q.Contains("(Desktop - Requires browser context)", StringComparison.OrdinalIgnoreCase))
            q = q.Replace("(Desktop - Requires browser context)", "", StringComparison.OrdinalIgnoreCase).Trim();
        if (q.Contains("(Direct Stream)", StringComparison.OrdinalIgnoreCase))
            q = q.Replace("(Direct Stream)", "", StringComparison.OrdinalIgnoreCase).Trim();
        if (string.IsNullOrWhiteSpace(q)) return "Original HD";
        return q;
    }

    string GetPlatformBadgeClass(string? platform)
    {
        var p = (platform ?? "").ToLowerInvariant();
        if (p.Contains("youtube")) return "plat-youtube";
        if (p.Contains("instagram")) return "plat-instagram";
        if (p.Contains("facebook")) return "plat-facebook";
        if (p.Contains("xhamster")) return "plat-xhamster";
        if (p.Contains("mat6")) return "plat-mat6";
        if (p.Contains("pixelflix")) return "plat-pixelflix";
        return "plat-generic";
    }

    string GetPlatformIcon(string? platform)
    {
        var p = (platform ?? "").ToLowerInvariant();
        if (p.Contains("youtube")) return "YT";
        if (p.Contains("instagram")) return "IG";
        if (p.Contains("facebook")) return "FB";
        if (p.Contains("xhamster")) return "XH";
        if (p.Contains("mat6")) return "M6";
        if (p.Contains("pixelflix")) return "PX";
        return "WEB";
    }

    string CleanPlatformName(string? platform)
    {
        if (string.IsNullOrWhiteSpace(platform)) return "Web Stream";
        var p = platform;
        if (p.Contains("•")) p = p.Split('•')[0].Trim();
        return p.ToUpperInvariant();
    }

    TimeZoneInfo GetIndiaTimeZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("India Standard Time"); } catch { }
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata"); } catch { }
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Calcutta"); } catch { }
        return TimeZoneInfo.CreateCustomTimeZone("IST", TimeSpan.FromHours(5.5), "India Standard Time", "IST");
    }

    var indiaTz = GetIndiaTimeZone();

    DateTime ToIndiaTime(DateTime dt)
    {
        if (dt == DateTime.MinValue || dt == DateTime.MaxValue) return dt;
        DateTime utc = dt.Kind == DateTimeKind.Utc 
            ? dt 
            : (dt.Kind == DateTimeKind.Local ? dt.ToUniversalTime() : DateTime.SpecifyKind(dt, DateTimeKind.Utc));
        return TimeZoneInfo.ConvertTimeFromUtc(utc, indiaTz);
    }

    string FormatIndianTime(DateTime dt, bool withSeconds = false)
    {
        var ist = ToIndiaTime(dt);
        return withSeconds 
            ? ist.ToString("hh:mm:ss tt", System.Globalization.CultureInfo.InvariantCulture) 
            : ist.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture);
    }

    string FormatIndianDate(DateTime dt)
    {
        return ToIndiaTime(dt).ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture);
    }
}

<div class="account-page">
    <div class="container">
        <!-- User Downloads Header -->
        <div class="account-header">
            <div>
                <h1 class="page-title">Download History</h1>
                <p class="page-subtitle">Your personal record of high-speed media stream downloads and extractions</p>
            </div>
            <div class="account-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span>New Download</span>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success" style="margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
                <span class="alert-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <!-- Live Active Downloads Monitor (Top Multi-Playlist Accordion Section) -->
        <div id="activeDownloadsContainer" class="active-downloads-card" style="display:none;">
            <div class="active-card-header">
                <div class="active-header-title-wrap">
                    <span class="active-pulse-dot"></span>
                    <h2 class="active-card-title">
                        Active Downloads
                        <span id="activeJobsCountBadge" class="active-count-badge">0 Playlists</span>
                    </h2>
                </div>
                <div class="active-global-speed-wrap">
                    <span id="activeGlobalSpeedBadge" class="active-speed-badge zero-speed">0.0 MB/s</span>
                </div>
                <div class="active-card-actions">
                    <button type="button" id="btnActiveOpenFolder" class="btn-active-ctrl" title="Open Downloads Folder">
                        Open Folder
                    </button>
                    <button type="button" id="btnActiveCancelAll" class="btn-active-ctrl btn-active-cancel" title="Cancel all active playlist downloads">
                        Cancel All
                    </button>
                </div>
            </div>

            <!-- Dynamic Accordion of Active Playlists -->
            <div id="activePlaylistsAccordionList" class="active-playlists-accordion">
                <!-- Dynamically populated via active-downloads-monitor.js -->
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="glass-card filter-card">
            <form method="get" asp-action="Downloads" class="filter-form">
                <div class="admin-filter-grid" style="grid-template-columns: 2fr 1fr 1fr auto;">
                    <div class="form-group search-input-wrapper">
                        <span class="search-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control admin-input" placeholder="Search by title, file name or URL..." />
                    </div>
                    <div class="form-group">
                        <select name="status" class="form-control admin-select">
                            <option value="">All Statuses</option>
                            <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                            <option value="Downloading" selected="@(Model.StatusFilter == "Downloading")">Downloading</option>
                            <option value="Failed" selected="@(Model.StatusFilter == "Failed")">Failed</option>
                            <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <select name="platform" class="form-control admin-select">
                            <option value="">All Platforms</option>
                            <option value="YouTube" selected="@(Model.PlatformFilter == "YouTube")">YouTube</option>
                            <option value="Instagram" selected="@(Model.PlatformFilter == "Instagram")">Instagram</option>
                            <option value="Facebook" selected="@(Model.PlatformFilter == "Facebook")">Facebook</option>
                            <option value="xHamster" selected="@(Model.PlatformFilter == "xHamster")">xHamster</option>
                            <option value="Mat6tube" selected="@(Model.PlatformFilter == "Mat6tube")">Mat6tube</option>
                            <option value="PixelFlix" selected="@(Model.PlatformFilter == "PixelFlix")">PixelFlix</option>
                        </select>
                    </div>
                    <div class="filter-btn-group">
                        <button type="submit" class="btn btn-primary btn-filter-submit">Filter</button>
                        <a asp-action="Downloads" class="btn btn-secondary btn-filter-reset">Reset</a>
                    </div>
                </div>
            </form>
        </div>

        @if (Model.Downloads.Count == 0)
        {
            <div class="glass-card empty-state-card">
                <div class="empty-icon-wrap">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.6"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                </div>
                <h3>No Downloads Found</h3>
                <p>You haven't initiated any downloads matching your criteria.</p>
                <div style="margin-top: 16px;">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Start Downloading Now</a>
                </div>
            </div>
        }
        else
        {
            <div class="glass-card table-glass-card">
                <div class="table-responsive table-scroll-container">
                    <table class="data-table modern-table" style="table-layout: fixed; width: 100%; min-width: 0;">
                        <thead>
                            <tr>
                                <th class="col-media">MEDIA</th>
                                <th class="col-title">TITLE &amp; SOURCE</th>
                                <th class="col-quality">QUALITY &amp; CODEC</th>
                                <th class="col-size">SIZE / SPEED</th>
                                <th class="col-status">STATUS</th>
                                <th class="col-date">DATE</th>
                                <th class="col-action">ACTION</th>
                            </tr>
                        </thead>
                    <tbody>
                        @foreach (var entry in Model.GroupedEntries)
                        {
                            if (entry.IsPlaylistGroup)
                            {
                                var hasFailures = entry.FailedCount > 0 && !entry.IsActive;
                                var firstSub = entry.SubItems.FirstOrDefault();
                                var groupQuality = firstSub != null ? CleanQuality(firstSub.Quality) : "1080p";
                                var groupFormat = firstSub?.Format ?? "MP4";

                                DateTime batchStart = entry.SubItems.Count > 0
                                    ? entry.SubItems.Select(s => s.StartTime > DateTime.MinValue ? s.StartTime : s.CreatedAt).Min()
                                    : entry.CreatedAt;

                                DateTime batchEnd = entry.SubItems.Count > 0
                                    ? entry.SubItems.Select(s => {
                                        if (s.CompletionTime.HasValue && s.CompletionTime.Value > DateTime.MinValue) return s.CompletionTime.Value;
                                        var st = s.StartTime > DateTime.MinValue ? s.StartTime : s.CreatedAt;
                                        return s.DownloadDurationSeconds > 0 ? st.AddSeconds(s.DownloadDurationSeconds) : st;
                                    }).Max()
                                    : batchStart;

                                 double batchElapsedSeconds = 0;
                                if (batchEnd > batchStart && (batchEnd - batchStart).TotalSeconds >= 1)
                                {
                                    batchElapsedSeconds = (batchEnd - batchStart).TotalSeconds;
                                }
                                else
                                {
                                    batchElapsedSeconds = entry.SubItems.Count > 0 ? entry.SubItems.Max(s => s.DownloadDurationSeconds) : 0;
                                }

                                string batchDurationStr = batchElapsedSeconds >= 60
                                    ? $"{(int)(batchElapsedSeconds / 60)}m {(int)(batchElapsedSeconds % 60)}s"
                                    : $"{batchElapsedSeconds:F0}s";

                                <tr class="table-row-item history-pl-group-row" data-job-id="@(entry.JobId ?? "")" data-group-key="@entry.GroupKey">
                                    <td class="col-media">
                                        <div class="media-thumb-container pl-thumb-container">
                                            @if (!string.IsNullOrEmpty(entry.ThumbnailUrl))
                                            {
                                                <img src="@entry.ThumbnailUrl" alt="Thumb" class="table-thumb" loading="lazy" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'table-thumb-fallback\'><svg width=\'20\' height=\'20\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\'><path d=\'M23 7l-7 5 7 5V7z\'/><rect x=\'1\' y=\'5\' width=\'15\' height=\'14\' rx=\'2\' ry=\'2\'/></svg></div>';" />
                                            }
                                            else
                                            {
                                                <div class="table-thumb-fallback">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                                                </div>
                                            }
                                            <span class="pl-thumb-badge">@entry.TotalVideos</span>
                                        </div>
                                    </td>
                                    <td class="col-title">
                                        <div class="title-cell-wrap">
                                            <div class="table-main-title pl-main-title" onclick="togglePlaylistHistoryAccordion('@entry.GroupKey')" style="cursor: pointer;" title="@entry.Title">
                                                <span class="pl-code-pill">@entry.PlaylistCode</span>
                                                <span class="pl-title-text">@entry.Title</span>
                                            </div>
                                            <div class="table-meta-sub">
                                                <span class="platform-tag plat-youtube">
                                                    <span class="plat-icon">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="#ef4444"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                                    </span>
                                                    <span class="plat-name">PLAYLIST</span>
                                                </span>
                                                <span class="file-name-sub">
                                                    <span class="file-text">@entry.CompletedCount of @entry.TotalVideos completed</span>
                                                </span>
                                                @if (batchElapsedSeconds > 0 && !entry.IsActive)
                                                {
                                                    <span style="color: #94a3b8; font-size: 11px; font-weight: 500;">• @batchDurationStr</span>
                                                }
                                                @if (entry.IsActive)
                                                {
                                                    <span style="color: #38bdf8; font-weight: 700; font-size: 11px;">• In Progress</span>
                                                }
                                                else if (hasFailures)
                                                {
                                                    <span style="color: #f43f5e; font-weight: 700; font-size: 11px;">• @entry.FailedCount failed</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="col-quality">
                                        <div class="quality-cell">
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <span class="quality-pill">@groupQuality</span>
                                            </div>
                                            <div class="codec-sub" style="margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@groupFormat • @entry.TotalVideos Videos</div>
                                        </div>
                                    </td>
                                    <td class="col-size">
                                        <div class="size-cell">
                                            <div class="size-main">@entry.FormattedTotalSize</div>
                                            <div class="speed-sub">
                                                <span class="threads-text">Combined</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="col-status">
                                        <div class="status-cell">
                                            @if (entry.IsActive)
                                            {
                                                <span class="status-badge-modern status-active" style="background: rgba(14,165,233,0.12); border: 1px solid rgba(14,165,233,0.3); color: #38bdf8; display: inline-flex; align-items: center; gap: 6px;">
                                                    <span class="status-indicator-dot dot-blue" style="background: #38bdf8; box-shadow: 0 0 8px #38bdf8;"></span>
                                                    <span>Downloading</span>
                                                </span>
                                            }
                                            else if (hasFailures)
                                            {
                                                <span class="status-badge-modern status-err" title="@entry.FailedCount video(s) failed in this playlist">
                                                    <span class="status-indicator-dot dot-red"></span>
                                                    <span>@entry.FailedCount Failed</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge-modern status-done">
                                                    <span class="status-indicator-dot dot-green"></span>
                                                    <span>Completed</span>
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="col-date date-td" style="white-space: nowrap;">
                                        <div class="date-cell">
                                            <div class="date-main">@FormatIndianDate(batchStart)</div>
                                            <div class="date-sub">@FormatIndianTime(batchStart, false)</div>
                                        </div>
                                    </td>
                                    <td class="col-action actions-td" style="text-align: right; white-space: nowrap;">
                                        <div class="actions-cell" style="display: flex; align-items: center; justify-content: flex-end; gap: 5px; white-space: nowrap; width: 100%;">
                                            @if (hasFailures)
                                            {
                                                <button type="button" class="btn-pl-retry-all-main" onclick="retryPlaylistGroup(this, '@(entry.JobId ?? entry.GroupKey)', '@entry.GroupKey')" title="Retry all @entry.FailedCount failed video(s)" style="padding: 4px 8px; font-size: 11px;">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                                    <span>Retry @entry.FailedCount</span>
                                                </button>
                                            }
                                            <button type="button" class="action-btn action-source" onclick="openPlaylistFolder('@(entry.JobId ?? "")', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(entry.Title))')" title="Open Playlist folder">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                            </button>
                                            <button type="button" class="action-btn btn-toggle-pl-sub" onclick="togglePlaylistHistoryAccordion('@entry.GroupKey')" title="Expand / Collapse playlist videos">
                                                <span id="plToggleIcon_@entry.GroupKey">▼</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Nested Accordion Row for this Playlist -->
                                <tr id="plGroup_@entry.GroupKey" class="pl-history-nested-row" style="display:none;">
                                    <td colspan="7" class="pl-nested-td">
                                        <div class="pl-nested-wrapper">
                                            <div class="pl-nested-header">
                                                <div class="pl-nested-header-title">
                                                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                                        <strong>@entry.PlaylistCode</strong> — @entry.Title
                                                    </span>
                                                    <span class="pl-nested-counts">(@entry.CompletedCount / @entry.TotalVideos Completed @(hasFailures ? $"• {entry.FailedCount} Failed" : ""))</span>
                                                </div>
                                                <div style="display: inline-flex; align-items: center; gap: 8px;">
                                                    <button type="button" class="btn-pl-retry-all-header" onclick="openPlaylistFolder('@(entry.JobId ?? "")', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(entry.Title))')" title="Open this playlist folder" style="background: rgba(14, 165, 233, 0.12); border-color: rgba(14, 165, 233, 0.35); color: #38bdf8;">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                                        <span>Open Folder</span>
                                                    </button>
                                                    @if (hasFailures)
                                                    {
                                                        <button type="button" class="btn-pl-retry-all-header" onclick="retryPlaylistGroup(this, '@(entry.JobId ?? entry.GroupKey)', '@entry.GroupKey')" title="Retry all @entry.FailedCount failed video(s)">
                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                                            <span>Retry All @entry.FailedCount Failed</span>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="pl-nested-items-list">
                                                @foreach (var sub in entry.SubItems)
                                                {
                                                    var cleanSubQ = CleanQuality(sub.Quality);
                                                    var subFailed = sub.Status == StreamHelper.Data.DownloadStatus.Failed || sub.Status == StreamHelper.Data.DownloadStatus.Cancelled;
                                                    var subIdStr = !string.IsNullOrEmpty(sub.ValidationDetails) && sub.ValidationDetails.Contains(" • ")
                                                        ? sub.ValidationDetails.Split(" • ")[0]
                                                        : (!string.IsNullOrEmpty(sub.AudioVideoDetails) && sub.AudioVideoDetails.Contains(" • ") ? sub.AudioVideoDetails.Split(" • ")[0] : "");

                                                    DateTime subStart = sub.StartTime > DateTime.MinValue ? sub.StartTime : sub.CreatedAt;
                                                    DateTime subEnd = (sub.CompletionTime.HasValue && sub.CompletionTime.Value > DateTime.MinValue)
                                                        ? sub.CompletionTime.Value
                                                        : (sub.DownloadDurationSeconds > 0 ? subStart.AddSeconds(sub.DownloadDurationSeconds) : subStart);
                                                    string subDurationStr = sub.DownloadDurationSeconds >= 60
                                                        ? $"{(int)(sub.DownloadDurationSeconds / 60)}m {(int)(sub.DownloadDurationSeconds % 60)}s"
                                                        : $"{sub.DownloadDurationSeconds:F1}s";

                                                    <div id="subItemRow_@sub.Id" class="pl-nested-item-row @(subFailed ? "pl-sub-failed" : "")">
                                                        <div class="pl-sub-media">
                                                            @if (!string.IsNullOrEmpty(sub.ThumbnailUrl))
                                                            {
                                                                <img src="@sub.ThumbnailUrl" alt="Thumb" class="pl-sub-thumb" loading="lazy" onerror="this.src='/icons/icon48.png';" />
                             }
                                                            else
                                                            {
                                                                <div class="pl-sub-thumb-fallback">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><polygon points="10 8 16 12 10 16 10 8" fill="#475569"/></svg>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(subIdStr))
                                                            {
                                                                <span class="pl-sub-id-badge">@subIdStr</span>
                                                            }
                                                        </div>
                                                        <div class="pl-sub-info">
                                                            <div class="pl-sub-title" title="@sub.Title">@sub.Title</div>
                                                            @if (subFailed && !string.IsNullOrEmpty(sub.ErrorReason))
                                                            {
                                                                <div class="pl-sub-error-reason" title="@sub.ErrorReason">
                                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -1px; margin-right: 3px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                                                    Reason: @sub.ErrorReason
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="pl-sub-meta">
                                                                    <span class="pl-sub-meta-spec">@cleanSubQ • @(sub.Format ?? "MP4") • @sub.FormattedFileSize</span>
                                                                    <span class="pl-sub-meta-time">
                                                                        <span class="pl-time-tag"><span class="lbl">Start:</span> <strong>@FormatIndianTime(subStart, true)</strong></span>
                                                                        <span class="pl-time-arrow">→</span>
                                                                        <span class="pl-time-tag"><span class="lbl">End:</span> <strong>@FormatIndianTime(subEnd, true)</strong></span>
                                                                        @if (sub.DownloadDurationSeconds > 0)
                                                                        {
                                                                            <span class="pl-time-dur">(@subDurationStr)</span>
                                                                        }
                                                                    </span>
                                                                    @if (sub.AverageSpeedMBps > 0)
                                                                    {
                                                                        <span class="pl-sub-meta-speed">
                                                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="#34d399" stroke="none" style="vertical-align: 0px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Avg: <strong>@sub.AverageSpeedMBps.ToString("F1") MB/s</strong>
                                                                            @(sub.PeakSpeedMBps > 0 ? $"• Peak: {sub.PeakSpeedMBps:F1} MB/s" : "")
                                                                        </span>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="pl-sub-status">
                                                            @if (sub.Status == StreamHelper.Data.DownloadStatus.Completed)
                                                            {
                                                                <span class="status-badge-modern status-done"><span class="status-indicator-dot dot-green"></span> Completed</span>
                                                            }
                                                            else if (subFailed)
                                                            {
                                                                <span class="status-badge-modern status-err"><span class="status-indicator-dot dot-red"></span> Failed</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="status-badge-modern status-active"><span class="status-spinner-tiny"></span> @sub.Status</span>
                                                            }
                                                        </div>
                                                        <div class="pl-sub-actions">
                                                            @if (!string.IsNullOrEmpty(sub.OriginalUrl))
                                                            {
                                                                @if (subFailed)
                                                                {
                                                                    <button type="button" class="action-btn action-retry" onclick="retrySinglePlaylistItem(this, '@sub.Id', '@(entry.JobId ?? entry.GroupKey)', '@sub.OriginalUrl')" title="Retry this video">
                                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                                                    </button>
                                                                }
                                                                <a href="@sub.OriginalUrl" target="_blank" class="action-btn action-source" title="Open source stream / webpage" rel="noopener noreferrer">
                                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (entry.SingleItem != null)
                            {
                                var item = entry.SingleItem;
                                var cleanQ = CleanQuality(item.Quality);
                                var platClass = GetPlatformBadgeClass(item.Platform);
                                var platIcon = GetPlatformIcon(item.Platform);
                                var platName = CleanPlatformName(item.Platform);

                                <tr class="table-row-item">
                                    <td class="col-media">
                                        <div class="media-thumb-container">
                                            @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                            {
                                                <img src="@item.ThumbnailUrl" alt="Thumb" class="table-thumb" loading="lazy" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'table-thumb-fallback\'><svg width=\'20\' height=\'20\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\'><path d=\'M23 7l-7 5 7 5V7z\'/><rect x=\'1\' y=\'5\' width=\'15\' height=\'14\' rx=\'2\' ry=\'2\'/></svg></div>';" />
                                            }
                                            else
                                            {
                                                <div class="table-thumb-fallback">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="col-title">
                                        <div class="title-cell-wrap">
                                            <div class="table-main-title" title="@item.Title">
                                                <span class="single-title-text">@item.Title</span>
                                            </div>
                                            @if ((item.Status == StreamHelper.Data.DownloadStatus.Failed || item.Status == StreamHelper.Data.DownloadStatus.Cancelled) && !string.IsNullOrEmpty(item.ErrorReason))
                                            {
                                                <div class="pl-sub-error-reason" style="margin: 3px 0 4px 0;" title="@item.ErrorReason">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -1px; margin-right: 3px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                                    Reason: @item.ErrorReason
                                                </div>
                                            }
                                            <div class="table-meta-sub">
                                                <span class="platform-tag @platClass">
                                                    <span class="plat-icon">@platIcon</span>
                                                    <span class="plat-name">@platName</span>
                                                </span>
                                                @if (!string.IsNullOrEmpty(item.FileName) && item.FileName != item.Title)
                                                {
                                                    <span class="file-name-sub" title="@item.FileName">
                                                        <span class="file-icon"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -1px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                                                        <span class="file-text">@item.FileName</span>
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="col-quality">
                                        <div class="quality-cell">
                                            <span class="quality-pill">@cleanQ</span>
                                            <div class="codec-sub" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(item.Format ?? "MP4") • @(item.Codec ?? "H.264 / AAC")</div>
                                        </div>
                                    </td>
                                    <td class="col-size">
                                        <div class="size-cell">
                                            <div class="size-main">@item.FormattedFileSize</div>
                                            <div class="speed-sub">
                                                @if (item.AverageSpeedMBps > 0)
                                                {
                                                    <span class="speed-live" title="Avg: @item.AverageSpeedMBps.ToString("F1") MB/s | Peak: @item.PeakSpeedMBps.ToString("F1") MB/s">
                                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="#34d399" stroke="none" style="vertical-align: 0px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                                        @item.AverageSpeedMBps.ToString("F1") MB/s @(item.PeakSpeedMBps > 0 ? $"• Peak {item.PeakSpeedMBps:F1}" : "")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="threads-text">@(item.ThreadsUsed > 0 ? item.ThreadsUsed : 16) workers</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="col-status">
                                        <div class="status-cell">
                                            @switch (item.Status)
                                            {
                                                case StreamHelper.Data.DownloadStatus.Completed:
                                                    <span class="status-badge-modern status-done">
                                                        <span class="status-indicator-dot dot-green"></span>
                                                        <span>Completed</span>
                                                    </span>
                                                    break;
                                                case StreamHelper.Data.DownloadStatus.Downloading:
                                                    <span class="status-badge-modern status-active">
                                                        <span class="status-spinner-tiny"></span>
                                                        <span>Downloading</span>
                                                    </span>
                                                    break;
                                                case StreamHelper.Data.DownloadStatus.Failed:
                                                    <span class="status-badge-modern status-err" title="@item.ErrorReason">
                                                        <span class="status-indicator-dot dot-red"></span>
                                                        <span>Failed</span>
                                                    </span>
                                                    break;
                                                case StreamHelper.Data.DownloadStatus.Cancelled:
                                                    <span class="status-badge-modern status-canceled">
                                                        <span class="status-indicator-dot dot-gray"></span>
                                                        <span>Cancelled</span>
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="status-badge-modern status-wait">
                                                        <span class="status-indicator-dot dot-amber"></span>
                                                        <span>@item.Status</span>
                                                    </span>
                                                    break;
                                            }
                                        </div>
                                    </td>
                                    @{
                                        DateTime sStart = item.StartTime > DateTime.MinValue ? item.StartTime : item.CreatedAt;
                                        DateTime sEnd = (item.CompletionTime.HasValue && item.CompletionTime.Value > DateTime.MinValue)
                                            ? item.CompletionTime.Value
                                            : (item.DownloadDurationSeconds > 0 ? sStart.AddSeconds(item.DownloadDurationSeconds) : sStart);
                                        string sDurStr = item.DownloadDurationSeconds >= 60
                                            ? $"{(int)(item.DownloadDurationSeconds / 60)}m {(int)(item.DownloadDurationSeconds % 60)}s"
                                            : $"{item.DownloadDurationSeconds:F1}s";
                                    }
                                    <td class="col-date date-td" style="white-space: nowrap;">
                                        <div class="date-cell">
                                            <div class="date-main">@FormatIndianDate(sStart)</div>
                                            <div class="date-sub">@FormatIndianTime(sStart, false)</div>
                                        </div>
                                    </td>
                                    <td class="col-action actions-td" style="text-align: right; white-space: nowrap;">
                                        <div class="actions-cell" style="display: flex; align-items: center; justify-content: flex-end; gap: 5px; white-space: nowrap; width: 100%;">
                                            @if (!string.IsNullOrEmpty(item.OriginalUrl))
                                            {
                                                @if (item.Status == StreamHelper.Data.DownloadStatus.Failed || item.Status == StreamHelper.Data.DownloadStatus.Cancelled)
                                                {
                                                    <a href="/?url=@System.Net.WebUtility.UrlEncode(item.OriginalUrl)" class="action-btn action-retry" title="Re-download this stream">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                                    </a>
                                                }
                                                <a href="@item.OriginalUrl" target="_blank" class="action-btn action-source" title="Open source stream / webpage" rel="noopener noreferrer">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                                </a>
                                            }
                                            @if (item.Status == StreamHelper.Data.DownloadStatus.Downloading || item.Status == StreamHelper.Data.DownloadStatus.Retrying || item.Status == StreamHelper.Data.DownloadStatus.Resolving)
                                            {
                                                <form asp-action="CancelDownload" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Stop and cancel this download?');" style="display: inline-block;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="action-btn action-cancel" title="Cancel download">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                                    </button>
                                                </form>
                                            }
                                            <form asp-action="DeleteDownload" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remove this download from your history?');" style="display: inline-block;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn action-delete" title="Delete record">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            </div>

            <!-- Figma Auto-Layout Inspired Modern Pagination -->
            @if (Model.TotalCount > 0)
            {
                int current = Model.CurrentPage;
                int total = Model.TotalPages;
                int startItem = ((current - 1) * Model.PageSize) + 1;
                int endItem = Math.Min(current * Model.PageSize, Model.TotalCount);

                <div class="figma-pagination-wrapper" style="display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 32px; margin-bottom: 24px;">
                    <div class="pagination-info" style="font-size: 12.5px; color: #94a3b8; font-weight: 500;">
                        Showing <strong style="color: #38bdf8;">@startItem</strong> to <strong style="color: #38bdf8;">@endItem</strong> of <strong style="color: #f1f5f9;">@Model.TotalCount</strong> downloads
                    </div>
                    @if (total > 1)
                    {
                        var pageNumbers = new List<int>();
                        pageNumbers.Add(1);
                        for (int i = Math.Max(2, current - 1); i <= Math.Min(total - 1, current + 1); i++)
                        {
                            if (!pageNumbers.Contains(i)) pageNumbers.Add(i);
                        }
                        if (!pageNumbers.Contains(total)) pageNumbers.Add(total);
                        pageNumbers.Sort();

                        <div class="figma-pagination-container" style="margin-top: 0; margin-bottom: 0;">
                            @if (current > 1)
                            {
                                <a asp-action="Downloads" asp-route-page="@(current - 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-platform="@Model.PlatformFilter" class="figma-nav-btn figma-btn-prev" title="Previous Page">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                </a>
                            }
                            else
                            {
                                <span class="figma-nav-btn figma-btn-disabled" title="First Page">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                </span>
                            }

                            <div class="figma-page-items">
                                @{
                                    int lastPage = 0;
                                    foreach (int p in pageNumbers)
                                    {
                                        if (lastPage > 0 && p - lastPage > 1)
                                        {
                                            <span class="figma-page-ellipsis">•••</span>
                                        }

                                        if (p == current)
                                        {
                                            <span class="figma-page-btn figma-page-active">@p</span>
                                        }
                                        else
                                        {
                                            <a asp-action="Downloads" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-platform="@Model.PlatformFilter" class="figma-page-btn">@p</a>
                                        }
                                        lastPage = p;
                                    }
                                }
                            </div>

                            @if (current < total)
                            {
                                <a asp-action="Downloads" asp-route-page="@(current + 1)" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.StatusFilter" asp-route-platform="@Model.PlatformFilter" class="figma-nav-btn figma-btn-next" title="Next Page">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </a>
                            }
                            else
                            {
                                <span class="figma-nav-btn figma-btn-disabled" title="Last Page">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="figma-pagination-container" style="margin-top: 0; margin-bottom: 0;">
                            <span class="figma-nav-btn figma-btn-disabled"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
                            <div class="figma-page-items">
                                <span class="figma-page-btn figma-page-active">1</span>
                            </div>
                            <span class="figma-nav-btn figma-btn-disabled"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/active-downloads-monitor.js" asp-append-version="true"></script>
    <style>
        /* ─── Guaranteed Zero Horizontal Scroll ─── */
        .table-responsive,
        .table-scroll-container {
            overflow-x: hidden !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        .table-glass-card .modern-table,
        .modern-table {
            table-layout: fixed !important;
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
        }

        .table-glass-card .modern-table th,
        .table-glass-card .modern-table td {
            padding: 10px 8px !important;
            box-sizing: border-box !important;
            vertical-align: middle !important;
        }

        /* ─── Strict Column Width Balancing (Zero Gap between Date & Action) ─── */
        .modern-table th.col-media,
        .modern-table td.col-media {
            width: 58px !important;
            min-width: 58px !important;
            max-width: 58px !important;
            padding-left: 12px !important;
        }

        .modern-table th.col-title,
        .modern-table td.col-title {
            width: auto !important;
            min-width: 260px !important;
        }

        .modern-table th.col-quality,
        .modern-table td.col-quality {
            width: 125px !important;
            min-width: 125px !important;
            max-width: 125px !important;
            white-space: nowrap !important;
        }

        .modern-table th.col-size,
        .modern-table td.col-size {
            width: 105px !important;
            min-width: 105px !important;
            max-width: 105px !important;
            white-space: nowrap !important;
        }

        .modern-table th.col-status,
        .modern-table td.col-status {
            width: 115px !important;
            min-width: 115px !important;
            max-width: 115px !important;
            white-space: nowrap !important;
        }

        .modern-table th.col-date,
        .modern-table td.col-date {
            width: 100px !important;
            min-width: 100px !important;
            max-width: 100px !important;
            white-space: nowrap !important;
        }

        .modern-table th.col-action,
        .modern-table td.col-action {
            width: 95px !important;
            min-width: 95px !important;
            max-width: 95px !important;
            text-align: right !important;
            padding-right: 12px !important;
            white-space: nowrap !important;
        }

        /* ─── Fluid Title & Zero Overlap / Zero Premature Truncation ─── */
        .table-glass-card .title-cell-wrap {
            min-width: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
            overflow: hidden !important;
        }

        .table-main-title {
            display: flex !important;
            align-items: center !important;
            gap: 7px !important;
            min-width: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            font-size: 13.5px !important;
            font-weight: 600 !important;
            color: #f8fafc !important;
            line-height: 1.35 !important;
            margin-bottom: 3px !important;
        }

        .table-main-title .pl-code-pill {
            flex-shrink: 0 !important;
        }

        .table-main-title .pl-title-text,
        .table-main-title .single-title-text,
        .table-main-title > span:last-child {
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            min-width: 0 !important;
            flex: 1 1 auto !important;
            display: block !important;
        }

        .table-meta-sub {
            display: flex !important;
            align-items: center !important;
            gap: 8px !important;
            font-size: 11.5px !important;
            color: #94a3b8 !important;
            white-space: nowrap !important;
            min-width: 0 !important;
            overflow: hidden !important;
        }

        .file-name-sub {
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
            min-width: 0 !important;
        }

        /* ─── Guaranteed Date & Action Cell Formatting (No-Wrap, Zero Dead Gap) ─── */
        .date-cell, .date-main, .date-sub, td.date-td {
            white-space: nowrap !important;
        }
        .date-cell {
            display: flex !important;
            flex-direction: column !important;
            gap: 2px !important;
            white-space: nowrap !important;
        }
        .date-main {
            font-size: 12.5px !important;
            font-weight: 600 !important;
            color: #cbd5e1 !important;
            white-space: nowrap !important;
            letter-spacing: 0.2px !important;
        }
        .date-sub {
            font-size: 11px !important;
            color: #64748b !important;
            font-family: 'JetBrains Mono', monospace !important;
            white-space: nowrap !important;
        }
        td.actions-td, th.col-action, td.col-action {
            width: 95px !important;
            min-width: 95px !important;
            max-width: 95px !important;
            white-space: nowrap !important;
        }
        .actions-cell {
            white-space: nowrap !important;
            display: flex !important;
            align-items: center !important;
            justify-content: flex-end !important;
            gap: 5px !important;
            width: 100% !important;
        }

        /* ─── Quality & Codec and Time Diagnostics Polish ─── */
        .pl-collection-pill {
            display: inline-flex !important;
            align-items: center !important;
            width: fit-content !important;
            max-width: fit-content !important;
            padding: 2px 7px !important;
            border-radius: 5px !important;
            font-size: 10.5px !important;
            font-weight: 700 !important;
            letter-spacing: 0.3px !important;
            background: rgba(99, 102, 241, 0.18) !important;
            color: #a5b4fc !important;
            border: 1px solid rgba(99, 102, 241, 0.35) !important;
            white-space: nowrap !important;
            line-height: 1.2 !important;
        }

        .pl-sub-meta {
            display: flex !important;
            align-items: center !important;
            flex-wrap: wrap !important;
            gap: 8px !important;
            font-size: 11.5px !important;
            margin-top: 4px !important;
        }

        .pl-sub-meta-spec {
            color: #94a3b8;
            font-weight: 500;
        }

        .pl-sub-meta-time {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 5px;
            font-size: 11px;
            color: #94a3b8;
        }

        .pl-sub-meta-time .lbl {
            color: #64748b;
            font-size: 10.5px;
            margin-right: 2px;
        }

        .pl-sub-meta-time strong {
            color: #e2e8f0;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        }

        .pl-time-arrow {
            color: #64748b;
            font-size: 10px;
        }

        .pl-time-dur {
            color: #38bdf8;
            font-weight: 600;
            margin-left: 2px;
        }

        .pl-sub-meta-speed {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 8px;
            background: rgba(14, 165, 233, 0.1);
            border: 1px solid rgba(14, 165, 233, 0.25);
            border-radius: 5px;
            font-size: 11px;
            color: #38bdf8;
        }

        .pl-sub-meta-speed strong {
            color: #7dd3fc;
        }

        .pl-date-range {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-top: 2px;
            font-size: 11px;
        }

        .btn-pl-retry-all-main {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            font-size: 11.5px;
            font-weight: 600;
            color: #38bdf8;
            background: rgba(14, 165, 233, 0.12);
            border: 1px solid rgba(14, 165, 233, 0.35);
            border-radius: 6px;
