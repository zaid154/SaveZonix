@{
    ViewData["Title"] = "Password Reset Sent — SaveZonix";
}

<div class="auth-wrapper">
    <div class="auth-card" style="text-align: center;">
        <div style="display: flex; justify-content: center; margin-bottom: 20px;">
            <div style="width: 56px; height: 56px; border-radius: 14px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); display: flex; align-items: center; justify-content: center; color: #38bdf8;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
        </div>
        <h1 class="auth-title">Check Your Inbox</h1>
        <p class="auth-subtitle">@ViewBag.Message</p>
        <div style="margin-top: 28px;">
            <a asp-action="Login" class="btn btn-secondary">Return to Sign In</a>
        </div>
    </div>
</div>
