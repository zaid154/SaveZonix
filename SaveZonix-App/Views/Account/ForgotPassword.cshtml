@model StreamHelper.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset Password — SaveZonix";
}

<div class="auth-wrapper" style="min-height: calc(100vh - 160px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
    <div class="auth-card" style="width: 100%; max-width: 420px; background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 36px 32px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
        
        <div class="auth-header" style="text-align: center; margin-bottom: 28px;">
            <a href="/" class="brand-link" style="justify-content: center; margin-bottom: 14px; text-decoration: none;">
                <partial name="_Logo" model='"brand-logo-img"' />
                <div class="brand-text" style="font-size: 20px; font-weight: 800;">Save<span>Zonix</span></div>
            </a>
            <h1 class="auth-title" style="font-size: 22px; font-weight: 700; color: #f0f6fc; margin: 0 0 6px 0;">Reset your password</h1>
            <p class="auth-subtitle" style="font-size: 13px; color: #8b949e; margin: 0;">Enter your account email and we'll send a recovery link</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Email" style="display: block; font-size: 13px; font-weight: 600; color: #c9d1d9; margin-bottom: 6px;">Email address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="rahul.sharma@gmail.com" required style="width: 100%; padding: 11px 14px; background: #0d1117; border: 1px solid #30363d; border-radius: 8px; color: #f0f6fc; font-size: 14px; outline: none;" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 12px; color: #f85149; margin-top: 4px; display: block;"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="width: 100%; padding: 12px; background: #238636; border: 1px solid rgba(240, 246, 252, 0.1); border-radius: 8px; color: #ffffff; font-size: 14px; font-weight: 700; cursor: pointer;">
                <span>Send Reset Link</span>
            </button>
        </form>

        <div class="auth-footer" style="text-align: center; margin-top: 24px; padding-top: 20px; border-top: 1px solid #21262d; font-size: 13px; color: #8b949e;">
            <p style="margin: 0;">Remembered your password? <a asp-action="Login" class="auth-link" style="color: #58a6ff; font-weight: 600; text-decoration: none;">Back to Sign In</a></p>
        </div>
    </div>
</div>
