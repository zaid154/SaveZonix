@model StreamHelper.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account — SaveZonix";
    ViewData["ActiveNav"] = "Auth";
}

<div class="auth-wrapper" style="min-height: calc(100vh - 125px); display: flex; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;">
    <div class="auth-card" style="width: 100%; max-width: 410px; background: #161b22; border: 1px solid #30363d; border-radius: 16px; padding: 26px 28px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); box-sizing: border-box;">
        
        <!-- Brand Header -->
        <div class="auth-header" style="text-align: center; margin-bottom: 18px;">
            <a href="/" class="brand-link" style="justify-content: center; margin-bottom: 8px; text-decoration: none;">
                <partial name="_Logo" model='"brand-logo-img"' />
                <div class="brand-text" style="font-size: 20px; font-weight: 800;">Save<span>Zonix</span></div>
            </a>
            <h1 class="auth-title" id="authTitle" style="font-size: 20px; font-weight: 700; color: #f0f6fc; margin: 0 0 4px 0;">Create your account</h1>
            <p class="auth-subtitle" id="authSubtitle" style="font-size: 12px; color: #8b949e; margin: 0;">Join SaveZonix for unlimited high-speed downloads</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert error" style="display: flex; align-items: center; gap: 8px; background: rgba(248, 81, 73, 0.1); border: 1px solid rgba(248, 81, 73, 0.4); color: #f85149; padding: 10px 12px; border-radius: 8px; font-size: 12px; margin-bottom: 14px;">
                <span>⚠️</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <!-- Alert Notification Box -->
        <div id="regAlert" class="alert error" style="display: none; margin-bottom: 14px; padding: 10px 12px; font-size: 12px; border-radius: 8px; align-items: center; gap: 8px;">
            <span class="alert-icon" id="regAlertIcon">⚠️</span>
            <span id="regAlertMsg"></span>
        </div>

        <!-- STEP 1: Registration Form -->
        <div id="stepDetails">
            @* Google OAuth temporarily hidden per user request
            <form asp-controller="Account" asp-action="ExternalLogin" method="post" style="margin-bottom: 12px;">
                <button type="submit" name="provider" value="Google" class="btn btn-google" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 10px 16px; background: #21262d; border: 1px solid #30363d; border-radius: 8px; color: #f0f6fc; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
                    <svg width="17" height="17" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Sign up with Google</span>
                </button>
            </form>

            <div class="auth-divider" style="margin: 12px 0 14px 0;">
                <span style="font-size: 11px;">or register with email</span>
            </div>
            *@

            <form id="formStep1" onsubmit="handleSendOtp(event)" class="auth-form">
                <div class="form-group" style="margin-bottom: 12px;">
                    <label for="txtFullName" style="display: block; font-size: 12px; font-weight: 600; color: #c9d1d9; margin-bottom: 5px;">Full Name</label>
                    <input id="txtFullName" class="form-control" placeholder="Rahul Sharma" required autocomplete="name" style="width: 100%; box-sizing: border-box; padding: 9px 12px; background: #0d1117; border: 1px solid #30363d; border-radius: 8px; color: #f0f6fc; font-size: 13px; outline: none; transition: border-color 0.2s;" />
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label for="txtEmail" style="display: block; font-size: 12px; font-weight: 600; color: #c9d1d9; margin-bottom: 5px;">Email Address</label>
                    <input id="txtEmail" type="email" class="form-control" placeholder="rahul.sharma@gmail.com" required autocomplete="email" style="width: 100%; box-sizing: border-box; padding: 9px 12px; background: #0d1117; border: 1px solid #30363d; border-radius: 8px; color: #f0f6fc; font-size: 13px; outline: none; transition: border-color 0.2s;" />
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label for="txtPassword" style="display: block; font-size: 12px; font-weight: 600; color: #c9d1d9; margin-bottom: 5px;">Password</label>
                    <input id="txtPassword" type="password" class="form-control" placeholder="At least 6 characters" minlength="6" required autocomplete="new-password" style="width: 100%; box-sizing: border-box; padding: 9px 12px; background: #0d1117; border: 1px solid #30363d; border-radius: 8px; color: #f0f6fc; font-size: 13px; outline: none; transition: border-color 0.2s;" />
                </div>

                <button type="submit" id="btnSendOtp" class="btn btn-primary btn-block" style="width: 100%; box-sizing: border-box; margin-top: 6px; padding: 10px 16px; background: #238636; border: 1px solid rgba(240, 246, 252, 0.1); border-radius: 8px; color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    <span id="btnSendOtpText">Create Account</span>
                </button>
            </form>

            <div class="auth-footer" style="text-align: center; margin-top: 16px; padding-top: 12px; font-size: 12px; color: #8b949e;">
                <p style="margin: 0;">Already have an account? <a asp-action="Login" class="auth-link" style="color: #58a6ff; font-weight: 600; text-decoration: none;">Sign in</a></p>
            </div>
        </div>

        <!-- STEP 2: 6-Digit Email Verification Screen -->
        <div id="stepOtp" style="display: none;">
            <div style="text-align: center; margin-bottom: 20px;">
                <div style="font-size: 38px; margin-bottom: 8px;">📩</div>
                <p style="font-size: 13px; color: #94a3b8; line-height: 1.5; margin: 0;">
                    We sent a 6-digit confirmation code to <br>
                    <strong id="targetEmailDisplay" style="color: #f8fafc;"></strong>
                </p>
            </div>

            <form id="formStep2" onsubmit="handleVerifyOtp(event)" class="auth-form">
                <!-- 6 Individual Digit Boxes -->
                <div style="display: flex; gap: 8px; justify-content: center; margin-bottom: 20px;">
                    <input type="text" maxlength="1" class="otp-box" inputmode="numeric" pattern="[0-9]*" autofocus autocomplete="one-time-code">
                    <input type="text" maxlength="1" class="otp-box" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-box" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-box" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-box" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" maxlength="1" class="otp-box" inputmode="numeric" pattern="[0-9]*">
                </div>

                <button type="submit" id="btnVerifyOtp" class="btn btn-primary btn-block" style="width: 100%; box-sizing: border-box; padding: 10px 16px; background: #238636; border: 1px solid rgba(240, 246, 252, 0.1); border-radius: 8px; color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    <span id="btnVerifyText">Verify &amp; Continue</span>
                </button>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 18px; font-size: 12.5px;">
                    <button type="button" onclick="backToStep1()" style="background: none; border: none; color: #8b949e; cursor: pointer; padding: 0; font-size: 12.5px;">
                        ← Change email
                    </button>
                    <button type="button" id="btnResend" onclick="handleResendOtp()" style="background: none; border: none; color: #58a6ff; cursor: pointer; padding: 0; font-size: 12.5px; font-weight: 600;">
                        Resend code
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

<style>
    .otp-box {
        width: 44px;
        height: 50px;
        background: #0d1117;
        border: 1.5px solid #30363d;
        border-radius: 8px;
        color: #38bdf8;
        font-size: 22px;
        font-weight: 800;
        text-align: center;
        font-family: 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace;
        transition: all 0.15s ease;
        outline: none;
        box-sizing: border-box;
    }
    .otp-box:focus {
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
        background: #161b22;
    }
</style>

<script>
    let registeredEmail = '';
    let resendCountdown = 0;
    let resendTimer = null;

    const otpBoxes = document.querySelectorAll('.otp-box');

    // Smooth auto-focus & keyboard navigation across the 6 boxes
    otpBoxes.forEach((box, index) => {
        box.addEventListener('input', (e) => {
            const val = e.target.value.replace(/[^0-9]/g, '');
            e.target.value = val;
            if (val && index < otpBoxes.length - 1) {
                otpBoxes[index + 1].focus();
            }
        });

        box.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !e.target.value && index > 0) {
                otpBoxes[index - 1].focus();
            }
        });

        // Instant Paste Support (e.g. user copies 123456 from email)
        box.addEventListener('paste', (e) => {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 6);
            if (pasted) {
                pasted.split('').forEach((char, i) => {
                    if (otpBoxes[i]) otpBoxes[i].value = char;
                });
                const nextIdx = Math.min(pasted.length, otpBoxes.length - 1);
                otpBoxes[nextIdx].focus();
            }
        });
    });

    function showAlert(msg, isSuccess = false) {
        const alertBox = document.getElementById('regAlert');
        const alertMsg = document.getElementById('regAlertMsg');
        const alertIcon = document.getElementById('regAlertIcon');
        
        alertBox.className = isSuccess ? 'alert success' : 'alert error';
        alertBox.style.display = 'flex';
        alertIcon.textContent = isSuccess ? '✓' : '⚠️';
        alertMsg.textContent = msg;
    }

    function hideAlert() {
        document.getElementById('regAlert').style.display = 'none';
    }

    // Step 1: Send Registration OTP
    async function handleSendOtp(e) {
        e.preventDefault();
        hideAlert();

        const fullName = document.getElementById('txtFullName').value.trim();
        const email = document.getElementById('txtEmail').value.trim();
        const password = document.getElementById('txtPassword').value;

        const btn = document.getElementById('btnSendOtp');
        const btnText = document.getElementById('btnSendOtpText');
        btn.disabled = true;
        btnText.textContent = 'Sending Code...';

        try {
            const res = await fetch('/api/auth/send-registration-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fullName, email, password })
            });

            const data = await res.json();
            if (!res.ok || !data.success) {
                showAlert(data.message || 'Unable to send verification code.');
                btn.disabled = false;
                btnText.textContent = 'Create Account';
                return;
            }

            registeredEmail = email;
            document.getElementById('targetEmailDisplay').textContent = email;
            document.getElementById('stepDetails').style.display = 'none';
            document.getElementById('stepOtp').style.display = 'block';
            document.getElementById('authTitle').textContent = 'Enter Verification Code';
            document.getElementById('authSubtitle').textContent = 'Check your email inbox or spam folder';

            startResendCountdown(60);
            otpBoxes[0].focus();
        } catch (err) {
            showAlert('Network error: ' + err.message);
        } finally {
            btn.disabled = false;
            btnText.textContent = 'Create Account';
        }
    }

    // Step 2: Verify 6-Digit OTP
    async function handleVerifyOtp(e) {
        e.preventDefault();
        hideAlert();

        let otp = '';
        otpBoxes.forEach(b => otp += b.value.trim());

        if (otp.length < 6) {
            showAlert('Please enter all 6 digits of your verification code.');
            return;
        }

        const btn = document.getElementById('btnVerifyOtp');
        const btnText = document.getElementById('btnVerifyText');
        btn.disabled = true;
        btnText.textContent = 'Verifying...';

        try {
            const res = await fetch('/api/auth/verify-registration-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: registeredEmail, otp })
            });

            const data = await res.json();
            if (!res.ok || !data.success) {
                showAlert(data.message || 'Incorrect verification code.');
                btn.disabled = false;
                btnText.textContent = 'Verify & Continue';
                return;
            }

            showAlert('✓ Account verified successfully! Redirecting...', true);
            setTimeout(() => {
                window.location.href = '/';
            }, 800);
        } catch (err) {
            showAlert('Verification error: ' + err.message);
            btn.disabled = false;
            btnText.textContent = 'Verify & Continue';
        }
    }

    function backToStep1() {
        hideAlert();
        document.getElementById('stepOtp').style.display = 'none';
        document.getElementById('stepDetails').style.display = 'block';
        document.getElementById('authTitle').textContent = 'Create your account';
        document.getElementById('authSubtitle').textContent = 'Join SaveZonix for unlimited high-speed parallel downloads';
    }

    async function handleResendOtp() {
        if (resendCountdown > 0) return;
        hideAlert();

        const btnResend = document.getElementById('btnResend');
        btnResend.textContent = 'Sending...';

        try {
            const res = await fetch('/api/auth/resend-registration-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: registeredEmail })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                showAlert('✓ A new verification code has been sent.', true);
                startResendCountdown(45);
            } else {
                showAlert(data.message || 'Could not resend code.');
            }
        } catch (err) {
            showAlert('Error: ' + err.message);
        }
    }

    function startResendCountdown(seconds) {
        resendCountdown = seconds;
        const btnResend = document.getElementById('btnResend');
        btnResend.style.color = '#64748b';
        btnResend.style.cursor = 'default';

        if (resendTimer) clearInterval(resendTimer);
        resendTimer = setInterval(() => {
            resendCountdown--;
            if (resendCountdown <= 0) {
                clearInterval(resendTimer);
                btnResend.textContent = 'Resend code';
                btnResend.style.color = '#38bdf8';
                btnResend.style.cursor = 'pointer';
            } else {
                btnResend.textContent = `Resend code (${resendCountdown}s)`;
            }
        }, 1000);
    }
</script>
