@model StreamHelper.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile & Identity — SaveZonix";
    ViewData["ActiveNav"] = "Profile";

    var initialLetter = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName.Trim().Substring(0, 1).ToUpper()
        : (!string.IsNullOrWhiteSpace(Model.Email) ? Model.Email.Substring(0, 1).ToUpper() : "U");

    var isAdmin = string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase);
    var isVip = Model.IsVip || isAdmin;
    var membershipLabel = isAdmin ? "Super Admin" : (isVip ? "VIP PRO Member" : "Standard Explorer");
}

<div class="account-dashboard-shell">
    <div class="container">
        <!-- Unified Account Sub-Navigation Bar -->
        <div class="account-nav-bar">
            <a asp-action="Profile" class="account-nav-pill active">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>Profile &amp; Identity</span>
            </a>
            <a asp-action="Settings" class="account-nav-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Security &amp; Preferences</span>
            </a>
            <a asp-action="Downloads" class="account-nav-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Download History</span>
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success" style="margin-bottom: 24px;">
                <span class="alert-icon">✅</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <!-- Hero Identity Card -->
        <div class="account-hero-card">
            <div class="account-hero-inner">
                <div class="account-identity-group">
                    <div class="account-avatar-monogram" title="@Model.FullName">
                        @initialLetter
                    </div>
                    <div class="account-identity-info">
                        <div class="account-identity-name-row">
                            <h1 class="account-user-name">@Model.FullName</h1>
                            @if (isAdmin)
                            {
                                <span class="account-tier-badge tier-badge-admin" style="display: inline-flex; align-items: center; gap: 4px;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    Super Admin
                                </span>
                            }
                            else if (isVip)
                            {
                                <span class="account-tier-badge tier-badge-vip" style="display: inline-flex; align-items: center; gap: 4px;">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    VIP PRO
                                </span>
                            }
                            else
                            {
                                <span class="account-tier-badge tier-badge-standard">
                                    Free Explorer
                                </span>
                            }
                        </div>
                        <div class="account-identity-meta-row">
                            <span class="account-meta-item">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                                @Model.Email
                            </span>
                            @if (Model.EmailConfirmed)
                            {
                                <span class="account-verified-pill" style="display: inline-flex; align-items: center; gap: 4px;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                    Verified Account
                                </span>
                            }
                            <span class="account-meta-item">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                Member since @Model.CreatedAt.ToString("MMM yyyy")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="account-hero-actions">
                    @if (!isVip)
                    {
                        <a href="https://save-zonix.vercel.app/#pricing" target="_blank" class="btn btn-primary" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-color: #f59e0b; display: inline-flex; align-items: center; gap: 6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            <span>Upgrade to VIP PRO</span>
                        </a>
                    }
                    <a asp-action="Downloads" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        <span>Download History</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Telemetry Stats Grid (4 Glass Cards) -->
        <div class="account-stats-row">
            <div class="account-stat-card stat-accent-cyan">
                <div class="stat-icon-wrap icon-cyan">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-number">@Model.TotalDownloads</div>
                    <div class="stat-title">Total Downloads</div>
                    <div class="stat-subtext">All-time jobs processed</div>
                </div>
            </div>

            <div class="account-stat-card stat-accent-emerald">
                <div class="stat-icon-wrap icon-emerald">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-number">@Model.CompletedDownloads</div>
                    <div class="stat-title">Completed Media</div>
                    <div class="stat-subtext">High-res streams saved</div>
                </div>
            </div>

            <div class="account-stat-card stat-accent-purple">
                <div class="stat-icon-wrap icon-purple">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-number">@Model.FormattedTotalSize</div>
                    <div class="stat-title">Bandwidth Streamed</div>
                    <div class="stat-subtext">Multi-threaded transfer</div>
                </div>
            </div>

            <div class="account-stat-card stat-accent-amber">
                <div class="stat-icon-wrap icon-amber">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                </div>
                <div class="stat-body">
                    <div class="stat-number">@(isVip ? "VIP PRO" : "Standard")</div>
                    <div class="stat-title">Active Membership</div>
                    <div class="stat-subtext">@(isVip ? "256 Parallel Threads Active" : "Up to 32 Parallel Threads")</div>
                </div>
            </div>
        </div>

        <!-- 2-Column Content Grid -->
        <div class="account-grid-2col">
            <!-- Left Column: Edit Profile Form -->
            <div class="account-card">
                <div class="account-card-header">
                    <div>
                        <h2 class="account-card-title">
                            Profile Information
                        </h2>
                        <div class="account-card-subtitle">Manage your public identity and profile credentials</div>
                    </div>
                </div>

                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-floating-dark">
                        <label for="fullName">
                            <span>Full Display Name</span>
                            <span class="input-hint">Publicly displayed in SaveZonix</span>
                        </label>
                        <div class="input-icon-wrap">
                            <span class="input-icon-prefix">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </span>
                            <input type="text" id="fullName" name="fullName" value="@Model.FullName" class="form-control-dark" placeholder="Your full name" required />
                        </div>
                    </div>

                    <div class="form-floating-dark">
                        <label>
                            <span>Email Address</span>
                            <span class="input-hint">Primary cloud identifier</span>
                        </label>
                        <div class="input-icon-wrap">
                            <span class="input-icon-prefix">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </span>
                            <input type="email" value="@Model.Email" class="form-control-dark" disabled />
                        </div>
                        <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 2px;">
                            Email cannot be changed directly for security and database synchronization purposes.
                        </span>
                    </div>

                    <div class="form-floating-dark">
                        <label>
                            <span>Membership Tier &amp; Access Level</span>
                        </label>
                        <div class="input-icon-wrap">
                            <span class="input-icon-prefix">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            </span>
                            <input type="text" value="@membershipLabel" class="form-control-dark" disabled />
                        </div>
                    </div>

                    <div style="margin-top: 28px; display: flex; gap: 12px;">
                        <button type="submit" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            <span>Save Profile Changes</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Right Column: Quick Studio Launchpad & System Telemetry -->
            <div>
                <!-- Studio Quick Access Card -->
                <div class="account-card">
                    <div class="account-card-header">
                        <div>
                            <h2 class="account-card-title">
                                Studio Launchpad
                            </h2>
                            <div class="account-card-subtitle">Fast shortcuts to SaveZonix workspaces</div>
                        </div>
                    </div>

                    <div class="studio-quick-cards">
                        <a href="/playlist" class="studio-quick-item">
                            <div class="studio-quick-left">
                                <div class="studio-quick-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                </div>
                                <div>
                                    <div class="studio-quick-name">Playlist Studio</div>
                                    <div class="studio-quick-meta">Batch download YouTube albums &amp; playlists</div>
                                </div>
                            </div>
                            <div class="studio-quick-arrow">➔</div>
                        </a>

                        <a href="/cinema" class="studio-quick-item">
                            <div class="studio-quick-left">
                                <div class="studio-quick-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
                                </div>
                                <div>
                                    <div class="studio-quick-name">Cinema Studio</div>
                                    <div class="studio-quick-meta">Instant high-res media streaming &amp; playback</div>
                                </div>
                            </div>
                            <div class="studio-quick-arrow">➔</div>
                        </a>

                        <a asp-action="Downloads" class="studio-quick-item">
                            <div class="studio-quick-left">
                                <div class="studio-quick-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                </div>
                                <div>
                                    <div class="studio-quick-name">Download Manager</div>
                                    <div class="studio-quick-meta">Live downloads, speeds &amp; history records</div>
                                </div>
                            </div>
                            <div class="studio-quick-arrow">➔</div>
                        </a>
                    </div>
                </div>

                <!-- Account Security Overview Card -->
                <div class="account-card">
                    <div class="account-card-header">
                        <div>
                            <h2 class="account-card-title">
                                Security &amp; Device
                            </h2>
                            <div class="account-card-subtitle">Account security and current session</div>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <span style="color: var(--text-muted);">Password Protection</span>
                            <span style="color: #34d399; font-weight: 600;">Active &amp; Encrypted</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <span style="color: var(--text-muted);">Session Status</span>
                            <span style="color: #38bdf8; font-weight: 600;">● Active (Current Browser)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.06);">
                            <span style="color: var(--text-muted);">Last Sign In</span>
                            <span style="color: #f1f5f9; font-weight: 500;">
                                @(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("MMM dd, yyyy") : "Today")
                            </span>
                        </div>
                    </div>

                    <div style="margin-top: 18px;">
                        <a asp-action="Settings" class="btn btn-secondary" style="width: 100%; justify-content: center;">
                            <span>⚙️ Manage Security &amp; Password</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
