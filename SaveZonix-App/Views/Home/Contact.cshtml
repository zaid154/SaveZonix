@{
    ViewData["Title"] = "Contact & Technical Support";
    ViewData["ActiveNav"] = "Contact";
}

<!-- Contact Hero -->
<section class="hero">
    <div class="container">
        <div class="hero-tag">
            <span class="badge-tag badge-green">Support &amp; Communication</span>
        </div>
        <h1 class="hero-title">
            Get in Touch with <span class="gradient">Our Team</span>
        </h1>
        <p class="hero-desc">
            Have questions about performance tuning, encountered a bug, or need help with a custom streaming workflow? Reach out and we'll respond promptly.
        </p>
    </div>
</section>

<!-- Contact Grid -->
<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="contact-grid">
            <!-- Contact Info -->
            <div class="contact-info-card">
                <h3 style="font-size: 1.3rem; color: #fff;">Direct Communication</h3>
                <p style="color: var(--text-secondary); font-size: 0.95rem;">
                    For bug reports, pull requests, or architecture inquiries, choose the communication channel that best suits your needs.
                </p>

                <div class="contact-method">
                    <div class="contact-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </div>
                    <div>
                        <h4>Official Support &amp; Legal</h4>
                        <p><a href="mailto:savezonix@gmail.com" style="color: #38bdf8; text-decoration: none;">savezonix@gmail.com</a></p>
                        <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">Avg. response: Under 12 hours</p>
                    </div>
                </div>

                <div class="contact-method">
                    <div class="contact-icon" style="background: rgba(16, 185, 129, 0.12); color: #34d399; border-color: rgba(16, 185, 129, 0.25);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                    </div>
                    <div>
                        <h4>GitHub Repository</h4>
                        <p><a href="https://github.com/zaid154/SaveZonix" target="_blank" style="color: #60a5fa; text-decoration: none;">github.com/zaid154/SaveZonix</a></p>
                        <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">Open issues &amp; contributions welcome</p>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="contact-form-card">
                <h3 style="font-size: 1.3rem; color: #fff; margin-bottom: 20px;">Send a Message</h3>

                <form id="contactForm" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent to our developer team.'); this.reset();">
                    <div class="form-control" style="margin-bottom: 16px;">
                        <label for="contactName">Full Name</label>
                        <input type="text" id="contactName" class="text-input" placeholder="Rahul Sharma" required>
                    </div>

                    <div class="form-control" style="margin-bottom: 16px;">
                        <label for="contactEmail">Email Address</label>
                        <input type="email" id="contactEmail" class="text-input" placeholder="rahul.sharma@gmail.com" required>
                    </div>

                    <div class="form-control" style="margin-bottom: 16px;">
                        <label for="contactSubject">Subject / Issue Category</label>
                        <select id="contactSubject" class="select-input" required>
                            <option value="">Select a category</option>
                            <option value="bug">Bug Report / Stream Failed</option>
                            <option value="feature">Feature Request</option>
                            <option value="general">General Inquiry</option>
                            <option value="legal">DMCA / Legal Notice</option>
                        </select>
                    </div>

                    <div class="form-control" style="margin-bottom: 24px;">
                        <label for="contactMsg">Message / Stream Details</label>
                        <textarea id="contactMsg" class="text-input" rows="4" placeholder="Describe the stream URL or issue you encountered..." style="resize: vertical;" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
