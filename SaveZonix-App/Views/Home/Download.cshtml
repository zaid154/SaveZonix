@{
    ViewData["Title"] = "Download Hub — Extension & Server";
    ViewData["ActiveNav"] = "Download";
    var appDownloadUrl = ViewData["AppDownloadUrl"]?.ToString() ?? "https://github.com/zaid154/SaveZonix/releases";
    var latestVersion = ViewData["LatestAppVersion"]?.ToString() ?? "2.5.2";
}

<!-- Download Hero -->
<section class="hero">
    <div class="container">
        <div class="hero-tag">
            <span class="badge-tag badge-green">Official Releases &bull; Verified Safe</span>
        </div>
        <h1 class="hero-title">
            Choose Your <span class="gradient">SaveZonix Platform</span>
        </h1>
        <p class="hero-desc">
            Get the lightweight browser extension for one-click streaming downloads, or deploy the full ASP.NET Core turbo server for multi-device network downloading.
        </p>
    </div>
</section>

<!-- Download Cards Grid -->
<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="download-grid">
            <!-- Option 1: Chrome Extension -->
            <div class="download-card highlighted">
                <div class="download-card-header">
                    <div class="download-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="21.17" y1="8" x2="12" y2="8"></line><line x1="3.95" y1="6.06" x2="8.54" y2="14"></line><line x1="10.88" y1="21.94" x2="15.46" y2="14"></line></svg>
                    </div>
                    <div>
                        <h3 class="download-card-title">Browser Extension</h3>
                        <span class="download-card-version">Latest: v5.5.0 (Manifest V3)</span>
                    </div>
                </div>

                <p class="feature-text">
                    Installs directly into Google Chrome, Brave, Edge, and Opera. Detects videos automatically on any active tab with live thumbnail and duration previews.
                </p>

                <ul class="download-feature-list">
                    <li><span class="check">✓</span> 1-Click download popup on active video tab</li>
                    <li><span class="check">✓</span> Parallel multi-threading acceleration</li>
                    <li><span class="check">✓</span> Smart CDN Anti-Hotlink negotiation built-in</li>
                    <li><span class="check">✓</span> Clean single-video badge with zero clutter</li>
                </ul>

                <div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px;">
                    <div style="display: flex; gap: 8px;">
                        <button id="btn1ClickInstall" class="btn btn-accent btn-lg" style="flex: 1; text-align: center; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                            <span>Open Extension Folder</span>
                        </button>
                        <a href="/api/extension/download-zip" class="btn btn-secondary btn-lg" style="text-align: center; display: flex; align-items: center; justify-content: center; gap: 6px; padding: 0 16px; text-decoration: none;" title="Download Extension as ZIP archive">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                            <span>ZIP</span>
                        </a>
                    </div>
                    <div id="installFeedback" style="display: none; margin-top: 6px;"></div>
                    <p style="font-size: 0.8rem; color: var(--text-muted); text-align: center; margin: 0;">One-time 20-second setup &bull; Permanent activation</p>
                </div>
            </div>

            <!-- Option 2: .NET Turbo Server -->
            <div class="download-card">
                <div class="download-card-header">
                    <div class="download-icon" style="background: rgba(139, 92, 246, 0.12); color: #a78bfa; border-color: rgba(139, 92, 246, 0.25);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                    </div>
                    <div>
                        <h3 class="download-card-title">SaveZonix Desktop Engine</h3>
                        <span class="download-card-version" style="color: #a78bfa;">v@(latestVersion) Standalone</span>
                    </div>
                </div>

                <p class="feature-text">
                    High-performance multi-threaded video stream engine, 256-concurrency downloader, Cinema Player, and local background service.
                </p>

                <ul class="download-feature-list">
                    <li><span class="check">✓</span> Universal URL analyze &amp; quality picker</li>
                    <li><span class="check">✓</span> 256 parallel worker high-concurrency acceleration</li>
                    <li><span class="check">✓</span> Silent zero-click auto-updater built-in</li>
                    <li><span class="check">✓</span> Offline standalone installer with Desktop icon</li>
                </ul>

                <div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px;">
                    <a href="@appDownloadUrl" target="_blank" class="btn btn-primary btn-lg" style="text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Download Windows Installer (.exe)</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary" style="text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981;"></span>
                        <span>Engine Active &bull; Open Web Console</span>
                    </a>
                    <a href="https://savezonix-pro.vercel.app" target="_blank" style="font-size: 0.82rem; color: #60a5fa; text-align: center; text-decoration: none;">Visit Cloud Portal (savezonix-pro.vercel.app) &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Installation Guide -->
        <div class="downloader-card" style="max-width: 920px; margin: 40px auto 0; padding: 24px; border-radius: 12px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0;">How to Add Extension to Chrome / Edge / Brave</h3>
                <span style="font-size: 0.8rem; background: rgba(14, 165, 233, 0.15); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.3); padding: 4px 10px; border-radius: 20px;">20-Second Quick Setup</span>
            </div>
            
            <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 16px;">
                Chrome security requires local extensions to be loaded once via Developer Mode. Follow these 3 simple steps:
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
                <div style="background: rgba(255, 255, 255, 0.03); padding: 18px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <span style="background: var(--primary); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;">1</span>
                        <strong style="color: #fff; font-size: 0.95rem;">Click "Open Folder" Above</strong>
                    </div>
                    <span style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; display: block;">
                        It opens the SaveZonix <code>Extension</code> directory in your computer and automatically copies the folder path to your clipboard.
                    </span>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 18px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <span style="background: var(--primary); color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;">2</span>
                        <strong style="color: #fff; font-size: 0.95rem;">Open Extensions Page</strong>
                    </div>
                    <span style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; display: block;">
                        In Chrome or Edge, go to <code style="color: #38bdf8;">chrome://extensions</code> (or <code style="color: #38bdf8;">edge://extensions</code>) and turn <strong>ON</strong> the <strong>Developer mode</strong> toggle at top-right.
                    </span>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 18px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.06);">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <span style="background: #10b981; color: #fff; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;">3</span>
                        <strong style="color: #fff; font-size: 0.95rem;">Click "Load unpacked"</strong>
                    </div>
                    <span style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; display: block;">
                        Click <strong>"Load unpacked"</strong> button in top-left, paste the copied path into the file dialog, and click <strong>Select Folder</strong>. Done!
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('btn1ClickInstall');
    const feedback = document.getElementById('installFeedback');
    if (!btn) return;

    btn.addEventListener('click', async () => {
        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>⏳ Opening folder...</span>';
        
        try {
            const res = await fetch('/api/extension/open-folder', { method: 'POST' });
            const data = await res.json();
            if (data && data.success) {
                // Copy path to clipboard
                if (data.path && navigator.clipboard) {
                    try {
                        await navigator.clipboard.writeText(data.path);
                    } catch (e) {}
                }

                feedback.style.display = 'block';
                feedback.innerHTML = `
                    <div style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 10px; padding: 14px; text-align: left; box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                            <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 700; color: #38bdf8;">
                                <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
                                Folder Opened in Explorer
                            </span>
                            <span id="copiedStatusBadge" style="font-size: 0.75rem; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 2px 8px; border-radius: 12px; font-weight: 600;">✓ Copied</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; padding: 6px 10px; margin-bottom: 8px;">
                            <code style="flex: 1; font-family: monospace; font-size: 0.78rem; color: #e2e8f0; overflow-x: auto; white-space: nowrap; padding: 2px 0;">${data.path}</code>
                            <button type="button" id="btnCopyAgain" style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; border-radius: 4px; padding: 4px 10px; font-size: 0.75rem; cursor: pointer; font-weight: 600; white-space: nowrap;">Copy</button>
                        </div>
                        <div style="font-size: 0.8rem; color: #94a3b8; line-height: 1.4;">
                            Now open <strong style="color: #fff;">chrome://extensions</strong> &bull; Toggle <strong style="color: #fff;">Developer mode</strong> &bull; Click <strong style="color: #fff;">Load unpacked</strong>
                        </div>
                    </div>
                `;

                const btnCopyAgain = document.getElementById('btnCopyAgain');
                if (btnCopyAgain) {
                    btnCopyAgain.addEventListener('click', async () => {
                        try {
                            await navigator.clipboard.writeText(data.path);
                            btnCopyAgain.textContent = 'Copied!';
                            btnCopyAgain.style.color = '#34d399';
                            btnCopyAgain.style.borderColor = '#10b981';
                            setTimeout(() => {
                                btnCopyAgain.textContent = 'Copy';
                                btnCopyAgain.style.color = '#38bdf8';
                                btnCopyAgain.style.borderColor = 'rgba(56, 189, 248, 0.3)';
                            }, 2000);
                        } catch (e) {}
                    });
                }
            } else {
                throw new Error(data.message || 'Failed to open extension folder');
            }
        } catch (err) {
            feedback.style.display = 'block';
            feedback.innerHTML = `
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 12px; color: #f87171; font-size: 0.85rem;">
                    <strong>Notice:</strong> ${err.message}
                </div>
            `;
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });
});
</script>
</section>
