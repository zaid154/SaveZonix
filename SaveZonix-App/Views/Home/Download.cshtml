@{
    ViewData["Title"] = "Download Hub — Extension & Server";
    ViewData["ActiveNav"] = "Download";
}

<!-- Download Hero -->
<section class="hero">
    <div class="container">
        <div class="hero-tag">
            <span class="badge-tag badge-green">Official Releases &bull; Verified Safe</span>
        </div>
        <h1 class="hero-title">
            Choose Your <span class="gradient">Stream Helper Platform</span>
        </h1>
        <p class="hero-desc">
            Get the lightweight browser extension for one-click streaming downloads, or deploy the full ASP.NET Core turbo server for multi-device network downloading.
        </p>
    </div>
</section>

<!-- Download Cards Grid -->
<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="download-grid">
            <!-- Option 1: Chrome Extension -->
            <div class="download-card highlighted">
                <div class="download-card-header">
                    <div class="download-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle><line x1="21.17" y1="8" x2="12" y2="8"></line><line x1="3.95" y1="6.06" x2="8.54" y2="14"></line><line x1="10.88" y1="21.94" x2="15.46" y2="14"></line></svg>
                    </div>
                    <div>
                        <h3 class="download-card-title">Browser Extension</h3>
                        <span class="download-card-version">Latest: v5.5.0 (Manifest V3)</span>
                    </div>
                </div>

                <p class="feature-text">
                    Installs directly into Google Chrome, Brave, Edge, and Opera. Detects videos automatically on any active tab with live thumbnail and duration previews.
                </p>

                <ul class="download-feature-list">
                    <li><span class="check">✓</span> 1-Click download popup on active video tab</li>
                    <li><span class="check">✓</span> Parallel multi-threading acceleration</li>
                    <li><span class="check">✓</span> Smart CDN Anti-Hotlink negotiation built-in</li>
                    <li><span class="check">✓</span> Clean single-video badge with zero clutter</li>
                </ul>

                <div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px;">
                    <button id="btn1ClickInstall" class="btn btn-accent btn-lg" style="text-align: center; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        <span>1-Click Add to Chrome / Edge</span>
                    </button>
                    <div id="installFeedback" style="display: none; font-size: 0.85rem; padding: 8px 12px; border-radius: 8px; text-align: center;"></div>
                    <p style="font-size: 0.8rem; color: var(--text-muted); text-align: center;">Instant load &bull; No Developer Mode required</p>
                </div>
            </div>

            <!-- Option 2: .NET Turbo Server -->
            <div class="download-card">
                <div class="download-card-header">
                    <div class="download-icon" style="background: rgba(139, 92, 246, 0.12); color: #a78bfa; border-color: rgba(139, 92, 246, 0.25);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                    </div>
                    <div>
                        <h3 class="download-card-title">SaveZonix Desktop Engine</h3>
                        <span class="download-card-version" style="color: #a78bfa;">v2.5.0 Standalone</span>
                    </div>
                </div>

                <p class="feature-text">
                    High-performance multi-threaded video stream engine, 256-concurrency downloader, Cinema Player, and local background service.
                </p>

                <ul class="download-feature-list">
                    <li><span class="check">✓</span> Universal URL analyze &amp; quality picker</li>
                    <li><span class="check">✓</span> 256 parallel worker high-concurrency acceleration</li>
                    <li><span class="check">✓</span> Silent zero-click auto-updater built-in</li>
                    <li><span class="check">✓</span> Offline standalone installer with Desktop icon</li>
                </ul>

                <div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px;">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg" style="text-align: center;">
                        Open Web Downloader
                    </a>
                    <a href="https://save-zonix.vercel.app" target="_blank" style="font-size: 0.85rem; color: #60a5fa; text-align: center; text-decoration: none;">Visit Cloud Portal (save-zonix.vercel.app) &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Installation Guide -->
        <div class="downloader-card" style="max-width: 920px; margin: 40px auto 0; padding: 24px; border-radius: 12px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0;">⚡ Seamless Extension Activation</h3>
                <span style="font-size: 0.8rem; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 10px; border-radius: 20px;">Zero-Click Ready</span>
            </div>
            
            <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 16px;">
                SaveZonix features a built-in browser extension loader. Clicking the button above launches your browser with the SaveZonix extension automatically loaded and activated.
            </p>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <strong style="color: #fff; display: block; margin-bottom: 4px;">1. Click "Add to Browser"</strong>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">SaveZonix desktop automatically connects with Chrome or Edge.</span>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <strong style="color: #fff; display: block; margin-bottom: 4px;">2. Play Any Video</strong>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Floating download badge appears directly on video streams.</span>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <strong style="color: #fff; display: block; margin-bottom: 4px;">3. Auto-Updated Silently</strong>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Continuous updates synced via save-zonix.vercel.app cloud.</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('btn1ClickInstall');
    const feedback = document.getElementById('installFeedback');
    if (!btn) return;

    btn.addEventListener('click', async () => {
        btn.disabled = true;
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span>⚡ Loading Extension into Browser...</span>';
        
        try {
            const res = await fetch('/api/extension/install-browser', { method: 'POST' });
            const data = await res.json();
            if (data && data.success) {
                feedback.style.display = 'block';
                feedback.style.background = 'rgba(16, 185, 129, 0.15)';
                feedback.style.color = '#34d399';
                feedback.style.border = '1px solid rgba(16, 185, 129, 0.3)';
                feedback.innerHTML = '<strong>✓ Success!</strong> ' + (data.message || 'Extension loaded into your browser.');
            } else {
                throw new Error(data.message || 'Failed to install');
            }
        } catch (err) {
            feedback.style.display = 'block';
            feedback.style.background = 'rgba(239, 68, 68, 0.15)';
            feedback.style.color = '#f87171';
            feedback.style.border = '1px solid rgba(239, 68, 68, 0.3)';
            feedback.innerHTML = '<strong>Notice:</strong> ' + err.message;
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });
});
</script>
</section>
