@{
    ViewData["Title"] = "Media Stream Downloader";
    ViewData["ActiveNav"] = "Home";
}

<!-- Main Utility Dashboard -->
<section class="hero" style="padding: 18px 0 20px;">
    <div class="container">
        <div class="hero-header-compact" style="text-align: center; margin-bottom: 16px;">
            <h1 style="font-size: 22px; font-weight: 700; color: #f8fafc; letter-spacing: -0.2px; margin: 0 0 4px 0;">
                Media Stream Downloader
            </h1>
            <p style="font-size: 13px; color: #94a3b8; margin: 0;">
                High-performance parallel stream extraction and conversion dashboard
            </p>
        </div>

        <!-- Utility Quick Tools Bar -->
        <div class="quick-tools-bar" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
            <button type="button" id="btnOpenBulkModal" class="btn-quick-tool" style="display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; font-size: 12px; color: #cbd5e1; font-weight: 500; cursor: pointer; transition: all 0.2s ease;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                <span>Batch Download</span>
            </button>
            <button type="button" id="btnOpenMobileConnect" class="btn-quick-tool" style="display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; font-size: 12px; color: #cbd5e1; font-weight: 500; cursor: pointer; transition: all 0.2s ease;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                <span>Mobile Connect</span>
            </button>
            <button type="button" id="btnOpenCookieModal" class="btn-quick-tool" style="display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; font-size: 12px; color: #cbd5e1; font-weight: 500; cursor: pointer; transition: all 0.2s ease;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="10" r="1.5"></circle><circle cx="8" cy="14" r="1.5"></circle><circle cx="15" cy="15" r="1.5"></circle></svg>
                <span>Cookie Vault</span>
            </button>
        </div>

        <!-- Core Downloader Card -->
        <div class="downloader-wrapper">
            <div class="downloader-card">
                <div class="card-heading">
                    <div class="heading-left">
                        <h2 class="card-title">Stream URL / Playlist</h2>
                    </div>
                    <div class="heading-right" style="display: flex; align-items: center; gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: #cbd5e1; cursor: pointer; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.2); padding: 3px 8px; border-radius: 6px;">
                            <input type="checkbox" id="chkSmartMode" style="accent-color: #38bdf8;">
                            <span>Smart Mode (Auto-Download)</span>
                        </label>
                        <span class="badge badge-strategy" id="strategyBadge">Auto-Detect</span>
                        <span class="badge badge-threads" id="topThreadsBadge" style="display:none;">256x Engine</span>
                    </div>
                </div>

                <!-- Input Form -->
                <div class="input-group">
                    <div class="input-wrapper">
                        <input type="url" id="streamUrl" placeholder="Enter video, audio, or playlist URL (YouTube, Vimeo, Twitch, HLS, DASH, direct MP4)..." autocomplete="off" spellcheck="false">
                        <button id="btnPaste" class="btn btn-secondary btn-icon-text" type="button" title="Paste from clipboard">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                            <span>Paste</span>
                        </button>
                        <button id="btnAnalyze" class="btn btn-primary btn-icon-text" type="button">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <span class="btn-text">Analyze</span>
                            <div class="spinner hidden" id="analyzeSpinner"></div>
                        </button>
                    </div>

                    <!-- Clipboard Auto-Detected Link Chip -->
                    <div id="clipboardDetectedChip" style="display: none; align-items: center; justify-content: space-between; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 6px; padding: 6px 12px; margin-top: 8px; font-size: 12px; color: #38bdf8;">
                        <div style="display: flex; align-items: center; gap: 8px; overflow: hidden;">
                            <span style="font-weight: 600;">Clipboard Link:</span>
                            <span id="clipboardDetectedUrl" style="color: #cbd5e1; font-family: monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 380px;"></span>
                        </div>
                        <button type="button" id="btnUseClipboardLink" style="padding: 3px 10px; background: #0284c7; border: none; border-radius: 4px; color: #fff; font-weight: 600; font-size: 11px; cursor: pointer; white-space: nowrap;">Paste &amp; Analyze</button>
                    </div>

                    <div class="input-helper-tip">
                        <span>Direct stream extraction, HLS (.m3u8), MPEG-DASH (.mpd), and single or playlist video URLs.</span>
                    </div>
                </div>

                <!-- Error Alert -->
                <div id="errorBox" class="alert error hidden">
                    <span class="alert-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    </span>
                    <span id="errorMessage">Error analyzing stream URL</span>
                </div>

                <!-- Stream Details (Populated on Analyze) -->
                <div id="streamDetails" class="stream-details hidden">
                    <div class="divider"></div>
                    
                    <!-- Stream Preview Card -->
                    <div class="video-preview-card" style="display: flex; gap: 16px; align-items: center; background: #161b22; border: 1px solid #30363d; border-radius: 10px; padding: 14px; margin-bottom: 18px;">
                        <div class="video-thumb" id="videoThumbWrapper" style="position: relative; width: 130px; height: 78px; border-radius: 6px; overflow: hidden; background: #0d1117; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid #30363d;">
                            <img id="videoThumbImg" src="" alt="Thumbnail" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover; display: none;">
                            <div class="thumb-fallback" id="thumbFallback" style="color: #58a6ff; display: flex; align-items: center; justify-content: center;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
                            </div>
                            <span class="thumb-duration-badge" id="thumbDuration" style="position: absolute; bottom: 4px; right: 4px; background: rgba(0,0,0,0.8); color: #fff; font-size: 10px; font-weight: 600; padding: 1px 5px; border-radius: 3px;">00:00</span>
                        </div>

                        <div class="video-meta" style="flex: 1; min-width: 0;">
                            <div class="meta-badges" style="display: flex; gap: 6px; margin-bottom: 6px; flex-wrap: wrap;">
                                <span class="badge badge-platform" id="badgePlatform" style="background: #21262d; color: #58a6ff; font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;">Web Stream</span>
                                <span class="badge badge-duration" id="badgeDuration" style="background: #21262d; color: #8b949e; font-size: 11px; padding: 2px 7px; border-radius: 4px;">--:--</span>
                                <span class="badge badge-size" id="badgeEstSize" style="background: #238636; color: #fff; font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;">0 MB</span>
                            </div>
                            <h3 class="video-title" id="videoTitleDisplay" style="font-size: 14px; font-weight: 600; color: #f0f6fc; margin: 0 0 4px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Stream Title</h3>
                            <p class="video-desc" id="videoDescDisplay" style="font-size: 12px; color: #8b949e; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: none;"></p>
                        </div>
                    </div>

                    <!-- Format Switcher (Video MP4 vs Audio MP3) -->
                    <div class="format-switcher" style="display: flex; gap: 10px; margin-bottom: 16px;">
                        <button type="button" id="tabModeVideo" class="btn-format-tab active" onclick="switchFormatMode('video')" style="flex: 1; padding: 10px; border-radius: 6px; border: 1.5px solid #38bdf8; background: #1e293b; color: #38bdf8; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
                            <span>Video (MP4)</span>
                        </button>
                        <button type="button" id="tabModeAudio" class="btn-format-tab" onclick="switchFormatMode('audio')" style="flex: 1; padding: 10px; border-radius: 6px; border: 1.5px solid #30363d; background: #0f172a; color: #94a3b8; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                            <span>Audio (MP3)</span>
                        </button>
                    </div>

                    <!-- Configuration Grid -->
                    <div class="config-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
                        <div class="form-control">
                            <label for="qualitySelect" id="lblQualitySelect" style="font-size: 12px; font-weight: 600; color: #94a3b8; margin-bottom: 4px; display: block;">Stream Quality</label>
                            <select id="qualitySelect" class="select-input" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 8px 10px; border-radius: 6px; font-size: 12.5px;">
                                <option value="">Detecting available streams...</option>
                            </select>
                        </div>

                        <div class="form-control">
                            <label for="fileNameInput" style="font-size: 12px; font-weight: 600; color: #94a3b8; margin-bottom: 4px; display: block;">File Name</label>
                            <input type="text" id="fileNameInput" class="text-input" placeholder="video_name.mp4" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 8px 10px; border-radius: 6px; font-size: 12.5px;">
                        </div>
                    </div>

                    <!-- Advanced Parameters Accordion -->
                    <details class="advanced-options-accordion">
                        <summary class="advanced-summary">
                            <span class="advanced-summary-text">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                <span>Advanced Stream &amp; Concurrency Parameters</span>
                            </span>
                            <span class="advanced-arrow">▾</span>
                        </summary>
                        <div class="advanced-body">
                            <div class="concurrency-control-box" style="background: transparent; border: none; padding: 0; margin-bottom: 12px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                    <label style="font-size: 12px; font-weight: 600; color: #cbd5e1; margin: 0;">Parallel Concurrency Threads</label>
                                    <span id="threadsValue" style="font-size: 12px; font-weight: 600; color: #38bdf8; font-family: monospace; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2); padding: 2px 8px; border-radius: 4px;">64 Workers</span>
                                </div>
                                <div class="thread-presets" style="display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap;">
                                    <button type="button" class="btn-thread-preset" data-threads="16">16x</button>
                                    <button type="button" class="btn-thread-preset" data-threads="32">32x</button>
                                    <button type="button" class="btn-thread-preset active" data-threads="64">64x</button>
                                    <button type="button" class="btn-thread-preset" data-threads="128">128x</button>
                                    <button type="button" class="btn-thread-preset" data-threads="256">256x</button>
                                </div>
                                <input type="range" id="threadsRange" min="16" max="256" step="16" value="64" style="width: 100%; accent-color: #38bdf8; cursor: pointer;">
                            </div>

                            <div class="power-features-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; padding: 10px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(51, 65, 85, 0.6); border-radius: 6px;">
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #cbd5e1; cursor: pointer;">
                                    <input type="checkbox" id="chkSponsorBlock" checked style="accent-color: #38bdf8; width: 14px; height: 14px;">
                                    <span>Auto-skip sponsors (SponsorBlock)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #cbd5e1; cursor: pointer;">
                                    <input type="checkbox" id="chkSubtitles" style="accent-color: #38bdf8; width: 14px; height: 14px;">
                                    <span>Download subtitles (.srt)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #cbd5e1; cursor: pointer;">
                                    <input type="checkbox" id="chkTrimSnippet" style="accent-color: #38bdf8; width: 14px; height: 14px;">
                                    <span>Trim stream snippet</span>
                                </label>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 11.5px; color: #94a3b8;">Throttle:</span>
                                    <select id="selSpeedThrottle" style="flex: 1; background: #0f172a; border: 1px solid #334155; color: #cbd5e1; font-size: 11px; padding: 3px 6px; border-radius: 4px;">
                                        <option value="0">Unlimited</option>
                                        <option value="50">50 MB/s</option>
                                        <option value="20">20 MB/s</option>
                                        <option value="10">10 MB/s</option>
                                        <option value="5">5 MB/s</option>
                                    </select>
                                </div>
                            </div>

                            <div id="trimInputsRow" style="display: none; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; padding: 10px 12px; background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 6px;">
                                <div>
                                    <label style="font-size: 11px; color: #94a3b8; display: block; margin-bottom: 3px;">Start Time (hh:mm:ss)</label>
                                    <input type="text" id="trimStartTime" placeholder="00:00:00" value="00:00:00" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #fff; font-size: 12px; padding: 4px 8px; border-radius: 4px; font-family: monospace;">
                                </div>
                                <div>
                                    <label style="font-size: 11px; color: #94a3b8; display: block; margin-bottom: 3px;">End Time (hh:mm:ss)</label>
                                    <input type="text" id="trimEndTime" placeholder="00:05:00" value="00:00:00" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #fff; font-size: 12px; padding: 4px 8px; border-radius: 4px; font-family: monospace;">
                                </div>
                            </div>

                            <div class="dest-location-row" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                                <div class="dest-info" style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #94a3b8;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                    <span>Folder:</span>
                                    <span class="dest-path" id="destPathDisplay" style="color: #cbd5e1; font-family: monospace;">Downloads\SaveZonix</span>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" id="btnBrowseFolder" style="padding: 3px 8px; font-size: 11px;">Open Folder</button>
                            </div>
                        </div>
                    </details>

                    <!-- Main Action Download Button -->
                    <button id="btnStartDownload" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 14px; font-weight: 600; border-radius: 8px; display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span id="btnDownloadText">Download Stream (MP4)</span>
                    </button>
                </div>

                <!-- Technical Progress Section -->
                <div id="progressSection" class="progress-section hidden">
                    <!-- Active Download Status Bar & Controls -->
                    <div class="active-download-banner">
                        <div class="active-thumb-wrap">
                            <img id="activeThumbImg" src="" alt="" style="display: none;">
                            <div class="active-thumb-fallback" id="activeThumbFallback">▶</div>
                        </div>
                        <div class="active-info">
                            <h4 class="active-title" id="activeTitleDisplay" title="Downloading Stream...">Downloading Stream...</h4>
                            <div class="active-badges">
                                <span class="badge badge-platform" id="activePlatformBadge">Web Stream</span>
                                <span class="badge badge-threads" id="activeThreadsBadge">64 Active Workers</span>
                                <span class="badge badge-size" id="activeQualityBadge">1080p FHD</span>
                                <span class="badge badge-strategy" id="activeStrategyBadge">Multi-Segment</span>
                            </div>
                        </div>
                        
                        <!-- Direct Action Controls: Pause, Cancel, Open Folder, Copy Path -->
                        <div class="download-action-controls" style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                            <button type="button" class="btn btn-secondary btn-icon-text btn-action-pause" id="btnPauseResume" title="Pause or Resume Download">
                                <svg id="pauseResumeIcon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>
                                <span id="pauseResumeText">Pause</span>
                            </button>
                            <button type="button" class="btn btn-danger-subtle btn-icon-text btn-action-cancel" id="btnCancelDownload" title="Cancel Download">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                <span>Cancel</span>
                            </button>
                            <button type="button" class="btn btn-secondary btn-icon-text" id="btnDirectOpenFolder" onclick="fetch('/api/open-folder', {method:'POST'}).catch(()=>{})" title="Open Destination Folder">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                <span>Open Folder</span>
                            </button>
                            <button type="button" class="btn btn-secondary btn-icon-text" id="btnDirectCopyPath" onclick="const p = document.getElementById('destPathDisplay')?.textContent || 'Downloads\\SaveZonix'; navigator.clipboard.writeText(p); const s = this.querySelector('span'); const orig = s.textContent; s.textContent='✓ Copied'; setTimeout(() => s.textContent=orig, 1800);" title="Copy Destination Path">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="4" rx="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path></svg>
                                <span>Copy Path</span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="progress-header">
                        <div class="status-indicator-group">
                            <span class="status-dot pulsing"></span>
                            <span class="status-badge" id="statusBadge">Downloading in Parallel...</span>
                        </div>
                        <span class="percentage-text" id="percentText">0%</span>
                    </div>

                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
                    </div>

                    <!-- Real-Time Throughput Graph -->
                    <div class="throughput-container">
                        <div class="throughput-header">
