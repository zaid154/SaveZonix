@{
    ViewData["Title"] = "Ultra High-Speed Video Stream Downloader";
    ViewData["ActiveNav"] = "Home";
}

<!-- Hero Section -->
<section class="hero" style="padding: 20px 0 24px;">
    <div class="container">
        <div class="hero-header-compact" style="text-align: center; margin-bottom: 20px;">
            <h1 style="font-size: 24px; font-weight: 800; color: #f8fafc; letter-spacing: -0.3px; margin: 0 0 6px 0;">
                Zonix Turbo <span style="background: linear-gradient(135deg, #38bdf8, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Downloader</span>
            </h1>
            <p style="font-size: 13px; color: #94a3b8; margin: 0;">
                Ultra high-speed parallel video, music, and playlist downloads
            </p>
        </div>

        <!-- Super-Engine Immunity & Power Status Bar -->
        <div class="engine-status-bar" style="display: flex; justify-content: center; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;">
            <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 20px; font-size: 11.5px; color: #10b981; font-weight: 600;">
                <span style="width: 7px; height: 7px; background: #10b981; border-radius: 50%; box-shadow: 0 0 6px #10b981;"></span>
                CrashGuard Shield Active
            </div>
            <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 20px; font-size: 11.5px; color: #38bdf8; font-weight: 600;">
                <span style="width: 7px; height: 7px; background: #38bdf8; border-radius: 50%; box-shadow: 0 0 6px #38bdf8;"></span>
                Turbo ArrayPool (Zero-GC)
            </div>
            <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.25); border-radius: 20px; font-size: 11.5px; color: #c084fc; font-weight: 600;">
                <span style="width: 7px; height: 7px; background: #c084fc; border-radius: 50%; box-shadow: 0 0 6px #c084fc;"></span>
                Transcoder Super-Engine Online
            </div>
            <button type="button" id="btnOpenBulkModal" style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: linear-gradient(135deg, rgba(236,72,153,0.15), rgba(99,102,241,0.15)); border: 1px solid rgba(236,72,153,0.4); border-radius: 20px; font-size: 11.5px; color: #f472b6; font-weight: 700; cursor: pointer; transition: all 0.2s ease;">
                📋 Bulk Batch (Paste 100 Links)
            </button>
            <button type="button" id="btnOpenMobileConnect" style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: rgba(56,189,248,0.12); border: 1px solid rgba(56,189,248,0.3); border-radius: 20px; font-size: 11.5px; color: #38bdf8; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
                📱 Connect iPhone / Mac
            </button>
            <button type="button" id="btnOpenCookieModal" style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: rgba(234,179,8,0.12); border: 1px solid rgba(234,179,8,0.3); border-radius: 20px; font-size: 11.5px; color: #facc15; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
                🍪 Cookie Vault (1080p Premium)
            </button>
        </div>

        <!-- Core Video & Playlist Downloader Card -->
        <div class="downloader-wrapper">
            <div class="downloader-card">
                <div class="card-heading">
                    <div class="heading-left">
                        <h2 class="card-title">Paste Video or Playlist Link</h2>
                    </div>
                    <div class="heading-right" style="display: flex; align-items: center; gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: #cbd5e1; cursor: pointer; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.2); padding: 3px 8px; border-radius: 6px;">
                            <input type="checkbox" id="chkSmartMode" style="accent-color: #38bdf8;">
                            <span>⚡ Smart Mode (1-Click)</span>
                        </label>
                        <span class="badge badge-strategy" id="strategyBadge">Auto-Detect &bull; High Speed</span>
                        <span class="badge badge-threads" id="topThreadsBadge" style="display:none;">256x Hyper Engine</span>
                    </div>
                </div>

                <!-- Input Form -->
                <div class="input-group">
                    <div class="input-wrapper">
                        <input type="url" id="streamUrl" placeholder="Paste YouTube, Playlist, or Video URL here..." autocomplete="off">
                        <button id="btnPaste" class="btn btn-secondary btn-icon-text" type="button" title="Paste from clipboard">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                            <span>Paste</span>
                        </button>
                        <button id="btnAnalyze" class="btn btn-primary btn-icon-text" type="button">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <span class="btn-text">Analyze</span>
                            <div class="spinner hidden" id="analyzeSpinner"></div>
                        </button>
                    </div>

                    <!-- Clipboard Auto-Detected Link Chip (like JDownloader 2) -->
                    <div id="clipboardDetectedChip" style="display: none; align-items: center; justify-content: space-between; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 8px; padding: 7px 12px; margin-top: 8px; font-size: 12px; color: #38bdf8;">
                        <div style="display: flex; align-items: center; gap: 8px; overflow: hidden;">
                            <span>📋 Clipboard Link Detected:</span>
                            <span id="clipboardDetectedUrl" style="color: #fff; font-family: monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 340px;"></span>
                        </div>
                        <button type="button" id="btnUseClipboardLink" style="padding: 3px 10px; background: #38bdf8; border: none; border-radius: 5px; color: #0f172a; font-weight: 700; font-size: 11px; cursor: pointer; white-space: nowrap;">Paste &amp; Analyze</button>
                    </div>

                    <div class="input-helper-tip">
                        <span>Paste any YouTube video link, shorts, or full playlist URL to start.</span>
                    </div>
                </div>

                <!-- Error Alert -->
                <div id="errorBox" class="alert error hidden">
                    <span class="alert-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    </span>
                    <span id="errorMessage">Error analyzing stream URL</span>
                </div>

                <!-- Stream Details (Populated on Analyze) -->
                <div id="streamDetails" class="stream-details hidden">
                    <div class="divider"></div>
                    
                    <!-- Clean Video & Audio Preview Card -->
                    <div class="video-preview-card" style="display: flex; gap: 18px; align-items: center; background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
                        <div class="video-thumb" id="videoThumbWrapper" style="position: relative; width: 140px; height: 85px; border-radius: 8px; overflow: hidden; background: #0d1117; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid #30363d;">
                            <img id="videoThumbImg" src="" alt="Thumbnail" referrerpolicy="no-referrer" style="width: 100%; height: 100%; object-fit: cover; display: none;">
                            <div class="thumb-fallback" id="thumbFallback" style="color: #58a6ff; display: flex; align-items: center; justify-content: center;">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
                            </div>
                            <span class="thumb-duration-badge" id="thumbDuration" style="position: absolute; bottom: 6px; right: 6px; background: rgba(0,0,0,0.8); color: #fff; font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 4px;">00:00</span>
                        </div>

                        <div class="video-meta" style="flex: 1; min-width: 0;">
                            <div class="meta-badges" style="display: flex; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                                <span class="badge badge-platform" id="badgePlatform" style="background: #21262d; color: #58a6ff; font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600;">Web Stream</span>
                                <span class="badge badge-duration" id="badgeDuration" style="background: #21262d; color: #8b949e; font-size: 11px; padding: 2px 8px; border-radius: 4px;">--:--</span>
                                <span class="badge badge-size" id="badgeEstSize" style="background: #238636; color: #fff; font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600;">0 MB</span>
                            </div>
                            <h3 class="video-title" id="videoTitleDisplay" style="font-size: 15px; font-weight: 700; color: #f0f6fc; margin: 0 0 4px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Video Title</h3>
                            <p class="video-desc" id="videoDescDisplay" style="font-size: 12px; color: #8b949e; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: none;"></p>
                        </div>
                    </div>

                    <!-- Modern Format Switcher Tabs (Video vs Audio MP3) -->
                    <div class="format-switcher" style="display: flex; gap: 10px; margin-bottom: 18px;">
                        <button type="button" id="tabModeVideo" class="btn-format-tab active" onclick="switchFormatMode('video')" style="flex: 1; padding: 12px; border-radius: 8px; border: 1.5px solid #38bdf8; background: #1e293b; color: #38bdf8; font-weight: 700; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.2s ease;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></svg>
                            <span>Video (MP4)</span>
                        </button>
                        <button type="button" id="tabModeAudio" class="btn-format-tab" onclick="switchFormatMode('audio')" style="flex: 1; padding: 12px; border-radius: 8px; border: 1.5px solid #30363d; background: #0f172a; color: #94a3b8; font-weight: 700; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.2s ease;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                            <span>Audio Only (MP3)</span>
                        </button>
                    </div>

                    <!-- Configuration Grid -->
                    <div class="config-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px;">
                        <div class="form-control">
                            <label for="qualitySelect" id="lblQualitySelect" style="font-size: 13px; font-weight: 600; color: #94a3b8; margin-bottom: 6px; display: block;">Video Quality</label>
                            <select id="qualitySelect" class="select-input" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 10px 12px; border-radius: 8px; font-size: 13px;">
                                <option value="">Detecting qualities...</option>
                            </select>
                        </div>

                        <div class="form-control">
                            <label for="fileNameInput" style="font-size: 13px; font-weight: 600; color: #94a3b8; margin-bottom: 6px; display: block;">File Name</label>
                            <input type="text" id="fileNameInput" class="text-input" placeholder="video_name.mp4" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 10px 12px; border-radius: 8px; font-size: 13px;">
                        </div>
                    </div>

                    <!-- Collapsible Clean Advanced Settings Accordion -->
                    <details class="advanced-options-accordion">
                        <summary class="advanced-summary">
                            <span class="advanced-summary-text">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                <span>Advanced Speed &amp; Thread Options</span>
                            </span>
                            <span class="advanced-arrow">▾</span>
                        </summary>
                        <div class="advanced-body">
                            <div class="concurrency-control-box" style="background: transparent; border: none; padding: 0; margin-bottom: 12px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <label style="font-size: 12.5px; font-weight: 600; color: #cbd5e1; margin: 0;">⚡ Parallel Concurrency Threads</label>
                                    <span id="threadsValue" style="font-size: 12px; font-weight: 700; color: #38bdf8; font-family: monospace; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2); padding: 2px 8px; border-radius: 6px;">64 Workers (Turbo)</span>
                                </div>
                                <div class="thread-presets" style="display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap;">
                                    <button type="button" class="btn-thread-preset" data-threads="16">16x</button>
                                    <button type="button" class="btn-thread-preset" data-threads="32">32x</button>
                                    <button type="button" class="btn-thread-preset active" data-threads="64">64x Turbo</button>
                                    <button type="button" class="btn-thread-preset" data-threads="128">128x Ultra</button>
                                    <button type="button" class="btn-thread-preset" data-threads="256">256x Max</button>
                                </div>
                                <input type="range" id="threadsRange" min="16" max="256" step="16" value="64" style="width: 100%; accent-color: #38bdf8; cursor: pointer;">
                            </div>

                            <!-- Super-Engine Power Features -->
                            <div class="power-features-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; padding: 12px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(51, 65, 85, 0.6); border-radius: 8px;">
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #cbd5e1; cursor: pointer;">
                                    <input type="checkbox" id="chkSponsorBlock" checked style="accent-color: #38bdf8; width: 15px; height: 15px;">
                                    <span>✂️ Auto-Skip Sponsors (SponsorBlock)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #cbd5e1; cursor: pointer;">
                                    <input type="checkbox" id="chkSubtitles" style="accent-color: #38bdf8; width: 15px; height: 15px;">
                                    <span>💬 Fetch Subtitles (.SRT)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #cbd5e1; cursor: pointer;">
                                    <input type="checkbox" id="chkTrimSnippet" style="accent-color: #38bdf8; width: 15px; height: 15px;">
                                    <span>⏱️ Trim Video Snippet</span>
                                </label>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="font-size: 11.5px; color: #94a3b8;">Speed Throttle:</span>
                                    <select id="selSpeedThrottle" style="flex: 1; background: #0f172a; border: 1px solid #334155; color: #cbd5e1; font-size: 11px; padding: 4px 6px; border-radius: 4px;">
                                        <option value="0">Unlimited (Max Speed)</option>
                                        <option value="50">50 MB/s</option>
                                        <option value="20">20 MB/s</option>
                                        <option value="10">10 MB/s</option>
                                        <option value="5">5 MB/s</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Trimming Inputs Row (Hidden until toggled) -->
                            <div id="trimInputsRow" style="display: none; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; padding: 10px 12px; background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 6px;">
                                <div>
                                    <label style="font-size: 11px; color: #94a3b8; display: block; margin-bottom: 3px;">Start Time (hh:mm:ss)</label>
                                    <input type="text" id="trimStartTime" placeholder="00:00:00" value="00:00:00" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #fff; font-size: 12px; padding: 4px 8px; border-radius: 4px; font-family: monospace;">
                                </div>
                                <div>
                                    <label style="font-size: 11px; color: #94a3b8; display: block; margin-bottom: 3px;">End Time (hh:mm:ss)</label>
                                    <input type="text" id="trimEndTime" placeholder="00:05:00" value="00:00:00" style="width: 100%; background: #0f172a; border: 1px solid #334155; color: #fff; font-size: 12px; padding: 4px 8px; border-radius: 4px; font-family: monospace;">
                                </div>
                            </div>

                            <!-- Destination Directory -->
                            <div class="dest-location-row" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 6px; padding: 8px 12px; margin-bottom: 4px;">
                                <div class="dest-info" style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #94a3b8;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                                    <span>Folder:</span>
                                    <span class="dest-path" id="destPathDisplay" style="color: #cbd5e1; font-family: monospace;">/Downloads/</span>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" id="btnBrowseFolder" style="padding: 3px 8px; font-size: 11px;">Open Folder</button>
                            </div>
                        </div>
                    </details>

                    <!-- Main Action Download Button -->
                    <button id="btnStartDownload" class="btn-turbo" style="width: 100%; padding: 14px; font-size: 15px; font-weight: 700; border-radius: 10px;">
                        <span id="btnDownloadText">⬇️ Download Video (MP4)</span>
                    </button>
                </div>

                <!-- Progress Section with Live Video Banner, Canvas Graph & Rich Metrics -->
                <div id="progressSection" class="progress-section hidden">
                    <div class="divider"></div>

                    <!-- Compact Active Download Video Banner -->
                    <div class="active-download-banner">
                        <div class="active-thumb-wrap">
                            <img id="activeThumbImg" src="" alt="" style="display: none;">
                            <div class="active-thumb-fallback" id="activeThumbFallback">▶</div>
                        </div>
                        <div class="active-info">
                            <h4 class="active-title" id="activeTitleDisplay">Downloading Video Stream...</h4>
                            <div class="active-badges">
                                <span class="badge badge-platform" id="activePlatformBadge">Web Stream</span>
                                <span class="badge badge-threads" id="activeThreadsBadge">64 Active Workers</span>
                                <span class="badge badge-size" id="activeQualityBadge">1080p FHD</span>
                                <span class="badge badge-strategy" id="activeStrategyBadge">Multi-Segment</span>
                            </div>
                        </div>
                        
                        <!-- Visible Pause / Resume and Cancel Action Controls -->
                        <div class="download-action-controls">
                            <button type="button" class="btn btn-secondary btn-icon-text" id="btnPauseResume">
                                <svg id="pauseResumeIcon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>
                                <span id="pauseResumeText">Pause</span>
                            </button>
                            <button type="button" class="btn btn-danger-subtle btn-icon-text" id="btnCancelDownload">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                <span>Cancel</span>
                            </button>
                        </div>
                    </div>
                    
                    <div class="progress-header">
                        <div class="status-indicator-group">
                            <span class="status-dot pulsing"></span>
                            <span class="status-badge" id="statusBadge">Downloading in Parallel...</span>
                        </div>
                        <span class="percentage-text" id="percentText">0%</span>
                    </div>

                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
                    </div>

                    <!-- Clean Real-Time Throughput Graph -->
                    <div class="throughput-container">
                        <div class="throughput-header">
                            <span class="throughput-title">Live Transfer Speed</span>
                            <div class="throughput-stats">
                                <span class="stat-tag" id="statCurSpeed">Current: 0.0 MB/s</span>
                                <span class="stat-tag peak" id="statPeakSpeed">Peak: 0.0 MB/s</span>
                                <span class="stat-tag avg" id="statAvgSpeed">Avg: 0.0 MB/s</span>
                            </div>
                        </div>
                        <canvas id="speedSparklineCanvas" class="speed-sparkline-canvas" width="600" height="48"></canvas>
                    </div>

                    <!-- Clean 3 Primary Metric Cards (With Secondary Technical Stats Preserved for JS) -->
                    <div class="metrics-grid six-cards">
                        <div class="metric-card">
                            <span class="metric-label">Download Speed</span>
                            <span class="metric-value speed" id="metricSpeed">0.0 MB/s</span>
                            <span class="metric-sub" id="metricPeakSpeedSub">Peak: 0.0 MB/s</span>
                        </div>
                        <div class="metric-card">
                            <span class="metric-label">Downloaded Size</span>
                            <span class="metric-value" id="metricSize">0 MB / 0 MB</span>
                            <span class="metric-sub" id="metricSizePct">0% complete</span>
                        </div>
                        <div class="metric-card">
