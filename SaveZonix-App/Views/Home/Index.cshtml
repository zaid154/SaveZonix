        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" id="btnCloseCookieModalBtn" style="padding: 9px 16px; background: #1f2937; border: 1px solid #374151; border-radius: 8px; color: #d1d5db; font-size: 13px; font-weight: 600; cursor: pointer;">Close</button>
            <button type="button" id="btnSaveCookies" style="padding: 9px 20px; background: linear-gradient(135deg, #eab308, #ca8a04); border: none; border-radius: 8px; color: #000; font-size: 13px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(234, 179, 8, 0.3);">💾 Save &amp; Activate Cookies</button>
        </div>
    </div>
</div>

<!-- In-App Cinema & Audio Preview Modal -->
<div id="inAppMediaModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); z-index: 99999; justify-content: center; align-items: center; padding: 20px;">
    <div style="background: #111827; border: 1px solid #374151; border-radius: 16px; width: 100%; max-width: 800px; padding: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8); position: relative;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h4 id="inAppMediaTitle" style="margin: 0; font-size: 15px; font-weight: 700; color: #f9fafb; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90%;">Preview Media</h4>
            <button type="button" id="btnCloseMediaModal" style="background: transparent; border: none; color: #9ca3af; font-size: 24px; cursor: pointer; padding: 4px 8px; line-height: 1;">&times;</button>
        </div>

        <div style="border-radius: 12px; overflow: hidden; background: #000; margin-bottom: 14px; max-height: 480px; display: flex; align-items: center; justify-content: center;">
            <video id="inAppVideoPlayer" controls playsinline preload="metadata" style="width: 100%; max-height: 480px; display: block; outline: none;"></video>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div style="font-size: 12px; color: #94a3b8;">
                <span id="inAppMediaMeta">Apple Safari &amp; QuickTime Ready</span>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="button" id="btnRevealFromPlayer" style="padding: 7px 14px; background: #1f2937; border: 1px solid #374151; border-radius: 6px; color: #cbd5e1; font-size: 12px; font-weight: 600; cursor: pointer;">📁 Show in Folder</button>
                <button type="button" id="btnShareFromPlayer" style="display: none; padding: 7px 14px; background: #0284c7; border: none; border-radius: 6px; color: #fff; font-size: 12px; font-weight: 600; cursor: pointer;">📤 Share / AirDrop</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/app.js" asp-append-version="true"></script>
}


