@{
    ViewData["Title"] = "Security & Anti-Spam — SaveZonix Admin";
}

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <h1 class="page-title">🛡️ Security &amp; Anti-Spam Shield</h1>
                <p class="page-subtitle">Manage disposable email blacklists, OTP verification policies, and bot protection</p>
            </div>
            <div class="admin-nav-links">
                <a asp-action="Index" class="btn btn-secondary">Dashboard</a>
                <a asp-action="Users" class="btn btn-secondary">Users</a>
                <a asp-action="Downloads" class="btn btn-secondary">Downloads</a>
                <a asp-action="Diagnostics" class="btn btn-secondary">Diagnostics & Logs</a>
                <a asp-action="Settings" class="btn btn-secondary">Settings</a>
                <a asp-action="Security" class="btn btn-primary">Security</a>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">🛡️</div>
                <div class="stat-value">200+</div>
                <div class="stat-label">Blocked Disposable Domains</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Updated automatically</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">⏱️</div>
                <div class="stat-value">10 Min</div>
                <div class="stat-label">OTP Lifetime Expiry</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">6-digit cryptographically secure OTP</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">⏳</div>
                <div class="stat-value">45 Sec</div>
                <div class="stat-label">Resend Cooldown Timer</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Rate-limiting brute force attempts</div>
            </div>
        </div>

        <!-- Live Sandbox -->
        <div class="glass-card" style="padding: 24px; margin-bottom: 24px;">
            <h2 class="card-title" style="margin-bottom: 8px;">Live Disposable Email Checker Sandbox</h2>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">Test any email address against the active real-time blacklist shield to verify if registration will be blocked.</p>
            
            <div style="display: flex; gap: 12px; max-width: 600px;">
                <input type="email" id="txtTestEmail" class="form-control" placeholder="Enter email to test (e.g. test@temp-mail.org)">
                <button type="button" onclick="testEmailDomain()" class="btn btn-primary" style="white-space: nowrap;">Test Domain</button>
            </div>
            <div id="sandboxResult" style="display: none; margin-top: 14px; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 600;"></div>
        </div>

        <!-- Blacklist Details -->
        <div class="glass-card" style="padding: 24px;">
            <h2 class="card-title" style="margin-bottom: 8px;">Blocked Burner Providers Summary</h2>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">The following popular disposable mail domains are strictly forbidden from creating accounts:</p>
            
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">temp-mail.org</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">mailinator.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">guerrillamail.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">10minutemail.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">throwawaymail.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">yopmail.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">trashmail.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">burnermail.io</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #f85149;">fakeinbox.com</span>
                <span class="badge" style="background: #21262d; border: 1px solid #30363d; padding: 6px 12px; font-size: 12px; color: #8b949e;">+ 190 others</span>
            </div>
        </div>

    </div>
</div>

<script>
    function testEmailDomain() {
        const email = document.getElementById('txtTestEmail').value.trim();
        const resBox = document.getElementById('sandboxResult');
        if (!email || !email.includes('@@')) {
            resBox.style.display = 'block';
            resBox.style.background = 'rgba(248, 81, 73, 0.15)';
            resBox.style.border = '1px solid #f85149';
            resBox.style.color = '#f85149';
            resBox.textContent = 'Please enter a valid email address.';
            return;
        }

        const blocked = ['tempmail', 'temp-mail', 'mailinator', 'guerrillamail', '10minute', 'throwaway', 'yopmail', 'trashmail', 'burnermail', 'fakeinbox', 'getairmail', 'dispostable', 'sharklasers'];
        const domain = email.split('@@')[1].toLowerCase();
        const isBlocked = blocked.some(b => domain.includes(b));

        resBox.style.display = 'block';
        if (isBlocked) {
            resBox.style.background = 'rgba(248, 81, 73, 0.15)';
            resBox.style.border = '1px solid #f85149';
            resBox.style.color = '#f85149';
            resBox.textContent = `🚫 BLOCKED: ${domain} is on the active disposable/burner blacklist.`;
        } else {
            resBox.style.background = 'rgba(35, 134, 54, 0.2)';
            resBox.style.border = '1px solid #238636';
            resBox.style.color = '#3fb950';
            resBox.textContent = `✓ ALLOWED: ${domain} is valid and accepted for registration.`;
        }
    }
</script>
