@model StreamHelper.ViewModels.AdminDiagnosticsViewModel
@{
    ViewData["Title"] = "Download Diagnostics & Error Logs — SaveZonix Admin";
}

<div class="admin-page">
    <div class="container">
        <!-- Admin Header Navigation -->
        <div class="admin-header">
            <div>
                <div class="hero-tag">
                    <span class="badge-tag badge-red">🛡️ Administrative Privileges</span>
                    <span class="badge-tag badge-purple" style="margin-left: 8px;">🔬 Telemetry & Quality Engine</span>
                </div>
                <h1 class="page-title">Download Diagnostics & Logs</h1>
                <p class="page-subtitle">Real-time media stream validation, corruption detection, version tracking, and error logs</p>
            </div>
            <div class="admin-nav-links">
                <a asp-action="Index" class="btn btn-secondary">Dashboard</a>
                <a asp-action="Users" class="btn btn-secondary">Users</a>
                <a asp-action="Downloads" class="btn btn-secondary">Downloads</a>
                <a asp-action="Diagnostics" class="btn btn-primary">Diagnostics & Logs</a>
                <a asp-action="Settings" class="btn btn-secondary">Settings</a>
                <a asp-action="Security" class="btn btn-secondary">Security</a>
            </div>
        </div>

        <!-- System & Version Telemetry Banner -->
        <div class="glass-card" style="padding: 20px 24px; margin-bottom: 24px; border-left: 4px solid #38bdf8; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;">
            <div>
                <div style="font-size: 13px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Engine Version & Environment</div>
                <div style="font-size: 18px; font-weight: 800; color: #f8fafc; margin-top: 4px; display: flex; align-items: center; gap: 10px;">
                    <span>🚀 @Model.AppVersion</span>
                    <span style="font-size: 12px; background: rgba(56, 189, 248, 0.2); color: #38bdf8; padding: 2px 8px; border-radius: 6px; font-weight: 600;">@Model.DotNetVersion</span>
                </div>
                <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">Platform: <strong>@Model.OsDescription</strong></div>
            </div>
            <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                <div style="background: rgba(255,255,255,0.05); padding: 8px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                    <div style="font-size: 11px; color: var(--text-muted);">FFmpeg Native Muxer</div>
                    <div style="font-size: 14px; font-weight: 700; color: @(Model.IsFfmpegAvailable ? "#10b981" : "#f59e0b");">
                        @(Model.IsFfmpegAvailable ? "✅ Hardware / Binary Active" : "⚡ Fallback Native Atom Parser")
                    </div>
                </div>
                <div style="background: rgba(255,255,255,0.05); padding: 8px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                    <div style="font-size: 11px; color: var(--text-muted);">Media Pass Rate</div>
                    <div style="font-size: 14px; font-weight: 700; color: #10b981;">
                        @Model.ValidationPassRate.ToString("F1")%
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Cards Grid -->
        <div class="stats-grid" style="margin-bottom: 32px;">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">📊</div>
                <div class="stat-value">@Model.TotalDownloads</div>
                <div class="stat-label">Total Downloads Analyzed</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">All historical tasks</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">✅</div>
                <div class="stat-value">@Model.CompletedCount</div>
                <div class="stat-label">Verified & Healthy</div>
                <div style="font-size: 12px; color: #10b981; margin-top: 4px;">100% full stream integrity</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">🛡️</div>
                <div class="stat-value">@Model.CorruptedCount</div>
                <div class="stat-label">Corrupted / Truncated Intercepted</div>
                <div style="font-size: 12px; color: #f59e0b; margin-top: 4px;">Blocked before saving</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e;">❌</div>
                <div class="stat-value">@Model.FailedCount</div>
                <div class="stat-label">Failed Network Tasks</div>
                <div style="font-size: 12px; color: #f43f5e; margin-top: 4px;">Server / CDN Errors</div>
            </div>
        </div>

        <!-- Search & Filter Controls -->
        <div class="glass-card" style="padding: 20px; margin-bottom: 24px;">
            <form method="get" asp-action="Diagnostics" style="display: flex; gap: 12px; flex-wrap: wrap;">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-input" placeholder="Search by title, URL, error message..." style="flex: 1; min-width: 260px;" />
                <select name="status" class="form-input" style="width: 180px;">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed (Verified)</option>
                    <option value="Corrupted" selected="@(Model.StatusFilter == "Corrupted")">Corrupted / Truncated</option>
                    <option value="Failed" selected="@(Model.StatusFilter == "Failed")">Failed</option>
                    <option value="Retrying" selected="@(Model.StatusFilter == "Retrying")">Retrying</option>
                </select>
                <button type="submit" class="btn btn-primary">Filter Diagnostics</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a asp-action="Diagnostics" class="btn btn-secondary">Clear</a>
                }
            </form>
        </div>

        <!-- Diagnostics Log Table -->
        <div class="glass-card" style="padding: 24px; margin-bottom: 32px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 class="card-title" style="margin-bottom: 0;">Media Validation & Integrity Stream</h2>
                <div style="font-size: 13px; color: var(--text-muted);">
                    Showing @Model.DiagnosticDownloads.Count of @Model.TotalCount records
                </div>
            </div>

            @if (Model.DiagnosticDownloads.Count == 0)
            {
                <div class="empty-state" style="padding: 40px; text-align: center;">
                    <div style="font-size: 40px; margin-bottom: 12px;">🔍</div>
                    <h3>No Diagnostic Records Found</h3>
                    <p style="color: var(--text-muted);">No downloads matched your active filter criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table" style="font-size: 13px;">
                        <thead>
                            <tr>
                                <th>Media Title & Source</th>
                                <th>Size / Probed Duration</th>
                                <th>Codec & Streams</th>
                                <th>Validation Status</th>
                                <th>Corruption / Failure Reason</th>
                                <th>Retries</th>
                                <th>Engine Version</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DiagnosticDownloads)
                            {
                                string statusBadgeClass = item.Status switch
                                {
                                    StreamHelper.Data.DownloadStatus.Completed => "status-completed",
                                    StreamHelper.Data.DownloadStatus.Corrupted => "status-corrupted",
                                    StreamHelper.Data.DownloadStatus.Failed => "status-failed",
                                    StreamHelper.Data.DownloadStatus.Retrying => "status-retrying",
                                    _ => "status-queued"
                                };

                                string valBadgeStyle = item.ValidationStatus == "Passed" 
                                    ? "background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);"
                                    : "background: rgba(244, 63, 94, 0.15); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3);";

                                <tr>
                                    <td>
                                        <div class="table-title" style="max-width: 220px; font-weight: 600;" title="@item.Title">
                                            @item.Title
                                        </div>
                                        <div class="table-sub" style="font-size: 11px; color: var(--text-muted); word-break: break-all;">
                                            @item.Platform • <a href="@item.OriginalUrl" target="_blank" style="color: #38bdf8; text-decoration: none;">Link ↗</a>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-weight: 700;">@item.FormattedFileSize</div>
                                        <div style="font-size: 11px; color: var(--text-muted);">
                                            @(item.ProbedDurationSeconds > 0 ? $"{item.ProbedDurationSeconds:F1}s probed" : item.FormattedDuration)
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-size: 11px; background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);">
                                            @(string.IsNullOrEmpty(item.AudioVideoDetails) ? item.Quality : item.AudioVideoDetails)
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-badge @statusBadgeClass" style="font-size: 11px; padding: 2px 8px;">
                                            @item.Status
                                        </span>
                                        <div style="margin-top: 4px;">
                                            <span style="font-size: 10px; padding: 2px 6px; border-radius: 4px; font-weight: 700; @valBadgeStyle">
                                                @item.ValidationStatus
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ErrorReason) || !string.IsNullOrEmpty(item.ValidationDetails))
                                        {
                                            <div style="max-width: 260px; font-size: 11px; color: #fca5a5; line-height: 1.3; background: rgba(244, 63, 94, 0.08); padding: 6px 8px; border-radius: 6px; border: 1px solid rgba(244, 63, 94, 0.2);">
                                                @(item.ErrorReason ?? item.ValidationDetails)
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: #10b981; font-size: 11px;">✓ Healthy stream</span>
                                        }
                                    </td>
                                    <td style="text-align: center; font-weight: 700;">
                                        @if (item.RetryCount > 0)
                                        {
                                            <span style="color: #f59e0b; background: rgba(245, 158, 11, 0.1); padding: 2px 6px; border-radius: 4px; font-size: 11px;">
                                                @item.RetryCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: 11px;">0</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="font-size: 11px; font-weight: 600; color: #94a3b8;">@(item.AppVersion ?? "SaveZonix v2.5.0")</div>
                                        <div style="font-size: 10px; color: var(--text-muted);">@(item.SystemVersion ?? ".NET 10.0")</div>
                                    </td>
                                    <td style="color: var(--text-muted); font-size: 11px;">
                                        @item.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm:ss")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div style="display: flex; justify-content: center; gap: 8px; margin-top: 24px;">
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <a asp-action="Diagnostics" 
                               asp-route-page="@p" 
                               asp-route-search="@Model.SearchTerm" 
                               asp-route-status="@Model.StatusFilter"
                               class="btn @(p == Model.CurrentPage ? "btn-primary" : "btn-secondary")" 
                               style="padding: 6px 12px; font-size: 13px;">@p</a>
                        }
                    </div>
                }
            }
        </div>

        <!-- Client & Server Error Diagnostics Log Stream -->
        <div class="glass-card" style="padding: 24px; margin-bottom: 32px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h2 class="card-title" style="margin-bottom: 0;">⚡ Real-time Error & Exception Stream</h2>
                <span class="badge-tag badge-red">Latest 50 Events</span>
            </div>

            @if (Model.ErrorLogs.Count == 0)
            {
                <div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    🎉 No server exceptions or client-side errors logged in this session!
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table" style="font-size: 12px;">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Error Type</th>
                                <th>Message</th>
                                <th>URL / Task</th>
                                <th>Client / Engine Info</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var err in Model.ErrorLogs)
                            {
                                <tr>
                                    <td style="color: var(--text-muted); white-space: nowrap;">
                                        @err.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="badge-tag badge-red" style="font-size: 10px;">@err.ErrorType</span>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600; color: #fca5a5;">@err.ErrorMessage</div>
                                        @if (!string.IsNullOrEmpty(err.StackTrace))
                                        {
                                            <details style="margin-top: 4px;">
                                                <summary style="font-size: 10px; color: #94a3b8; cursor: pointer;">Show Stack Trace</summary>
                                                <pre style="font-size: 10px; background: rgba(0,0,0,0.4); padding: 8px; border-radius: 4px; overflow-x: auto; color: #e2e8f0; margin-top: 4px;">@err.StackTrace</pre>
                                            </details>
                                        }
                                    </td>
                                    <td style="max-width: 200px; word-break: break-all; color: #38bdf8;">
                                        @err.Url
                                    </td>
                                    <td>
                                        <div>@err.AppVersion</div>
                                        <div style="color: var(--text-muted); font-size: 10px;">@err.ClientIp • @err.UserAgent</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
