@model string
@{
    var activeTab = Model ?? "";
}

<div class="legal-nav-bar" style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px; padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <a asp-controller="Legal" asp-action="Privacy" class="legal-nav-pill @(activeTab == "Privacy" ? "active" : "")">Privacy Policy</a>
    <a asp-controller="Legal" asp-action="Terms" class="legal-nav-pill @(activeTab == "Terms" ? "active" : "")">Terms of Service</a>
    <a asp-controller="Legal" asp-action="Copyright" class="legal-nav-pill @(activeTab == "Copyright" ? "active" : "")">Copyright Policy</a>
    <a asp-controller="Legal" asp-action="DMCA" class="legal-nav-pill @(activeTab == "DMCA" ? "active" : "")">DMCA Takedown</a>
    <a asp-controller="Legal" asp-action="Disclaimer" class="legal-nav-pill @(activeTab == "Disclaimer" ? "active" : "")">Legal Disclaimer</a>
    <a asp-controller="Legal" asp-action="Cookies" class="legal-nav-pill @(activeTab == "Cookies" ? "active" : "")">Cookie Policy</a>
    <a asp-controller="Legal" asp-action="AcceptableUse" class="legal-nav-pill @(activeTab == "AcceptableUse" ? "active" : "")">Acceptable Use</a>
    <a asp-controller="Legal" asp-action="Grievance" class="legal-nav-pill @(activeTab == "Grievance" ? "active" : "")">Grievance Officer</a>
</div>
