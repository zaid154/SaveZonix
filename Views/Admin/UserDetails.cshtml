@model StreamHelper.ViewModels.AdminUserDetailsViewModel
@{
    ViewData["Title"] = "User Details — Stream Helper Admin";
}

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <a asp-action="Users" class="auth-link" style="font-size: 13px; margin-bottom: 8px; display: inline-block;">&larr; Back to Users List</a>
                <h1 class="page-title">@Model.User.FullName</h1>
                <p class="page-subtitle">@Model.User.Email • Joined @Model.User.CreatedAt.ToString("MMMM dd, yyyy")</p>
            </div>
            <div class="admin-nav-links">
                <form asp-action="ToggleUserStatus" asp-route-id="@Model.User.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.User.IsActive ? "btn-warning" : "btn-primary")">
                        @(Model.User.IsActive ? "Deactivate Account" : "Activate Account")
                    </button>
                </form>
            </div>
        </div>

        <div class="stats-grid" style="margin-bottom: 32px;">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">📥</div>
                <div class="stat-value">@Model.TotalDownloads</div>
                <div class="stat-label">Total Downloads</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">✅</div>
                <div class="stat-value">@Model.CompletedDownloads</div>
                <div class="stat-label">Completed Files</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">💾</div>
                <div class="stat-value">@((Model.TotalDownloadedBytes / 1024.0 / 1024.0).ToString("F1")) MB</div>
                <div class="stat-label">Bandwidth Consumed</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">🔑</div>
                <div class="stat-value">@(Model.User.EmailConfirmed ? "Verified" : "Unverified")</div>
                <div class="stat-label">Email Status</div>
            </div>
        </div>

        <div class="glass-card" style="padding: 20px; margin-bottom: 32px;">
            <h2 class="card-title" style="margin-bottom: 16px;">User's Recent Download Tasks</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Media</th>
                            <th>Title &amp; Format</th>
                            <th>Platform</th>
                            <th>Size</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.RecentDownloads)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.ThumbnailUrl))
                                    {
                                        <img src="@d.ThumbnailUrl" alt="Thumb" class="table-thumb-sm" onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <span>🎬</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-title" style="max-width: 320px;" title="@d.Title">@d.Title</div>
                                    <div class="table-sub">@d.Quality • @d.Format</div>
                                </td>
                                <td><span class="badge-tag badge-subtle">@d.Platform</span></td>
                                <td>@d.FormattedFileSize</td>
                                <td>
                                    <span class="status-badge status-@(d.Status.ToString().ToLower())">@d.Status</span>
                                </td>
                                <td style="color: var(--text-muted);">@d.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
