<script>
function switchSettingsTab(tab) {
    const paneEngine = document.getElementById('tabContentEngine');
    const paneAccess = document.getElementById('tabContentAccess');
    const paneDatabase = document.getElementById('tabContentDatabase');
    const btnEngine = document.getElementById('tabBtnEngine');
    const btnAccess = document.getElementById('tabBtnAccess');
    const btnDatabase = document.getElementById('tabBtnDatabase');

    if (paneEngine) paneEngine.style.display = 'none';
    if (paneAccess) paneAccess.style.display = 'none';
    if (paneDatabase) paneDatabase.style.display = 'none';

    [btnEngine, btnAccess, btnDatabase].forEach(b => {
        if (!b) return;
        b.style.background = 'rgba(15, 23, 42, 0.6)';
        b.style.borderColor = 'rgba(255, 255, 255, 0.1)';
        b.style.color = '#94a3b8';
        b.style.boxShadow = 'none';
    });

    if (tab === 'engine') {
        if (paneEngine) paneEngine.style.display = 'flex';
        if (btnEngine) {
            btnEngine.style.background = 'rgba(56, 189, 248, 0.15)';
            btnEngine.style.borderColor = '#38bdf8';
            btnEngine.style.color = '#38bdf8';
            btnEngine.style.boxShadow = '0 4px 15px rgba(56, 189, 248, 0.2)';
        }
    } else if (tab === 'access') {
        if (paneAccess) paneAccess.style.display = 'flex';
        if (btnAccess) {
            btnAccess.style.background = 'rgba(56, 189, 248, 0.15)';
            btnAccess.style.borderColor = '#38bdf8';
            btnAccess.style.color = '#38bdf8';
            btnAccess.style.boxShadow = '0 4px 15px rgba(56, 189, 248, 0.2)';
        }
    } else if (tab === 'database') {
        if (paneDatabase) paneDatabase.style.display = 'flex';
        if (btnDatabase) {
            btnDatabase.style.background = 'rgba(16, 185, 129, 0.15)';
            btnDatabase.style.borderColor = '#10b981';
            btnDatabase.style.color = '#34d399';
            btnDatabase.style.boxShadow = '0 4px 15px rgba(16, 185, 129, 0.2)';
        }
        loadDatabaseStats();
    }
}

function updateDbCardStyles() {
    const selected = document.querySelector('input[name="settings[DatabaseProvider]"]:checked')?.value || 'MongoDB';
    const cardMongo = document.getElementById('cardProviderMongo');
    const cardSql = document.getElementById('cardProviderSql');
    const iconMongo = document.getElementById('checkIconMongo');
    const iconSql = document.getElementById('checkIconSql');

    if (selected === 'MongoDB') {
        if (cardMongo) {
            cardMongo.style.borderColor = '#10b981';
            cardMongo.style.background = 'rgba(16, 185, 129, 0.08)';
        }
        if (iconMongo) iconMongo.style.display = 'inline';

        if (cardSql) {
            cardSql.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            cardSql.style.background = 'rgba(255, 255, 255, 0.02)';
        }
        if (iconSql) iconSql.style.display = 'none';
    } else {
        if (cardSql) {
            cardSql.style.borderColor = '#38bdf8';
            cardSql.style.background = 'rgba(56, 189, 248, 0.08)';
        }
        if (iconSql) iconSql.style.display = 'inline';

        if (cardMongo) {
            cardMongo.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            cardMongo.style.background = 'rgba(255, 255, 255, 0.02)';
        }
        if (iconMongo) iconMongo.style.display = 'none';
    }
}

async function loadDatabaseStats() {
    try {
        const res = await fetch('/api/admin/database-status');
        if (!res.ok) return;
        const data = await res.json();

        const mongoTxt = document.getElementById('txtMongoStatus');
        if (mongoTxt) {
            mongoTxt.innerText = data.mongoConnected ? 'Connected' : 'Unavailable';
            mongoTxt.style.color = data.mongoConnected ? '#34d399' : '#f87171';
        }

        const sqlTxt = document.getElementById('txtSqlStatus');
        if (sqlTxt) {
            sqlTxt.innerText = data.sqlConnected ? 'Active' : 'Offline';
            sqlTxt.style.color = data.sqlConnected ? '#38bdf8' : '#f87171';
        }

        const mDl = document.getElementById('statMongoDownloads');
        if (mDl) mDl.innerText = data.mongoDownloadsCount;

        const mUsr = document.getElementById('statMongoUsers');
        if (mUsr) mUsr.innerText = data.mongoUsersCount;

        const sDl = document.getElementById('statSqlDownloads');
        if (sDl) sDl.innerText = data.sqlDownloadsCount;

        const sUsr = document.getElementById('statSqlUsers');
        if (sUsr) sUsr.innerText = data.sqlUsersCount;
    } catch (e) {
        console.error('Error fetching database status', e);
    }
}

async function runDatabaseSync() {
    const btn = document.getElementById('btnSyncDatabases');
    const spinner = document.getElementById('syncSpinner');
    const btnText = document.getElementById('syncBtnText');
    const resultBox = document.getElementById('syncResultContainer');

    btn.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';
    if (btnText) btnText.innerText = 'Syncing Databases... Please Wait';

    if (resultBox) {
        resultBox.style.display = 'block';
        resultBox.style.background = 'rgba(0, 0, 0, 0.4)';
        resultBox.style.border = '1px solid rgba(56, 189, 248, 0.3)';
        resultBox.style.color = '#cbd5e1';
        resultBox.innerHTML = '<div style="display: flex; align-items: center; gap: 10px;"><span>⏳</span><span>Synchronizing Users, Passwords, Download Histories &amp; Settings across MongoDB and SQLite...</span></div>';
    }

    try {
        const res = await fetch('/api/admin/sync-databases', { method: 'POST' });
        const data = await res.json();

        if (data.success) {
            resultBox.style.background = 'rgba(16, 185, 129, 0.1)';
            resultBox.style.border = '1px solid rgba(16, 185, 129, 0.4)';
            resultBox.style.color = '#34d399';
            resultBox.innerHTML = `
                <div style="font-weight: 700; font-size: 14px; margin-bottom: 6px;">✅ Bi-Directional Synchronization Complete!</div>
                <div style="font-size: 12.5px; color: #cbd5e1; display: flex; gap: 16px; flex-wrap: wrap;">
                    <span>👥 Users Synchronized: <b style="color: #fff;">${data.usersSynced}</b></span>
                    <span>📥 Downloads Synchronized: <b style="color: #fff;">${data.downloadsSynced}</b></span>
                    <span>⚙️ Settings Synchronized: <b style="color: #fff;">${data.settingsSynced}</b></span>
                </div>
            `;
            await loadDatabaseStats();
        } else {
            resultBox.style.background = 'rgba(239, 68, 68, 0.1)';
            resultBox.style.border = '1px solid rgba(239, 68, 68, 0.4)';
            resultBox.style.color = '#fca5a5';
            resultBox.innerHTML = `<b>❌ Sync Error:</b> ${data.message || 'Unknown synchronization error'}`;
        }
    } catch (err) {
        if (resultBox) {
            resultBox.style.background = 'rgba(239, 68, 68, 0.1)';
            resultBox.style.border = '1px solid rgba(239, 68, 68, 0.4)';
            resultBox.style.color = '#fca5a5';
            resultBox.innerHTML = `<b>❌ Sync Failed:</b> ${err.message || 'Network failure'}`;
        }
    } finally {
        btn.disabled = false;
        if (spinner) spinner.style.display = 'none';
        if (btnText) btnText.innerText = '🚀 Run 1-Click Full Bi-Directional Sync';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    updateDbCardStyles();
    loadDatabaseStats();
});

function applyProfile(strict, open, def) {
    document.getElementById('inpStrictThreads').value = strict;
    document.getElementById('inpOpenThreads').value = open;
    document.getElementById('inpDefaultThreads').value = def;
}

async function scanAllSitesHealth() {
    const resDiv = document.getElementById('batchScanResult');
    const btnText = document.getElementById('btnScanAllText');
    const btn = document.getElementById('btnScanAll');

    resDiv.style.display = 'block';
    resDiv.innerHTML = `
        <div style="padding: 16px; background: rgba(0, 0, 0, 0.5); border-radius: 10px; border: 1px solid rgba(56, 189, 248, 0.3); display: flex; align-items: center; gap: 12px;">
            <div class="spinner" style="width: 22px; height: 22px; border-width: 2px;"></div>
            <div style="font-size: 13px; color: #38bdf8; font-weight: 600;">
                Scanning 16+ video CDN edge clusters simultaneously (checking latency, byte-range, anti-bot protection)...
            </div>
        </div>
    `;

    btnText.innerText = "⏳ Scanning 16+ Sites...";
    btn.disabled = true;

    try {
        const resp = await fetch('/api/admin/scan-all-sites', { method: 'POST' });
        const data = await resp.json();

        if (!resp.ok || !data.success) {
            throw new Error(data.message || 'Failed to scan all sites.');
        }

        let rowsHtml = '';
        data.sites.forEach(s => {
            const isOnline = s.reachable;
            const badgeBg = isOnline ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)';
            const badgeColor = isOnline ? '#34d399' : '#f87171';
            const badgeBorder = isOnline ? 'rgba(16, 185, 129, 0.3)' : 'rgba(239, 68, 68, 0.3)';

            rowsHtml += `
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                    <td style="padding: 10px 12px; font-weight: 700; color: #f8fafc;">
                        <span style="font-size: 13px;">${s.name}</span>
                        <div style="font-size: 10.5px; color: #94a3b8; font-family: monospace;">${s.domain}</div>
                    </td>
                    <td style="padding: 10px 12px; font-size: 11.5px; color: #cbd5e1;">${s.category}</td>
                    <td style="padding: 10px 12px;">
                        <span style="background: ${badgeBg}; color: ${badgeColor}; border: 1px solid ${badgeBorder}; padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                            ${isOnline ? '🟢 ' + s.statusText : '🔴 ' + s.statusText} (${s.pingMs}ms)
                        </span>
                    </td>
                    <td style="padding: 10px 12px; font-size: 11.5px; color: #94a3b8;">
                        ${s.note}
                    </td>
                    <td style="padding: 10px 12px; text-align: right;">
                        <button type="button" class="btn btn-secondary" onclick="probeQuick('${s.domain}')" style="padding: 4px 10px; font-size: 11px; font-weight: 600; border-radius: 6px;">
                            🔍 Deep Probe
                        </button>
                    </td>
                </tr>
            `;
        });

        resDiv.innerHTML = `
            <div style="background: rgba(10, 15, 30, 0.95); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 12px;">
                    <div>
                        <div style="font-size: 15px; font-weight: 800; color: #38bdf8; display: flex; align-items: center; gap: 8px;">
                            <span>🌐 All Sites Global Fleet Health (${data.scannedCount} Platforms Tested)</span>
                            <span style="font-size: 11px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 2px 8px; border-radius: 12px;">Active Multi-Ping</span>
                        </div>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 2px;">Real-time network reachability, anti-bot handshake, and rate-limit tolerance</p>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn btn-primary" onclick="autoFixAllSites()" style="padding: 6px 14px; font-size: 12px; font-weight: 700; border-radius: 8px; background: rgba(16, 185, 129, 0.2); border: 1px solid #34d399; color: #34d399;">
                            ⚡ Auto-Fix &amp; Calibrate All Sites
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="document.getElementById('batchScanResult').style.display='none'" style="padding: 6px 10px; font-size: 12px;">
                            ✕ Close
                        </button>
                    </div>
                </div>

                <div style="max-height: 340px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
                        <thead>
                            <tr style="background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.08); color: #94a3b8; font-size: 11px; text-transform: uppercase;">
                                <th style="padding: 10px 12px;">Platform</th>
                                <th style="padding: 10px 12px;">Category</th>
                                <th style="padding: 10px 12px;">Edge Health</th>
                                <th style="padding: 10px 12px;">Status / Notes</th>
                                <th style="padding: 10px 12px; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rowsHtml}
                        </tbody>
                    </table>
                </div>
            </div>
        `;
    } catch (err) {
        resDiv.innerHTML = `
            <div style="padding: 14px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; color: #fca5a5; font-size: 12.5px;">
                ❌ <b>Batch Scan Failed:</b> ${err.message}
            </div>
        `;
    } finally {
        btnText.innerText = "🌐 1-Click Scan All Sites";
        btn.disabled = false;
    }
}

async function autoFixAllSites() {
    const btn = document.getElementById('btnAutoFixAll');
    if (btn) btn.disabled = true;

    try {
        const resp = await fetch('/api/admin/auto-fix-all', { method: 'POST' });
        const data = await resp.json();

        if (!resp.ok || !data.success) {
            throw new Error(data.message || 'Auto-fix failed.');
        }

        // Update inputs on the page immediately
        if (data.appliedSettings) {
            if (document.getElementById('inpDefaultThreads')) document.getElementById('inpDefaultThreads').value = data.appliedSettings.DefaultThreads;
            if (document.getElementById('inpStrictThreads')) document.getElementById('inpStrictThreads').value = data.appliedSettings.StrictCdnMaxThreads;
            if (document.getElementById('inpOpenThreads')) document.getElementById('inpOpenThreads').value = data.appliedSettings.OpenCdnMaxThreads;
            if (document.getElementById('inpStrictDomains')) document.getElementById('inpStrictDomains').value = data.appliedSettings.StrictCdnDomains;
        }

        alert("✅ " + data.message + "\n\n• Strict Cap: 24 Workers (Safe from 429 Bans)\n• Turbo Cap: 256 Workers (Max Speed for YouTube/Direct)\n• Default Threads: 48 Workers\n• Rate-Limited Filter: 24+ CDN Domains Loaded!\n\nPlatform configuration has been auto-saved to database.");
        
        // Refresh batch scan table if visible
        const batchRes = document.getElementById('batchScanResult');
        if (batchRes && batchRes.style.display !== 'none') {
            scanAllSitesHealth();
        }
    } catch (err) {
        alert("❌ Auto-Fix error: " + err.message);
    } finally {
        if (btn) btn.disabled = false;
    }
}

async function flushRedisCache() {
    try {
        const resp = await fetch('/api/admin/clear-cache', { method: 'POST' });
        const data = await resp.json();
        alert(data.message || 'Cache cleared successfully!');
    } catch (e) {
        alert('Failed to clear cache: ' + e.message);
    }
}

async function checkRedisStatus() {
    try {
        const resp = await fetch('/api/admin/cache-status');
        const data = await resp.json();
        const badge = document.getElementById('redisCacheBadge');
        if (badge) {
            if (data.isConnected) {
                badge.innerText = '⚡ Redis v7.0 Active';
                badge.style.color = '#34d399';
                badge.style.background = 'rgba(16, 185, 129, 0.15)';
                badge.style.borderColor = 'rgba(16, 185, 129, 0.3)';
            } else {
                badge.innerText = '⚡ Memory Cache Active';
                badge.style.color = '#38bdf8';
                badge.style.background = 'rgba(56, 189, 248, 0.15)';
                badge.style.borderColor = 'rgba(56, 189, 248, 0.3)';
            }
        }
    } catch { }
}

function probeQuick(domain) {
    document.getElementById('detectorInput').value = domain;
    analyzeDomainSuggestion();
}

function addToStrictDomains(domain) {
    const inp = document.getElementById('inpStrictDomains');
    if (!inp) return;
    const clean = domain.replace(/^https?:\/\//i, '').replace(/^www\./i, '').split('/')[0].trim().toLowerCase();
    const existing = inp.value.split(',').map(s => s.trim().toLowerCase());
    if (!existing.includes(clean)) {
        inp.value = inp.value ? inp.value.trim().replace(/,+$/, '') + ',' + clean : clean;
        alert(`✅ Domain '${clean}' added to Rate-Limited CDN Domain Filters! Remember to click 'Save Platform Configuration'.`);
    } else {
        alert(`ℹ️ Domain '${clean}' is already in Rate-Limited CDN Domain Filters.`);
    }
}

async function analyzeDomainSuggestion() {
    const raw = (document.getElementById('detectorInput').value || '').trim();
    const resDiv = document.getElementById('detectorResult');
    const btnText = document.getElementById('btnProbeText');
    const btn = document.getElementById('btnProbeAnalyze');

    if (!raw) {
        resDiv.style.display = 'block';
        resDiv.innerHTML = '<div style="color: #f87171; padding: 10px; background: rgba(239,68,68,0.1); border-radius: 8px; border: 1px solid rgba(239,68,68,0.2);">⚠️ Please enter a domain or URL to analyze (e.g. <code>youtube.com</code> or <code>https://instagram.com/reel/...</code>)</div>';
        return;
    }

    resDiv.style.display = 'block';
    resDiv.innerHTML = `
        <div style="padding: 16px; background: rgba(0, 0, 0, 0.4); border-radius: 10px; border: 1px solid rgba(56, 189, 248, 0.2); display: flex; align-items: center; gap: 12px;">
            <div class="spinner" style="width: 20px; height: 20px; border-width: 2px;"></div>
            <div style="font-size: 13px; color: #38bdf8; font-weight: 600;">
                Probing CDN Edge Servers, Protocol Headers &amp; Concurrency Profile...
            </div>
        </div>
    `;

    btnText.innerText = "⏳ Probing...";
    btn.disabled = true;

    try {
        const resp = await fetch(`/api/admin/probe-cdn?target=${encodeURIComponent(raw)}`);
        const data = await resp.json();

        if (!resp.ok || !data.success) {
            throw new Error(data.error || 'Failed to probe target URL');
        }

        const isStrictRisk = data.safeCap < 32 || data.riskFactor.toLowerCase().includes('high');
        const badgeColor = isStrictRisk ? '#fbbf24' : '#34d399';
        const badgeBorder = isStrictRisk ? 'rgba(245, 158, 11, 0.3)' : 'rgba(16, 185, 129, 0.3)';
        const badgeBg = isStrictRisk ? 'rgba(245, 158, 11, 0.1)' : 'rgba(16, 185, 129, 0.1)';

        let headersHtml = '';
        if (data.detectedHeaders && Object.keys(data.detectedHeaders).length > 0) {
            headersHtml = Object.entries(data.detectedHeaders).map(([k, v]) => 
                `<span style="background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; font-size: 10.5px; font-family: monospace; color: #94a3b8;">${k}: <strong style="color: #cbd5e1;">${v}</strong></span>`
            ).join(' ');
        }

        const cacheBadge = data.isCached ? 
            `<span style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); padding: 2px 8px; border-radius: 4px; font-size: 10.5px; font-weight: 700;">⚡ Instant Cache (${data.cacheSource})</span>` :
            `<span style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); padding: 2px 8px; border-radius: 4px; font-size: 10.5px; font-weight: 600;">📡 Live Edge Probe</span>`;

        resDiv.innerHTML = `
            <div style="background: rgba(7, 10, 19, 0.9); border: 1px solid ${badgeBorder}; border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                <!-- Header Status Row -->
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 10px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #64748b; letter-spacing: 0.05em;">Target Host</span>
                            ${cacheBadge}
                        </div>
                        <div style="font-size: 15px; font-weight: 800; color: #f8fafc; font-family: monospace; margin-top: 2px;">${data.host}</div>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <span style="background: ${badgeBg}; color: ${badgeColor}; border: 1px solid ${badgeBorder}; padding: 4px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 700;">
                            ${isStrictRisk ? '🛡️ Strict Rate-Limited CDN' : '🚀 Open High-Throughput CDN'}
                        </span>
                        <span style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-family: monospace;">
                            ⚡ ${data.responseTimeMs} ms Ping
                        </span>
                    </div>
                </div>

                <!-- Live Speed & Network Telemetry Banner -->
                <div style="background: linear-gradient(90deg, rgba(56, 189, 248, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 8px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 18px;">🚀</span>
                        <div>
                            <div style="font-size: 10.5px; text-transform: uppercase; font-weight: 700; color: #94a3b8;">Active Wire Throughput</div>
                            <div style="font-size: 14px; font-weight: 800; color: #34d399; font-family: monospace;">⚡ ${data.liveWireSpeedMBps} MB/s <span style="font-size: 11px; font-weight: normal; color: #94a3b8;">(64KB micro-slice sampled)</span></div>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 10.5px; text-transform: uppercase; font-weight: 700; color: #94a3b8;">Autonomous System (ASN)</div>
                        <div style="font-size: 12px; font-weight: 700; color: #38bdf8; font-family: monospace;">${data.asnOrganization}</div>
                    </div>
                </div>

                <!-- Telemetry Matrix Grid -->
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; font-size: 12px;">
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Edge Infrastructure</span>
                        <div style="color: #f1f5f9; font-weight: 700; margin-top: 2px;">${data.cdnProvider}</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Streaming Architecture</span>
                        <div style="color: #f1f5f9; font-weight: 700; margin-top: 2px;">${data.streamProtocol}</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Resolved Edge IP</span>
                        <div style="color: #38bdf8; font-weight: 700; margin-top: 2px; font-family: monospace;">${data.resolvedIp}</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Byte-Range Slicing</span>
                        <div style="color: ${data.byteRangeSupported ? '#34d399' : '#f87171'}; font-weight: 700; margin-top: 2px;">
                            ${data.byteRangeSupported ? '✅ HTTP 206 Partial Content Supported' : '⚠️ Non-Standard Chunking'}
                        </div>
                    </div>
                </div>

                <!-- Live Headers -->
                ${headersHtml ? `
                <div style="background: rgba(0,0,0,0.3); padding: 8px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
                    <span style="font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase;">Live Edge Headers:</span>
                    ${headersHtml}
                </div>` : ''}

                <!-- AI Advice Box & Apply Button -->
                <div style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                    <div style="font-size: 12.5px; color: #e2e8f0;">
                        💡 <b>AI Advisor Dynamic Formula:</b> Calculated <b>${data.recommendedThreads} Parallel Threads</b> based on measured <b>${data.liveWireSpeedMBps} MB/s</b> wire throughput. Safe strict limit: <b>${data.safeCap} workers</b> (Max turbo: <b>${data.maxTurbo} workers</b>).
                    </div>
                    <div style="font-size: 11px; color: #94a3b8;">
                        Risk Evaluation: <strong style="color: ${isStrictRisk ? '#fbbf24' : '#34d399'};">${data.riskFactor}</strong> | Anti-Hotlink: <strong style="color: #38bdf8;">${data.antiHotlinkStrategy}</strong>
                    </div>
                    <div style="margin-top: 4px; display: flex; gap: 8px; flex-wrap: wrap;">
                        <button type="button" class="btn btn-primary" style="padding: 8px 14px; font-size: 12px; font-weight: 700; flex: 1;" onclick="applyProfile(${data.safeCap}, ${data.maxTurbo}, ${data.recommendedThreads})">
                            ⚡ Auto-Apply Profile (${data.safeCap} Strict / ${data.maxTurbo} Open / ${data.recommendedThreads} Default)
