@model StreamHelper.ViewModels.AdminSettingsViewModel
@{
    ViewData["Title"] = "Platform Settings — Stream Helper Admin";
}

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <h1 class="page-title">Platform Configuration</h1>
                <p class="page-subtitle">Configure operational parameters, security rules, and download engine defaults</p>
            </div>
            <div class="admin-nav-links">
                <a asp-action="Index" class="btn btn-secondary">Dashboard</a>
                <a asp-action="Users" class="btn btn-secondary">Users</a>
                <a asp-action="Downloads" class="btn btn-secondary">Downloads</a>
                <a asp-action="Diagnostics" class="btn btn-secondary">Diagnostics & Logs</a>
                <a asp-action="Settings" class="btn btn-primary">Settings</a>
                <a asp-action="Security" class="btn btn-secondary">Security</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success" style="margin-bottom: 24px;">
                <span class="alert-icon">✅</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <form asp-action="Settings" method="post" id="settingsForm">
            @Html.AntiForgeryToken()

            <!-- NAVIGATION TABS -->
            <div style="display: flex; gap: 12px; margin-bottom: 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 14px; flex-wrap: wrap;">
                <button type="button" id="tabBtnEngine" onclick="switchSettingsTab('engine')" 
                    style="display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; background: rgba(56, 189, 248, 0.15); border: 1px solid #38bdf8; color: #38bdf8; box-shadow: 0 4px 15px rgba(56, 189, 248, 0.2);">
                    <span>⚡ Engine &amp; Performance</span>
                    <span style="font-size: 11px; background: rgba(56, 189, 248, 0.25); padding: 2px 8px; border-radius: 10px;">Threads &amp; AI</span>
                </button>
                <button type="button" id="tabBtnAccess" onclick="switchSettingsTab('access')" 
                    style="display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8;">
                    <span>🛡️ Access &amp; Authentication</span>
                    <span style="font-size: 11px; background: rgba(255, 255, 255, 0.08); padding: 2px 8px; border-radius: 10px;">Auth &amp; Users</span>
                </button>
                <button type="button" id="tabBtnDatabase" onclick="switchSettingsTab('database')" 
                    style="display: flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); color: #94a3b8;">
                    <span>🌐 Database &amp; Cloud Sync</span>
                    <span style="font-size: 11px; background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 2px 8px; border-radius: 10px;">MongoDB ⇋ SQL</span>
                </button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 24px;">

                <!-- TAB PANE 1: ENGINE & PERFORMANCE -->
                <div id="tabContentEngine" style="display: flex; flex-direction: column; gap: 24px;">
                    <!-- SECTION 1: DOWNLOAD ENGINE & MULTI-THREAD CONCURRENCY -->
                    <div class="glass-card" style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 14px;">
                            <div>
                                <h2 style="font-size: 18px; font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 8px;">
                                    <span>⚡ Multi-Thread Concurrency &amp; Hyper-Engine Defaults</span>
                                </h2>
                                <p style="font-size: 12.5px; color: var(--text-muted); margin-top: 2px;">Calibrate segment thread pools, safe CDN connection caps, and media quality rules</p>
                            </div>

                        <!-- Concurrency Presets -->
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <span style="font-size: 11.5px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Quick Profiles:</span>
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 8px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8;" onclick="applyProfile(24, 128, 64)">
                                🛡️ Balanced (Safe 24 / 128)
                            </button>
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 8px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399;" onclick="applyProfile(32, 256, 128)">
                                ⚡ Hyper (Optimal 32 / 256)
                            </button>
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px; font-weight: 600; border-radius: 8px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24;" onclick="applyProfile(16, 64, 32)">
                                🐢 Conservative (Stealth 16 / 64)
                            </button>
                        </div>
                    </div>

                    <!-- Concurrency Grid: 3-column on desktop -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                        <div class="form-group" style="margin: 0;">
                            <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                <span>Default Parallel Threads</span>
                                <span style="font-size: 11px; color: #38bdf8; font-weight: 600;">Standard Streams</span>
                            </label>
                            <input type="number" id="inpDefaultThreads" name="settings[DefaultThreads]" value="@Model.Settings.GetValueOrDefault("DefaultThreads", "64")" class="form-control" min="1" max="256" style="background: #090e1a; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 14px; font-weight: 700; color: #f8fafc; padding: 10px 14px;" />
                            <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">Default thread concurrency allocated to new downloads.</span>
                        </div>

                        <div class="form-group" style="margin: 0;">
                            <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                <span>🛡️ Strict Rate-Limited Cap</span>
                                <span style="font-size: 11px; color: #fbbf24; font-weight: 600;">CDN Ban Prevention</span>
                            </label>
                            <input type="number" id="inpStrictThreads" name="settings[StrictCdnMaxThreads]" value="@Model.Settings.GetValueOrDefault("StrictCdnMaxThreads", "32")" class="form-control" min="4" max="64" style="background: #090e1a; border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; font-size: 14px; font-weight: 700; color: #fbbf24; padding: 10px 14px;" />
                            <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">Recommended: 24 - 32. Protects against 429 errors and temporary IP cooldowns.</span>
                        </div>

                        <div class="form-group" style="margin: 0;">
                            <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                                <span>🚀 Open Sites Turbo Cap</span>
                                <span style="font-size: 11px; color: #34d399; font-weight: 600;">YouTube / Direct Range</span>
                            </label>
                            <input type="number" id="inpOpenThreads" name="settings[OpenCdnMaxThreads]" value="@Model.Settings.GetValueOrDefault("OpenCdnMaxThreads", "256")" class="form-control" min="16" max="512" style="background: #090e1a; border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; font-size: 14px; font-weight: 700; color: #34d399; padding: 10px 14px;" />
                            <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">Maximum high-bandwidth multi-slicing limit for fast open CDNs.</span>
                        </div>
                    </div>

                    <!-- Quality & Domain Filters: 2-column -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
                        <div class="form-group" style="margin: 0;">
                            <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px; display: block;">
                                🎬 Default Download Quality
                            </label>
                            <select name="settings[DefaultDownloadQuality]" class="form-control" style="background: #090e1a; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 13.5px; color: #f8fafc; padding: 10px 14px;">
                                <option value="Highest" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "Highest")">🏆 Highest Available (Auto 4K / 1080p Full HD)</option>
                                <option value="1080p" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "1080p")">💎 1080p Full HD</option>
                                <option value="720p" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "720p")">⚡ 720p HD</option>
                                <option value="480p" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "480p")">📱 480p SD (Data Saver)</option>
                            </select>
                            <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">When analyzing any stream, this resolution tier is pre-selected by default.</span>
                        </div>

                        <div class="form-group" style="margin: 0;">
                            <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px; display: flex; justify-content: space-between;">
                                <span>🌐 Rate-Limited CDN Domain Filters</span>
                                <span style="font-size: 11px; color: #94a3b8;">Auto-Cap Trigger</span>
                            </label>
                            <input type="text" id="inpStrictDomains" name="settings[StrictCdnDomains]" value="@Model.Settings.GetValueOrDefault("StrictCdnDomains", "phncdn,pornhub,xhpingcdn,xhcdn,xhamster,okxxx,ok.xxx,phcdn,spankbang,sb-cd,mat6tube,pvvstream,xnxx,xnxx-cdn,xvideos,xvideos-cdn,pixelflix,pron.click,freefuckvidz,freepornvideo")" class="form-control" style="background: #090e1a; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 12.5px; font-family: monospace; color: #38bdf8; padding: 10px 14px;" />
                            <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">Matching URLs will automatically use the Strict Thread Cap (comma-separated keywords).</span>
                        </div>
                    </div>
                </div>


                <!-- SECTION 2: AI CDN PROBER & CONCURRENCY ADVISOR -->
                <div class="glass-card" style="background: rgba(10, 15, 30, 0.95); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 16px; padding: 24px; box-shadow: 0 8px 32px rgba(56, 189, 248, 0.1);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <div style="font-weight: 800; font-size: 17px; color: #38bdf8; display: flex; align-items: center; gap: 8px;">
                                <span>🤖 Auto-Detector &amp; AI Concurrency Advisor</span>
                                <span style="font-size: 11px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 2px 8px; border-radius: 12px; font-weight: 700;">Real-Time Edge Telemetry</span>
                            </div>
                            <p style="font-size: 12.5px; color: #94a3b8; margin-top: 4px;">
                                Probe any website URL or video stream in real time: AI will analyze CDN topology, HTTP/2 socket limits, and calculate optimal concurrency.
                            </p>
                        </div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <button type="button" class="btn btn-primary" id="btnScanAll" onclick="scanAllSitesHealth()" title="Scan & Health Check all 16+ supported sites simultaneously" style="font-size: 12px; font-weight: 700; padding: 7px 14px; border-radius: 8px; background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%); border: 1px solid #38bdf8;">
                                <span id="btnScanAllText">🌐 1-Click Scan All Sites</span>
                            </button>
                            <button type="button" class="btn btn-secondary" id="btnAutoFixAll" onclick="autoFixAllSites()" title="Automatically apply optimal concurrency, filters & engine limits for all sites" style="font-size: 12px; font-weight: 700; padding: 7px 14px; border-radius: 8px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399;">
                                <span>⚡ AI Auto-Fix All (Optimal)</span>
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="flushRedisCache()" title="Clear Redis &amp; In-Memory probe caches" style="font-size: 12px; font-weight: 600; padding: 7px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.15); color: #cbd5e1;">
                                <span>🗑️ Flush Cache</span>
                            </button>
                        </div>
                    </div>

                    <!-- Search Input Bar -->
                    <div style="display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 280px; position: relative;">
                            <input type="text" id="detectorInput" placeholder="Enter any domain or URL (e.g. xnxx.com, xvideos.com, pixelflix.cc, okxxx1.com, youtube.com, instagram.com)" class="form-control" style="font-size: 13.5px; background: #060913; border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 10px; padding: 12px 16px; color: #f8fafc; width: 100%;" onkeydown="if(event.key==='Enter'){event.preventDefault();analyzeDomainSuggestion();}" />
                        </div>
                        <button type="button" id="btnProbeAnalyze" class="btn btn-primary" onclick="analyzeDomainSuggestion()" style="white-space: nowrap; font-size: 13px; font-weight: 700; padding: 0 24px; border-radius: 10px; background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%); border: 1px solid #38bdf8; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3); min-height: 44px;">
                            <span id="btnProbeText">🔍 Analyze &amp; Probe</span>
                        </button>
                    </div>

                    <!-- Batch Scan All Sites Result Container -->
                    <div id="batchScanResult" style="display: none; margin-bottom: 14px;"></div>

                    <!-- Categorized Quick Probe Pills -->
                    <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 10px; padding: 12px 16px; display: flex; flex-direction: column; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <span style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; width: 100px;">🎬 Tube Sites:</span>
                            <span onclick="probeQuick('xnxx.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">XNXX</span>
                            <span onclick="probeQuick('xvideos.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">XVideos</span>
                            <span onclick="probeQuick('pornhub.org')" style="cursor: pointer; font-size: 11.5px; background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">PornHub</span>
                            <span onclick="probeQuick('okxxx1.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">OKXXX</span>
                            <span onclick="probeQuick('xhamster.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">xHamster</span>
                            <span onclick="probeQuick('spankbang.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">SpankBang</span>
                            <span onclick="probeQuick('mat6tube.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">Mat6tube</span>
                            <span onclick="probeQuick('pron.click')" style="cursor: pointer; font-size: 11.5px; background: rgba(249, 115, 22, 0.12); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">Pron.click</span>
                            <span onclick="probeQuick('freepornvideo.sex')" style="cursor: pointer; font-size: 11.5px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">FreePornVideo</span>
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <span style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; width: 100px;">🍿 OTT &amp; Social:</span>
                            <span onclick="probeQuick('pixelflix.cc')" style="cursor: pointer; font-size: 11.5px; background: rgba(139, 92, 246, 0.15); color: #a78bfa; border: 1px solid rgba(139, 92, 246, 0.3); padding: 3px 10px; border-radius: 20px; font-weight: 600;">PixelFlix (Movies &amp; Series)</span>
                            <span onclick="probeQuick('youtube.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(239, 68, 68, 0.12); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">YouTube</span>
                            <span onclick="probeQuick('instagram.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(236, 72, 153, 0.12); color: #f472b6; border: 1px solid rgba(236, 72, 153, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">Instagram</span>
                            <span onclick="probeQuick('reddit.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(249, 115, 22, 0.12); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">Reddit</span>
                            <span onclick="probeQuick('twitch.tv')" style="cursor: pointer; font-size: 11.5px; background: rgba(168, 85, 247, 0.12); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">Twitch</span>
                            <span onclick="probeQuick('vimeo.com')" style="cursor: pointer; font-size: 11.5px; background: rgba(56, 189, 248, 0.12); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.25); padding: 3px 10px; border-radius: 20px; font-weight: 600;">Vimeo</span>
                        </div>
                    </div>

                    <!-- Real-Time Probe Result Box -->
                    <div id="detectorResult" style="display: none; margin-top: 16px;"></div>
                </div>
                </div> <!-- END TAB PANE 1: ENGINE & PERFORMANCE -->


                <!-- TAB PANE 2: ACCESS & AUTHENTICATION -->
                <div id="tabContentAccess" style="display: none; flex-direction: column; gap: 24px;">
                    <!-- SECTION 3: ACCESS CONTROL, SECURITY & MAINTENANCE -->
                    <div class="glass-card" style="background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);">
                        <div style="margin-bottom: 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 14px;">
                            <h2 style="font-size: 18px; font-weight: 700; color: #f8fafc; display: flex; align-items: center; gap: 8px;">
                                <span>🛡️ Access Control, Security &amp; Maintenance</span>
                            </h2>
                            <p style="font-size: 12.5px; color: var(--text-muted); margin-top: 2px;">Manage user onboarding, third-party authentication, and system availability</p>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
                            <div class="form-group" style="margin: 0;">
                                <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px; display: block;">User Registration</label>
                                <select name="settings[RegistrationEnabled]" class="form-control" style="background: #090e1a; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 13.5px; color: #f8fafc; padding: 10px 14px;">
                                    <option value="true" selected="@(Model.Settings.GetValueOrDefault("RegistrationEnabled", "true") == "true")">Enabled (Open to public)</option>
                                    <option value="false" selected="@(Model.Settings.GetValueOrDefault("RegistrationEnabled", "true") == "false")">Disabled (Invite/Admin only)</option>
                                </select>
                                <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">When disabled, visitors cannot sign up.</span>
                            </div>

                            <div class="form-group" style="margin: 0;">
                                <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px; display: block;">Email Verification</label>
                                <select name="settings[EmailVerificationRequired]" class="form-control" style="background: #090e1a; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 13.5px; color: #f8fafc; padding: 10px 14px;">
                                    <option value="false" selected="@(Model.Settings.GetValueOrDefault("EmailVerificationRequired", "false") == "false")">Optional (Instant Sign In)</option>
                                    <option value="true" selected="@(Model.Settings.GetValueOrDefault("EmailVerificationRequired", "false") == "true")">Strict (Must verify email)</option>
                                </select>
                                <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">Require verified email token before login.</span>
                            </div>

                            <div class="form-group" style="margin: 0;">
                                <label style="font-size: 13px; font-weight: 700; color: #cbd5e1; margin-bottom: 6px; display: block;">Google OAuth Login</label>
                                <select name="settings[GoogleLoginEnabled]" class="form-control" style="background: #090e1a; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; font-size: 13.5px; color: #f8fafc; padding: 10px 14px;">
                                    <option value="true" selected="@(Model.Settings.GetValueOrDefault("GoogleLoginEnabled", "true") == "true")">Enabled (1-Click Login)</option>
                                    <option value="false" selected="@(Model.Settings.GetValueOrDefault("GoogleLoginEnabled", "true") == "false")">Disabled</option>
                                </select>
                                <span style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">Allow seamless Google identity sign-in.</span>
                            </div>

