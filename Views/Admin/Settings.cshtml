@model StreamHelper.ViewModels.AdminSettingsViewModel
@{
    ViewData["Title"] = "Platform Settings — Stream Helper Admin";
}

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <h1 class="page-title">Platform Configuration</h1>
                <p class="page-subtitle">Configure operational parameters, security rules, and download engine defaults</p>
            </div>
            <div class="admin-nav-links">
                <a asp-action="Index" class="btn btn-secondary">Dashboard</a>
                <a asp-action="Users" class="btn btn-secondary">Users</a>
                <a asp-action="Downloads" class="btn btn-secondary">Downloads</a>
                <a asp-action="Diagnostics" class="btn btn-secondary">Diagnostics & Logs</a>
                <a asp-action="Settings" class="btn btn-primary">Settings</a>
                <a asp-action="Security" class="btn btn-secondary">Security</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success" style="margin-bottom: 24px;">
                <span class="alert-icon">✅</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <form asp-action="Settings" method="post">
            @Html.AntiForgeryToken()
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <!-- User Access & Authentication -->
                <div class="glass-card">
                    <h2 class="card-title" style="margin-bottom: 20px;">🛡️ Access &amp; Authentication</h2>

                    <div class="form-group">
                        <label>User Registration</label>
                        <select name="settings[RegistrationEnabled]" class="form-control">
                            <option value="true" selected="@(Model.Settings.GetValueOrDefault("RegistrationEnabled", "true") == "true")">Enabled (Open to public)</option>
                            <option value="false" selected="@(Model.Settings.GetValueOrDefault("RegistrationEnabled", "true") == "false")">Disabled (Invite/Admin only)</option>
                        </select>
                        <span style="font-size: 12px; color: var(--text-muted);">When disabled, visitors cannot create new accounts.</span>
                    </div>

                    <div class="form-group">
                        <label>Email Verification Requirement</label>
                        <select name="settings[EmailVerificationRequired]" class="form-control">
                            <option value="false" selected="@(Model.Settings.GetValueOrDefault("EmailVerificationRequired", "false") == "false")">Optional (Instant Sign In)</option>
                            <option value="true" selected="@(Model.Settings.GetValueOrDefault("EmailVerificationRequired", "false") == "true")">Strict (Must verify email before login)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Google OAuth Login</label>
                        <select name="settings[GoogleLoginEnabled]" class="form-control">
                            <option value="true" selected="@(Model.Settings.GetValueOrDefault("GoogleLoginEnabled", "true") == "true")">Enabled</option>
                            <option value="false" selected="@(Model.Settings.GetValueOrDefault("GoogleLoginEnabled", "true") == "false")">Disabled</option>
                        </select>
                    </div>
                </div>

                <!-- Download Engine Configuration -->
                <div class="glass-card">
                    <h2 class="card-title" style="margin-bottom: 20px;">⚡ Engine &amp; Performance</h2>

                    <!-- Preset Quick Profile Buttons -->
                    <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; margin-bottom: 20px;">
                        <div style="font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--text-primary);">🎯 Quick Concurrency Profiles:</div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;" onclick="applyProfile(24, 128, 64)">🛡️ Balanced (Safe 24 / 128)</button>
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;" onclick="applyProfile(32, 256, 128)">⚡ Hyper (Optimal 32 / 256)</button>
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;" onclick="applyProfile(16, 64, 32)">🐢 Conservative (Stealth 16 / 64)</button>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Default Parallel Threads</label>
                        <input type="number" id="inpDefaultThreads" name="settings[DefaultThreads]" value="@Model.Settings.GetValueOrDefault("DefaultThreads", "64")" class="form-control" min="1" max="256" />
                        <span style="font-size: 12px; color: var(--text-muted);">Default thread concurrency allocated to new downloads.</span>
                    </div>

                    <div class="form-group">
                        <label>🛡️ Strict / Rate-Limited Sites Max Threads (PornHub, xHamster, SpankBang, OKXXX, etc.)</label>
                        <input type="number" id="inpStrictThreads" name="settings[StrictCdnMaxThreads]" value="@Model.Settings.GetValueOrDefault("StrictCdnMaxThreads", "32")" class="form-control" min="4" max="64" />
                        <span style="font-size: 12px; color: var(--text-muted);">Safe connection cap (Recommended: 24 - 32) to prevent CDN IP bans or 429 throttling.</span>
                    </div>

                    <div class="form-group">
                        <label>🚀 Open / High-Capacity Sites Max Threads (YouTube, PixelFlix, Direct Range MP4s)</label>
                        <input type="number" id="inpOpenThreads" name="settings[OpenCdnMaxThreads]" value="@Model.Settings.GetValueOrDefault("OpenCdnMaxThreads", "256")" class="form-control" min="16" max="512" />
                        <span style="font-size: 12px; color: var(--text-muted);">Full Hyper-Engine multi-threading limit for fast open networks.</span>
                    </div>

                    <div class="form-group">
                        <label>🎬 Default Download Quality for All Sites</label>
                        <select name="settings[DefaultDownloadQuality]" class="form-control">
                            <option value="Highest" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "Highest")">🏆 Highest Available (Auto 4K / 1080p Full HD)</option>
                            <option value="1080p" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "1080p")">💎 1080p Full HD</option>
                            <option value="720p" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "720p")">⚡ 720p HD</option>
                            <option value="480p" selected="@(Model.Settings.GetValueOrDefault("DefaultDownloadQuality", "Highest") == "480p")">📱 480p SD (Data Saver)</option>
                        </select>
                        <span style="font-size: 12px; color: var(--text-muted);">When analyzing any video from any site, this quality tier is auto-selected by default.</span>
                    </div>

                    <div class="form-group">
                        <label>🌐 Rate-Limited CDN Domain Filters (Comma-separated)</label>
                        <input type="text" id="inpStrictDomains" name="settings[StrictCdnDomains]" value="@Model.Settings.GetValueOrDefault("StrictCdnDomains", "phncdn,pornhub,xhpingcdn,xhcdn,xhamster,okxxx,ok.xxx,phcdn,spankbang,sb-cd,mat6tube,pvvstream")" class="form-control" />
                        <span style="font-size: 12px; color: var(--text-muted);">Domains and URL keywords that automatically trigger the strict rate-limit protection cap.</span>
                    </div>

                    <!-- AI / Auto Detector Assistant -->
                    <div style="background: rgba(15, 23, 42, 0.95); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 12px; padding: 18px; margin-top: 18px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                            <div style="font-weight: 700; font-size: 14px; color: #38bdf8; display: flex; align-items: center; gap: 6px;">
                                <span>🤖 Auto-Detector &amp; AI Concurrency Advisor</span>
                            </div>
                            <div style="display: flex; gap: 6px; align-items: center;">
                                <span id="redisCacheBadge" style="font-size: 11px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 2px 8px; border-radius: 20px; font-weight: 600;">⚡ Redis v7.0 Ready</span>
                                <span style="font-size: 11px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 2px 8px; border-radius: 20px; font-weight: 600;">Live Telemetry v2.5</span>
                            </div>
                        </div>
                        <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px;">Type any website URL, video stream, or domain to run real-time HTTP edge probing (accelerated with Redis distributed caching) and get instant thread recommendations:</p>
                        
                        <div style="display: flex; gap: 8px;">
                            <input type="text" id="detectorInput" placeholder="e.g. youtube.com, instagram.com, xhamster.com, vimeo.com, spankbang.com" class="form-control" style="font-size: 13px; background: #070a13; border: 1px solid rgba(255,255,255,0.15);" onkeydown="if(event.key==='Enter'){event.preventDefault();analyzeDomainSuggestion();}" />
                            <button type="button" id="btnProbeAnalyze" class="btn btn-primary" onclick="analyzeDomainSuggestion()" style="white-space: nowrap; font-size: 13px; font-weight: 700; padding: 0 16px;">
                                <span id="btnProbeText">🔍 Analyze</span>
                            </button>
                            <button type="button" class="btn btn-secondary" onclick="flushRedisCache()" title="Clear Redis and In-Memory probe caches" style="font-size: 12px; padding: 0 12px; color: #cbd5e1;">
                                <span>🗑️ Flush Cache</span>
                            </button>
                        </div>
                        
                        <div id="detectorResult" style="display: none; margin-top: 14px;"></div>
                    </div>

                    <div class="form-group" style="margin-top: 16px;">
                        <label>Maintenance Mode</label>
                        <select name="settings[MaintenanceMode]" class="form-control">
                            <option value="false" selected="@(Model.Settings.GetValueOrDefault("MaintenanceMode", "false") == "false")">Operational (Live)</option>
                            <option value="true" selected="@(Model.Settings.GetValueOrDefault("MaintenanceMode", "false") == "true")">Maintenance Mode Active</option>
                        </select>
                    </div>
                </div>
            </div>

            <div style="margin-top: 24px; text-align: right;">
                <button type="submit" class="btn btn-primary" style="padding: 14px 32px;">
                    <span>💾 Save Platform Configuration</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function applyProfile(strict, open, def) {
    document.getElementById('inpStrictThreads').value = strict;
    document.getElementById('inpOpenThreads').value = open;
    document.getElementById('inpDefaultThreads').value = def;
}

async function flushRedisCache() {
    try {
        const resp = await fetch('/api/admin/clear-cache', { method: 'POST' });
        const data = await resp.json();
        alert(data.message || 'Cache cleared successfully!');
    } catch (e) {
        alert('Failed to clear cache: ' + e.message);
    }
}

async function checkRedisStatus() {
    try {
        const resp = await fetch('/api/admin/cache-status');
        const data = await resp.json();
        const badge = document.getElementById('redisCacheBadge');
        if (badge) {
            if (data.isConnected) {
                badge.innerText = '⚡ Redis v7.0 Active';
                badge.style.color = '#34d399';
                badge.style.background = 'rgba(16, 185, 129, 0.15)';
                badge.style.borderColor = 'rgba(16, 185, 129, 0.3)';
            } else {
                badge.innerText = '⚡ Memory Cache Active';
                badge.style.color = '#38bdf8';
                badge.style.background = 'rgba(56, 189, 248, 0.15)';
                badge.style.borderColor = 'rgba(56, 189, 248, 0.3)';
            }
        }
    } catch { }
}

document.addEventListener('DOMContentLoaded', checkRedisStatus);

async function analyzeDomainSuggestion() {
    const raw = (document.getElementById('detectorInput').value || '').trim();
    const resDiv = document.getElementById('detectorResult');
    const btnText = document.getElementById('btnProbeText');
    const btn = document.getElementById('btnProbeAnalyze');

    if (!raw) {
        resDiv.style.display = 'block';
        resDiv.innerHTML = '<div style="color: #f87171; padding: 10px; background: rgba(239,68,68,0.1); border-radius: 8px; border: 1px solid rgba(239,68,68,0.2);">⚠️ Please enter a domain or URL to analyze (e.g. <code>youtube.com</code> or <code>https://instagram.com/reel/...</code>)</div>';
        return;
    }

    resDiv.style.display = 'block';
    resDiv.innerHTML = `
        <div style="padding: 16px; background: rgba(0, 0, 0, 0.4); border-radius: 10px; border: 1px solid rgba(56, 189, 248, 0.2); display: flex; align-items: center; gap: 12px;">
            <div class="spinner" style="width: 20px; height: 20px; border-width: 2px;"></div>
            <div style="font-size: 13px; color: #38bdf8; font-weight: 600;">
                Probing CDN Edge Servers, Protocol Headers &amp; Concurrency Profile...
            </div>
        </div>
    `;

    btnText.innerText = "⏳ Probing...";
    btn.disabled = true;

    try {
        const resp = await fetch(`/api/admin/probe-cdn?target=${encodeURIComponent(raw)}`);
        const data = await resp.json();

        if (!resp.ok || !data.success) {
            throw new Error(data.error || 'Failed to probe target URL');
        }

        const isStrictRisk = data.safeCap < 32 || data.riskFactor.toLowerCase().includes('high');
        const badgeColor = isStrictRisk ? '#fbbf24' : '#34d399';
        const badgeBorder = isStrictRisk ? 'rgba(245, 158, 11, 0.3)' : 'rgba(16, 185, 129, 0.3)';
        const badgeBg = isStrictRisk ? 'rgba(245, 158, 11, 0.1)' : 'rgba(16, 185, 129, 0.1)';

        let headersHtml = '';
        if (data.detectedHeaders && Object.keys(data.detectedHeaders).length > 0) {
            headersHtml = Object.entries(data.detectedHeaders).map(([k, v]) => 
                `<span style="background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; font-size: 10.5px; font-family: monospace; color: #94a3b8;">${k}: <strong style="color: #cbd5e1;">${v}</strong></span>`
            ).join(' ');
        }

        const cacheBadge = data.isCached ? 
            `<span style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); padding: 2px 8px; border-radius: 4px; font-size: 10.5px; font-weight: 700;">⚡ Instant Cache (${data.cacheSource})</span>` :
            `<span style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); padding: 2px 8px; border-radius: 4px; font-size: 10.5px; font-weight: 600;">📡 Live Edge Probe</span>`;

        resDiv.innerHTML = `
            <div style="background: rgba(7, 10, 19, 0.9); border: 1px solid ${badgeBorder}; border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                <!-- Header Status Row -->
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 10px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #64748b; letter-spacing: 0.05em;">Target Host</span>
                            ${cacheBadge}
                        </div>
                        <div style="font-size: 15px; font-weight: 800; color: #f8fafc; font-family: monospace; margin-top: 2px;">${data.host}</div>
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <span style="background: ${badgeBg}; color: ${badgeColor}; border: 1px solid ${badgeBorder}; padding: 4px 10px; border-radius: 6px; font-size: 11.5px; font-weight: 700;">
                            ${isStrictRisk ? '🛡️ Strict Rate-Limited CDN' : '🚀 Open High-Throughput CDN'}
                        </span>
                        <span style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-family: monospace;">
                            ⚡ ${data.responseTimeMs} ms Ping
                        </span>
                    </div>
                </div>

                <!-- Live Speed & Network Telemetry Banner -->
                <div style="background: linear-gradient(90deg, rgba(56, 189, 248, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 8px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 18px;">🚀</span>
                        <div>
                            <div style="font-size: 10.5px; text-transform: uppercase; font-weight: 700; color: #94a3b8;">Active Wire Throughput</div>
                            <div style="font-size: 14px; font-weight: 800; color: #34d399; font-family: monospace;">⚡ ${data.liveWireSpeedMBps} MB/s <span style="font-size: 11px; font-weight: normal; color: #94a3b8;">(64KB micro-slice sampled)</span></div>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 10.5px; text-transform: uppercase; font-weight: 700; color: #94a3b8;">Autonomous System (ASN)</div>
                        <div style="font-size: 12px; font-weight: 700; color: #38bdf8; font-family: monospace;">${data.asnOrganization}</div>
                    </div>
                </div>

                <!-- Telemetry Matrix Grid -->
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; font-size: 12px;">
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Edge Infrastructure</span>
                        <div style="color: #f1f5f9; font-weight: 700; margin-top: 2px;">${data.cdnProvider}</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Streaming Architecture</span>
                        <div style="color: #f1f5f9; font-weight: 700; margin-top: 2px;">${data.streamProtocol}</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Resolved Edge IP</span>
                        <div style="color: #38bdf8; font-weight: 700; margin-top: 2px; font-family: monospace;">${data.resolvedIp}</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.03); padding: 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                        <span style="color: #64748b; font-size: 10.5px; font-weight: 700; text-transform: uppercase;">Byte-Range Slicing</span>
                        <div style="color: ${data.byteRangeSupported ? '#34d399' : '#f87171'}; font-weight: 700; margin-top: 2px;">
                            ${data.byteRangeSupported ? '✅ HTTP 206 Partial Content Supported' : '⚠️ Non-Standard Chunking'}
                        </div>
                    </div>
                </div>

                <!-- Live Headers -->
                ${headersHtml ? `
                <div style="background: rgba(0,0,0,0.3); padding: 8px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
                    <span style="font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase;">Live Edge Headers:</span>
                    ${headersHtml}
                </div>` : ''}

                <!-- AI Advice Box & Apply Button -->
                <div style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                    <div style="font-size: 12.5px; color: #e2e8f0;">
                        💡 <b>AI Advisor Dynamic Formula:</b> Calculated <b>${data.recommendedThreads} Parallel Threads</b> based on measured <b>${data.liveWireSpeedMBps} MB/s</b> wire throughput. Safe strict limit: <b>${data.safeCap} workers</b> (Max turbo: <b>${data.maxTurbo} workers</b>).
                    </div>
                    <div style="font-size: 11px; color: #94a3b8;">
                        Risk Evaluation: <strong style="color: ${isStrictRisk ? '#fbbf24' : '#34d399'};">${data.riskFactor}</strong> | Anti-Hotlink: <strong style="color: #38bdf8;">${data.antiHotlinkStrategy}</strong>
                    </div>
                    <div style="margin-top: 4px; display: flex; gap: 8px;">
                        <button type="button" class="btn btn-primary" style="padding: 8px 14px; font-size: 12px; font-weight: 700; flex: 1;" onclick="applyProfile(${data.safeCap}, ${data.maxTurbo}, ${data.recommendedThreads})">
                            ⚡ Auto-Apply This AI Profile (${data.safeCap} Strict / ${data.maxTurbo} Open / ${data.recommendedThreads} Default)
                        </button>
                    </div>
                </div>
            </div>
        `;
    } catch (err) {
        resDiv.innerHTML = `
            <div style="padding: 14px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; color: #fca5a5; font-size: 12.5px;">
                ❌ <b>Probe Failed:</b> ${err.message || 'Could not connect to host.'}
            </div>
        `;
    } finally {
        btnText.innerText = "🔍 Analyze";
        btn.disabled = false;
    }
}
</script>

