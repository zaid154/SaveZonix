@model StreamHelper.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Command Center — Stream Helper";
}

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <div>
                <div class="hero-tag">
                    <span class="badge-tag badge-red">🛡️ Administrative Privileges</span>
                </div>
                <h1 class="page-title">Command Center</h1>
                <p class="page-subtitle">Real-time telemetry, user management, and system-wide download monitoring</p>
            </div>
            <div class="admin-nav-links">
                <a asp-action="Index" class="btn btn-primary">Dashboard</a>
                <a asp-action="Users" class="btn btn-secondary">Users</a>
                <a asp-action="Downloads" class="btn btn-secondary">Downloads</a>
                <a asp-action="Settings" class="btn btn-secondary">Settings</a>
            </div>
        </div>

        <!-- Metric Cards Grid -->
        <div class="stats-grid" style="margin-bottom: 32px;">
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">👥</div>
                <div class="stat-value">@Model.TotalUsers</div>
                <div class="stat-label">Total Registered Users</div>
                <div style="font-size: 12px; color: #10b981; margin-top: 4px;">+@Model.NewUsersToday new today</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">⚡</div>
                <div class="stat-value">@Model.TotalDownloads</div>
                <div class="stat-label">Total Downloads Logged</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">@Model.CompletedDownloads succeeded</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">💾</div>
                <div class="stat-value">@Model.FormattedTotalSize</div>
                <div class="stat-label">Bandwidth Transferred</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Avg speed: @Model.AverageDownloadSpeedMBps.ToString("F1") MB/s</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e;">⚠️</div>
                <div class="stat-value">@Model.FailedDownloads</div>
                <div class="stat-label">Failed Tasks</div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">@Model.ActiveUsers active accounts</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 32px;">
            <!-- Recent Downloads Table -->
            <div class="glass-card" style="padding: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h2 class="card-title" style="margin-bottom: 0;">Recent Global Downloads</h2>
                    <a asp-action="Downloads" class="auth-link" style="font-size: 13px;">View All &rarr;</a>
                </div>
                <div class="table-responsive">
                    <table class="data-table" style="font-size: 13px;">
                        <thead>
                            <tr>
                                <th>Media</th>
                                <th>User / Title</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.RecentDownloads)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.ThumbnailUrl))
                                        {
                                            <img src="@d.ThumbnailUrl" alt="Thumb" class="table-thumb-sm" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <span>🎬</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="table-title" style="max-width: 220px;" title="@d.Title">@d.Title</div>
                                        <div class="table-sub">@(d.UserEmail ?? "Anonymous Web") • @d.Platform</div>
                                    </td>
                                    <td>@d.FormattedFileSize</td>
                                    <td>
                                        <span class="status-badge status-@(d.Status.ToString().ToLower())" style="font-size: 11px; padding: 2px 6px;">@d.Status</span>
                                    </td>
                                    <td style="color: var(--text-muted);">@d.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Top Platforms Breakdown -->
            <div class="glass-card" style="padding: 20px;">
                <h2 class="card-title" style="margin-bottom: 16px;">Popular Platforms</h2>
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    @foreach (var p in Model.TopPlatforms)
                    {
                        double pct = Model.TotalDownloads > 0 ? (p.Value * 100.0 / Model.TotalDownloads) : 0;
                        <div>
                            <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                                <span style="font-weight: 600;">@p.Key</span>
                                <span style="color: var(--text-muted);">@p.Value (@pct.ToString("F0")%)</span>
                            </div>
                            <div class="progress-bar-bg" style="height: 6px;">
                                <div class="progress-bar-fill" style="width: @(pct)%;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
