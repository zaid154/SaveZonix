@{
    ViewData["Title"] = "Password Reset Successful — Stream Helper";
}

<div class="auth-wrapper">
    <div class="auth-card" style="text-align: center;">
        <div style="font-size: 48px; margin-bottom: 16px;">✅</div>
        <h1 class="auth-title">Password Reset Complete</h1>
        <p class="auth-subtitle">@ViewBag.SuccessMessage</p>
        <div style="margin-top: 28px;">
            <a asp-action="Login" class="btn btn-primary">Sign In Now</a>
        </div>
    </div>
</div>
