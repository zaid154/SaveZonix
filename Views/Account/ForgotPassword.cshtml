@model StreamHelper.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password — Stream Helper";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Enter your email address and we will send you a secure recovery link</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            <div class="form-group">
                <label asp-for="Email">Account Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <span>Send Reset Link</span>
            </button>
        </form>

        <div class="auth-footer">
            <p>Remembered your password? <a asp-action="Login" class="auth-link">Back to Sign In</a></p>
        </div>
    </div>
</div>
