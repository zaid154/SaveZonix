@model StreamHelper.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account — Stream Helper";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-link" style="justify-content: center; margin-bottom: 12px;">
                <img src="~/icons/icon48.png" alt="Logo" class="brand-logo-img">
                <div class="brand-text">Stream<span>Helper</span></div>
            </div>
            <h1 class="auth-title">Create Free Account</h1>
            <p class="auth-subtitle">Unlock unlimited 256-thread downloads and persistent cloud history</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert error" style="margin-bottom: 20px;">
                <span class="alert-icon">⚠️</span>
                <span>@ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage</span>
            </div>
        }

        <!-- Google OAuth Button -->
        <form asp-controller="Account" asp-action="ExternalLogin" method="post">
            <button type="submit" name="provider" value="Google" class="btn btn-google">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Sign up with Google</span>
            </button>
        </form>

        <div class="auth-divider">
            <span>or sign up with email</span>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-form">
            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Alex Johnson" required autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 characters" required autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-check" style="margin-bottom: 20px;">
                <input asp-for="AcceptTerms" type="checkbox" id="acceptTerms" class="form-check-input" required />
                <label for="acceptTerms" class="form-check-label">
                    I agree to the <a asp-controller="Legal" asp-action="Terms" target="_blank" class="auth-link">Terms of Service</a> &amp; <a asp-controller="Legal" asp-action="Privacy" target="_blank" class="auth-link">Privacy Policy</a>
                </label>
                <span asp-validation-for="AcceptTerms" class="text-danger" style="display:block;"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <span>Create My Account</span>
            </button>
        </form>

        <div class="auth-footer">
            <p>Already have an account? <a asp-action="Login" class="auth-link">Sign in</a></p>
        </div>
    </div>
</div>
