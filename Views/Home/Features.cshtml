@{
    ViewData["Title"] = "Features & Core Capabilities";
    ViewData["ActiveNav"] = "Features";
}

<!-- Features Hero -->
<section class="hero">
    <div class="container">
        <div class="hero-tag">
            <span class="badge-tag badge-purple">Core Architecture &amp; Capabilities</span>
        </div>
        <h1 class="hero-title">
            Engineered for <span class="gradient">Pure Performance</span>
        </h1>
        <p class="hero-desc">
            A breakdown of the engineering innovations that power Stream Helper's high-speed media stream parsing and multi-threaded downloads.
        </p>
    </div>
</section>

<!-- Main Features Grid -->
<section class="section" style="padding-top: 0;">
    <div class="container">
        <div class="feature-grid-2">
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                </div>
                <h3 class="feature-title">256x Parallel Multi-Threading Engine</h3>
                <p class="feature-text">Traditional downloaders fetch chunks sequentially over a single socket, creating artificial bandwidth bottlenecks. Stream Helper spawns up to 256 parallel worker connections with dynamic work-stealing task queues, fully utilizing high-bandwidth gigabit connections.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-wrapper feature-icon-green">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
                <h3 class="feature-title">Manifest V3 Stealth Sniffer</h3>
                <p class="feature-text">Our Chrome extension utilizes non-intrusive declarative network listeners to detect live HLS (M3U8), DASH (MPD), and direct MP4 playback without injecting heavy DOM trackers or slowing down active browser tabs.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-wrapper feature-icon-purple">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <h3 class="feature-title">In-Memory AES-128 Decryption</h3>
                <p class="feature-text">When encountering standard AES-128 encrypted HLS streams, Stream Helper extracts initialization vectors and cryptographic keys over secure channels and performs in-memory decryption using SubtleCrypto and .NET Cryptography primitives.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-wrapper feature-icon-amber">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <h3 class="feature-title">Smart CDN Anti-Hotlink Negotiation</h3>
                <p class="feature-text">Prevents HTTP 403 Forbidden and 412 Precondition Failed rejections by automatically replicating valid Origin and Referer credentials across content delivery networks (Cloudflare, Akamai, Fastly, CloudFront, phncdn, and pixelflix).</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="12" x2="2" y2="12"></line><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path><line x1="6" y1="16" x2="6.01" y2="16"></line><line x1="10" y1="16" x2="10.01" y2="16"></line></svg>
                </div>
                <h3 class="feature-title">Zero-RAM Leak Streaming Pipeline</h3>
                <p class="feature-text">Downloading 4K / 1080p high-bitrate media files can consume gigabytes of heap memory. Our streaming architecture writes binary slices directly to persistent disk, preventing browser memory exhaustion.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-wrapper feature-icon-green">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                </div>
                <h3 class="feature-title">Lossless Binary Segment Merging</h3>
                <p class="feature-text">Stitches hundreds of discrete transport chunks (.ts / .m4s / fMP4) into a single, compliant, timestamp-aligned MP4 file that plays natively across all media players (VLC, QuickTime, Windows Media Player, iOS, Android).</p>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="section" style="background: rgba(15, 23, 42, 0.4); border-top: 1px solid var(--border-color);">
    <div class="container" style="text-align: center;">
        <h2 class="section-title">Ready to Experience 256x Speed?</h2>
        <p class="section-desc" style="max-width: 540px; margin: 0 auto 28px;">Install the browser extension or use the web downloader interface directly.</p>
        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a asp-controller="Home" asp-action="Download" class="btn btn-accent btn-lg">Download Extension</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">Open Web Portal</a>
        </div>
    </div>
</section>
