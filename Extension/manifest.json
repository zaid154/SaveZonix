{
  "manifest_version": 3,
  "name": "Video Stream Downloader & Helper",
  "version": "2.2.0",
  "description": "Detects accessible video media and HLS/DASH streams for authorized local saving.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Stream Helper"
  }
}
