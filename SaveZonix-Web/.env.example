# ─────────────────────────────────────────────────────────────
# SaveZonix Web Central Cloud Configuration Example
# ─────────────────────────────────────────────────────────────

# Backend API Port & Database (Render)
PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/SaveZonixDb?retryWrites=true&w=majority
JWT_SECRET=your_secure_random_jwt_secret_here
ADMIN_KEY=your_admin_master_key_here

# Frontend React Client URL (Vercel)
CLIENT_URL=https://savezonix.vercel.app
VITE_API_URL=https://savezonix-api.onrender.com
